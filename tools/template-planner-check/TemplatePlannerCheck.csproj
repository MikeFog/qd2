<Project Sdk="Microsoft.NET.Sdk">
  <!-- Стенд планировщика Шаблонов 1–3 (docs/tasks/web-action-forms.md, этап 5). Не входит в qd2.sln:
       dotnet run; ключ db в командной строке (два дефиса перед ним) — ещё очередь роликов Шаблона 3 (нужны ролики из ArtvisDev) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FogSoft.Core\FogSoft.Core.csproj" />
  </ItemGroup>
</Project>
