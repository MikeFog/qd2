<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Для проверки очереди роликов (ключ db в командной строке): та же dev-база, что у веба (FogSoft.Web/App.config). -->
    <add name="Main" connectionString="user id=AdvertAgUser; password=AdvertAg; server=lpc:.\sqlexpress; database=ArtvisDev" />
  </connectionStrings>
  <appSettings>
    <!-- Ключ lockorder: порядок вызовов IssueIUD/RollerSubstitute читается из лога DbExecutionScope — пишутся все вызовы. -->
    <add key="StoredProcExecutionTimeThresholdMS" value="0" />
  </appSettings>
</configuration>
