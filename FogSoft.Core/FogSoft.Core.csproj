    <Compile Include="..\FogSoft.WinForm\Globals.Core.cs" Link="Globals.Core.cs" />
    <Compile Include="..\FogSoft.WinForm\Passport\Classes\PageControl.Constants.cs" Link="Passport\PageControl.Constants.cs" />
    <Compile Include="..\FogSoft.WinForm\Classes\EntityManager.cs" Link="Classes\EntityManager.cs" />
    <Compile Include="..\FogSoft.WinForm\Classes\FieldTypeResolver.cs" Link="Classes\FieldTypeResolver.cs" />
    <Compile Include="..\FogSoft.WinForm\Classes\Interfaces.cs" Link="Classes\Interfaces.cs" />
    <Compile Include="..\FogSoft.WinForm\Classes\InternalVariable.cs" Link="Classes\InternalVariable.cs" />
    <Compile Include="..\FogSoft.WinForm\Classes\PresentationObject.cs" Link="Classes\PresentationObject.cs" />
