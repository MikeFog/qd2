<?xml version="1.0" encoding="utf-8"?>
<!--
  Тот же файл и тот же формат строки, что у десктопа (см. Client/app.config
  и docs/LOGGING.md) — чтобы логи веба и десктопа читались одинаково.

  Отличие от десктопа только в способе подключения: на .NET Core секция
  log4net внутри app.config не читается, конфигурация загружается явно
  из этого файла (XmlConfigurator в Program.cs).

  %property{cid} в паттерне есть, но пока не заполняется — это задача этапа 1
  (идентификатор запроса), см. docs/ARCHITECTURE.md, "Открытые вопросы" №3.
-->
<log4net>
  <appender name="FileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="logs/qd2.log" />
    <immediateFlush value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="5MB" />
    <maxSizeRollBackups value="5" />

    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} %-5p [%thread] [%property{user}] [%property{cid}] - %m%n" />
    </layout>
  </appender>

  <root>
    <level value="Info" />
    <appender-ref ref="FileAppender" />
  </root>

  <logger name="DAL">
    <level value="Debug" />
  </logger>
</log4net>
