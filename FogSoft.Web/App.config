<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфигурация для ConfigurationUtil из FogSoft.Core.

  Этот файл при сборке превращается в FogSoft.Web.dll.config и читается
  штатным ConfigurationManager (пакет System.Configuration.ConfigurationManager).
  Именно поэтому в этапе 0 отпала необходимость в абстракции конфигурации —
  см. docs/tasks/web-migration.md, этап 0, п. 6.

  Настройки самого веб-хоста (Kestrel, логирование ASP.NET) живут отдельно,
  в appsettings.json — это разные механизмы, смешивать их не нужно.

  log4net намеренно НЕ здесь: на .NET Core секция app.config не читается,
  конфигурация вынесена в log4net.config.
-->
<configuration>
  <appSettings>
    <add key="Language" value="ru" />
    <add key="Title" value="АРТВИС" />
    <add key="StoredProcExecutionTimeThresholdMS" value="1" />
    <add key="ProposalTemplateFolder" value="Templates\" />
  </appSettings>
  <connectionStrings>
    <!-- Та же dev-база, что у десктопа. Префикс lpc: обязателен:
         ".\sqlexpress" без него не резолвится (SQLBrowser отключён). -->
    <add name="Main" connectionString="user id=AdvertAgUser; password=AdvertAg; server=lpc:.\sqlexpress; database=ArtvisDev" />
  </connectionStrings>
</configuration>
