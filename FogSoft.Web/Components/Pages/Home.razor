@page "/"
@using System.Configuration
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@inject UserSession Session

@*
    Вход и стартовый экран.

    Вход идёт через ту же процедуру GetUserData, что и в десктопе:
    SecurityManager.Login из FogSoft.Core вызывается без единой правки. Раньше
    это было написано прямо на экране — пояснение из вертикального среза;
    пользователю оно не адресовано и переехало сюда.
*@

<PageTitle>@(SecurityManager.LoggedUser == null ? Tr.T("Вход") : Tr.T("Начало"))</PageTitle>

@if (SecurityManager.LoggedUser == null)
{
    <div class="signin">
        <div class="signin-card">
            <div class="signin-title">@Title</div>
            <p class="signin-hint">@Tr.T("Введите имя пользователя и пароль")</p>

            <div class="mb-3">
                <label class="form-label" for="login">@Tr.T("Пользователь")</label>
                <input id="login" class="form-control" @bind="_login" @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") DoLogin(); })" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="password">@Tr.T("Пароль")</label>
                <input id="password" class="form-control" type="password" @bind="_password" @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") DoLogin(); })" />
            </div>

            <button class="btn btn-primary w-100" @onclick="DoLogin" disabled="@_busy">
                @(_busy ? Tr.T("Проверяю…") : Tr.T("Войти"))
            </button>

            @if (_error != null)
            {
                <div class="alert alert-danger mt-3 mb-0">@_error</div>
            }
        </div>
    </div>
}
else
{
    <h3 class="mb-3">@Title</h3>

    <div class="state">
        <div class="state-title">@Tr.T("Выберите раздел в меню слева")</div>
        @Tr.T("Перенесены журналы, карточки объектов и фильтры.")
        @Tr.T("Экраны, которых ещё нет, сообщают об этом при открытии.")
    </div>

    @* Диагностика вертикального среза: проверяет, что пользователь пережил
       переход между двумя действиями, то есть что контекст circuit работает.
       Кандидат на удаление, когда каркас перестанет быть новым. *@
    <div class="diagnostics">
        <button class="btn btn-sm btn-outline-secondary" @onclick="CheckMetadata">
            @Tr.T("Проверить загрузку метаданных")
        </button>
        @if (_metadata != null)
        {
            <pre class="diagnostics-output">@_metadata</pre>
        }
    </div>
}

@code {
    private string _login = "";
    private string _password = "";
    private string? _error;
    private string? _metadata;
    private bool _busy;

    private static string Title =>
        ConfigurationManager.AppSettings["Title"] is { Length: > 0 } title ? title : Tr.T("Система");

    private void DoLogin()
    {
        _busy = true;
        _error = null;
        try
        {
            if (WebLogin.Login(Session, _login, _password))
                _password = "";
            else
                _error = Tr.T("Неверный логин или пароль.");
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Метаданные требуют залогиненного пользователя — поэтому это и есть
    /// проверка того, что пользователь пережил переход между двумя разными
    /// действиями (вход и этот клик), то есть что контекст circuit работает.
    /// </summary>
    private void CheckMetadata()
    {
        try
        {
            Entity entity = EntityManager.GetEntity(17);
            _metadata =
                Tr.Format("Сущность {0}: {1}", entity.Id, Tr.T(entity.Name)) + "\n" +
                Tr.Format("Атрибутов: {0}", entity.SortedAttributes.Count) + "\n" +
                Tr.Format("Паспорт: {0}", string.IsNullOrEmpty(entity.XmlPassport) ? Tr.T("нет") : Tr.Format("есть, {0} симв.", entity.XmlPassport.Length)) + "\n" +
                Tr.Format("Фильтр: {0}", string.IsNullOrEmpty(entity.XmlFilter) ? Tr.T("нет") : Tr.Format("есть, {0} симв.", entity.XmlFilter.Length));
        }
        catch (Exception ex)
        {
            _metadata = ErrorPresenter.Describe(ex);
        }
    }
}
