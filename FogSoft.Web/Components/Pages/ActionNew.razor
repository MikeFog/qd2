@page "/action/new"
@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using Merlin.Classes
@inject MenuAccess Access
@inject BusyService Busy
@inject DialogService Dialogs
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ModuleRowsMemory Memory
@implements IAsyncDisposable

@*
    Мастер новой акции (docs/tasks/web-action-forms.md §3.7; решения В-5 и 07.10.2026) — один вместо трёх
    десктопных: «Внести макет рекламной акции», «Веерное размещение» (их разные проверки и поведение —
    docs/action-forms.md §2.2) и «Размещение комбо-модулями» (третий вход, ниже). Как в десктопе, сначала окно «Фирма-заказчик» (тот же
    выбор, что в «Сменить фирму-заказчика»), затем кампании — той же формой, что «Добавить рекламные
    кампании» на странице акции (CampaignAddForm). «Создать» записывает акцию и кампании одной
    транзакцией (ActionWorkspace.CreateAction) и открывает страницу акции: линейные — вкладка
    «Рекламные окна» (одна кампания — сразу отмеченной), модульные — «Модули», другие виды — «Рекламные кампании».

    Пускают пункт меню (едет в адресе) и «Редактировать» у акции и у линейной кампании — их же ядро
    проверяет перед записью. Тип рекламной кампании заранее «Линейная», тип оплаты — нет: ошибочно
    подставленная оплата бьёт по счетам.

    Третий вход — «Размещение комбо-модулями» (этап 6.7, как десктопный SelectComboModuleStep): после фирмы —
    комбо-модуль, тип оплаты и агентства радиостанций (ModuleRowsForm, только комбо-модуль). «Создать» записывает
    одну акцию без кампаний (В-5: модульные кампании — лениво, при первой постановке), строки комбо кладёт в память
    вкладки «Модули» (ModuleRowsMemory) и открывает её. Пускают ещё и по «Редактировать» модульной кампании.
*@

<PageTitle>@_title</PageTitle>

@if (SecurityManager.LoggedUser == null)
{
    <div class="state">
        <div class="state-title">@Tr.T("Вы не вошли в систему")</div>
        <a href="/">@Tr.T("Перейти к входу")</a>
    </div>
}
else if (_access != JournalAccess.Allowed)
{
    <div class="state">
        <div class="state-title">@Tr.T("Доступ закрыт")</div>
        @Tr.T("Этот экран вам не разрешён. Права на экраны выдаются вместе с пунктами меню — обратитесь к администратору системы.")
    </div>
}
else if (_canCreate == false)
{
    <div class="state">
        <div class="state-title">@Tr.T("Доступ закрыт")</div>
        @Tr.T(Merlin.Properties.Resources.OperationNotAllowed)
    </div>
}
else if (_model == null && _rows == null)
{
    @if (_error != null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="state">@Tr.T("Загрузка…")</div>
    }
}
else
{
    <div class="new-action">
        <ScreenToolbar Title="@_title">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Cancel">@Tr.T("Отмена")</button>
            <button type="button" class="btn btn-sm btn-primary" disabled="@_created" @onclick="Create">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>@Tr.T("Создать")
            </button>
        </ScreenToolbar>

        @if (_error != null)
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                @_error
                <button type="button" class="btn-close" aria-label="@(Tr.T("Закрыть"))" @onclick="() => _error = null"></button>
            </div>
        }

        <div class="new-action-body">
            <div class="firm-line">
                <span class="firm-label">@Tr.T("Фирма-заказчик")</span>
                @if (_firm == null)
                {
                    <span class="text-muted">@Tr.T("не выбрана")</span>
                }
                else
                {
                    <strong>@_firm["name"]</strong>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PickFirm">
                    @(_firm == null ? Tr.T("Выбрать") : Tr.T("Изменить"))
                </button>
            </div>

            @if (_rows != null)
            {
                <ModuleRowsForm Value="_rows" ComboOnly="true" />
            }
            else
            {
                <CampaignAddForm Value="_model!" />
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "menu")] public string? Menu { get; set; }

    private string _title = Tr.T("Новая рекламная акция");
    private JournalAccess _access = JournalAccess.Allowed;
    private bool? _canCreate;
    private string? _initializedFor;
    private string? _error;

    private CampaignAddForm.Model? _model;

    /// <summary>Вход «Размещение комбо-модулями»: комбо-модуль, тип оплаты и агентства вместо кампаний.</summary>
    private ModuleRowsForm.Model? _rows;
    private Entity? _firmEntity;
    private DataTable? _firmCandidates;
    private DataRow? _firm;
    private bool _pickFirmOnRender;

    /// <summary>
    /// Окно «Фирма-заказчик», которое страница открыла сама. Диалоги живут на circuit, а не на странице:
    /// уйди со страницы «Назад» браузера — окно осталось бы над другим экраном. Закрывается при уходе.
    /// </summary>
    private DialogRequest? _firmDialog;

    /// <summary>Акция записана: второй щелчок по «Создать» (Blazor ставит его в очередь) второй не создаёт.</summary>
    private bool _created;

    protected override async Task OnParametersSetAsync()
    {
        if (SecurityManager.LoggedUser == null)
            return;

        string code = ResolveMenu();
        if (code == _initializedFor)
            return;
        // Отметка до чтения: второй проход параметров на тот же переход не начинает заново.
        _initializedFor = code;
        await CloseFirmDialog();
        _model = null;
        _rows = null;
        _canCreate = null;
        _firm = null;
        _error = null;
        _created = false;

        _access = Access.CheckScreen(code);
        if (_access != JournalAccess.Allowed)
            return;
        // Многоточие пунктов меню — наследие десктопа (docs/UI_RULES.md, п. 2.5): в заголовке его нет.
        _title = Access.MenuText(code)?.TrimEnd('.', '…', ' ') ?? Tr.T("Новая рекламная акция");

        try
        {
            bool combo = code == ScreenRoutes.CreateActionCombo;
            await Busy.RunAsync(() =>
            {
                _canCreate = combo ? ActionWorkspace.CanCreateComboActions() : ActionWorkspace.CanCreateActions();
                if (_canCreate != true)
                    return;
                _firmEntity = EntityManager.GetEntity((int)Merlin.Entities.Firm);
                if (combo)
                    _rows = new ModuleRowsForm.Model
                    {
                        Date = DateTime.Today,
                        CanAdd = true,
                        ForWizard = true,
                        PaymentTypes = ActionWorkspace.LoadNewCampaignChoices().PaymentTypes,
                        Source = ModuleRowsForm.Sources.Combo,
                        Combos = ModuleDaySource.ComboModules(),
                    };
                else
                    _model = new CampaignAddForm.Model
                    {
                        Choices = ActionWorkspace.LoadNewCampaignChoices(),
                        CampaignTypeId = ActionWorkspace.LinearCampaignType,
                    };
            });
            _pickFirmOnRender = _model != null || _rows != null;
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// Пункт меню из адреса; без него — первый разрешённый из первых двух. Вид кампаний оба пункта задают
    /// один («Линейная»): «Веерное размещение» отличается только тем, что веер — на странице акции.
    /// </summary>
    private string ResolveMenu()
    {
        if (string.Equals(Menu, ScreenRoutes.CreateActionCombo, StringComparison.OrdinalIgnoreCase))
            return ScreenRoutes.CreateActionCombo;
        if (string.Equals(Menu, ScreenRoutes.CreateActionVeer, StringComparison.OrdinalIgnoreCase))
            return ScreenRoutes.CreateActionVeer;
        if (string.Equals(Menu, ScreenRoutes.CreateAction, StringComparison.OrdinalIgnoreCase))
            return ScreenRoutes.CreateAction;
        return Access.CheckScreen(ScreenRoutes.CreateAction) == JournalAccess.Allowed
            ? ScreenRoutes.CreateAction
            : ScreenRoutes.CreateActionVeer;
    }

    /// <summary>Как в десктопе: войдя, сразу выбирают фирму.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pickFirmOnRender)
            return;
        _pickFirmOnRender = false;
        await PickFirm();
        StateHasChanged();
    }

    /// <summary>Окно «Фирма-заказчик» — тот же набор фирм, что у десктопного Firm.SelectFirm.</summary>
    private async Task PickFirm()
    {
        if (_firmEntity == null)
            return;

        try
        {
            _firmCandidates ??= await Busy.RunAsync(Merlin.Classes.Firm.GetFirmCandidates);

            ObjectSelector? selector = null;
            RenderFragment body = builder =>
            {
                builder.OpenComponent<ObjectSelector>(0);
                builder.AddComponentParameter(1, nameof(ObjectSelector.SourceEntity), _firmEntity);
                builder.AddComponentParameter(2, nameof(ObjectSelector.SourceRows), _firmCandidates);
                builder.AddComponentReferenceCapture(3, c => selector = (ObjectSelector)c);
                builder.CloseComponent();
            };

            Task<DialogOutcome> shown = Dialogs.ShowAsync(Tr.T("Фирма-заказчик"), body, okText: Tr.T("Выбрать"));
            // Окно уже в стеке: ShowAsync кладёт его туда до первого ожидания.
            DialogRequest? dialog = Dialogs.Current;
            _firmDialog = dialog;
            DialogOutcome outcome = await shown;
            if (ReferenceEquals(_firmDialog, dialog))
                _firmDialog = null;
            if (outcome == DialogOutcome.Ok && selector?.SelectedRow is DataRow row)
            {
                _firm = row;
                if (_model != null)
                    _model.Message = null;
                if (_rows != null)
                    _rows.Message = null;
            }
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    private async Task Create(MouseEventArgs e)
    {
        // Второй щелчок двойного (detail > 1) — не повтор: после отказа он показал бы ту же ошибку.
        if (_created || e.Detail > 1)
            return;
        if (_rows != null)
        {
            await CreateCombo(_rows);
            return;
        }
        if (_model == null)
            return;

        _model.Message = _firm == null ? Tr.T("Выберите фирму-заказчика.") : _model.Validate();
        if (_model.Message != null)
            return;

        // Радиостанции без агентств пропускаются — об этом сказано под таблицей.
        List<ActionWorkspace.NewCampaign> campaigns = _model.Build(out _);
        int campaignTypeId = _model.CampaignTypeId!.Value;
        int paymentTypeId = _model.PaymentTypeId!.Value;
        DataRow firm = _firm!;
        try
        {
            ActionWorkspace.CreatedAction created = await Busy.RunAsync(() =>
                ActionWorkspace.CreateAction(firm, campaignTypeId, paymentTypeId, campaigns));
            _created = true;
            // Адрес мастера заменяется: «Назад» со страницы акции ведёт туда, откуда пришли в мастер.
            Nav.NavigateTo(LandingUrl(created, campaignTypeId), replace: true);
        }
        catch (Exception ex)
        {
            // Записано ничего не осталось (одна транзакция) — можно поправить и повторить.
            _model.Message = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// «Размещение комбо-модулями»: акция без кампаний, строки комбо — в память вкладки «Модули» этой акции, затем
    /// вкладка. Радиостанции без агентства пропускаются — об этом сказано под таблицей.
    /// </summary>
    private async Task CreateCombo(ModuleRowsForm.Model rows)
    {
        rows.Message = _firm == null ? Tr.T("Выберите фирму-заказчика.") : rows.Validate();
        if (rows.Message != null)
            return;

        List<ModuleDaySource.AddedRow> added = rows.Build(out _);
        DataRow firm = _firm!;
        try
        {
            int actionId = await Busy.RunAsync(() => ActionWorkspace.CreateActionWithoutCampaigns(firm));
            _created = true;
            Memory.Add(actionId, added);
            Nav.NavigateTo(ActionPage.ModulesUrl(actionId), replace: true);
        }
        catch (Exception ex)
        {
            rows.Message = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// Линейные — на «Рекламные окна»: одна кампания — сразу её неделя, несколько — веер по всем;
    /// модульные — на «Модули» (одна кампания — она, несколько — все); спонсорские — на «Спонсорство»
    /// (кампании по одной: первая). Пакетным вкладки размещения в вебе пока нет — «Рекламные кампании».
    /// </summary>
    private static string LandingUrl(ActionWorkspace.CreatedAction created, int campaignTypeId)
    {
        int? single = created.CampaignIds.Count == 1 ? created.CampaignIds[0] : null;
        if (campaignTypeId == ActionWorkspace.LinearCampaignType)
            return ActionPage.WindowsUrl(created.ActionId, single);
        if (campaignTypeId == ActionWorkspace.ModuleCampaignType)
            return ActionPage.ModulesUrl(created.ActionId, single);
        if (campaignTypeId == ActionWorkspace.SponsorCampaignType)
            return ActionPage.SponsorshipUrl(created.ActionId, created.CampaignIds.Count > 0 ? created.CampaignIds[0] : null);
        return ActionPage.Url(created.ActionId);
    }

    /// <summary>Закрыть своё окно выбора фирмы, если оно ещё открыто и верхнее.</summary>
    private async Task CloseFirmDialog()
    {
        DialogRequest? dialog = _firmDialog;
        _firmDialog = null;
        if (dialog != null && ReferenceEquals(Dialogs.Current, dialog))
            await Dialogs.CloseAsync(DialogOutcome.Cancel);
    }

    public async ValueTask DisposeAsync() => await CloseFirmDialog();

    private async Task Cancel()
    {
        try { await JS.InvokeVoidAsync("history.back"); }
        catch (JSDisconnectedException) { }
    }
}
