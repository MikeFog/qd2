@page "/journal/{EntityId:int}"
@using System.Data
@using System.Globalization
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using FogSoft.WinForm.Passport.Classes
@inject PassportDialog Passports
@inject MenuAccess Access
@inject DialogService Dialogs

@*
    Движок журнала: список объектов сущности, фильтр и карточка — всё по
    метаданным, без кода на конкретный экран. Это и есть проверка главной
    ставки плана (раздел 2): один рендерер закрывает большинство из 89 пунктов
    меню.

    Загрузка данных повторяет канонический путь десктопа (JournalForm.LoadData):
        entity.ClearCache();
        entity.GetContent(filterValues);
    Entity наследует GetContent от ObjectsIterator и сам себе ChildEntity, так
    что ни своего SQL, ни своей выборки здесь нет.

    Журнал плоский. У сущности 17 в десктопе иерархия (AdvertType.GetContent с
    parentID), но древовидный журнал — отдельный движок этапа 2; решение и
    причина записаны в docs/tasks/web-migration.md, раздел 10.
*@

<PageTitle>@(_entity?.Name ?? "Журнал")</PageTitle>

@if (SecurityManager.LoggedUser == null)
{
    <div class="state">
        <div class="state-title">Вы не вошли в систему</div>
        <a href="/">Перейти к входу</a>
    </div>
}
else if (_access == JournalAccess.Denied)
{
    <div class="state">
        <div class="state-title">Доступ закрыт</div>
        Этот журнал вам не разрешён. Права на экраны выдаются вместе с пунктами
        меню — обратитесь к администратору системы.
    </div>
}
else if (_access == JournalAccess.NotPorted)
{
    <div class="state">
        <div class="state-title">Экран не перенесён</div>
        Журнала сущности @EntityId в вебе пока нет — на неё не ведёт ни один
        перенесённый пункт меню. Это не ограничение прав.
    </div>
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_entity == null)
{
    <div class="state">Загрузка…</div>
}
else
{
    <div class="journal">

    @* Шапка экрана: название слева, единственное главное действие справа.
       Счётчик записей рядом с названием, а не под кнопкой: это свойство
       списка, а не результат действия. *@
    <header class="screen-head">
        <h3>@_entity.Name</h3>
        <span class="screen-count">@(_data?.Rows.Count ?? 0)</span>
        <div class="screen-actions">
            <button class="btn btn-primary btn-sm" disabled="@(!_canAdd)" @onclick="AddNew">Добавить</button>
        </div>
    </header>

    @* ---------- Фильтр ---------- *@
    @if (_filterPages.Count > 0)
    {
        <section class="filter">
            <button type="button" class="filter-toggle" @onclick="() => _filterOpen = !_filterOpen">
                <span class="filter-caret">@(_filterOpen ? "▾" : "▸")</span>
                Отбор
            </button>

            @if (_filterOpen)
            {
                <div class="filter-body">
                    <div class="filter-grid">
                        @foreach (var pg in _filterPages)
                        {
                            @foreach (var field in pg.Fields)
                            {
                                @if (field.Unsupported != null)
                                {
                                    @* Проверка Unsupported тут обязательна и должна идти первой:
                                       без неё lookup, у которого источник задан через entity, а
                                       не через source, молча превратился бы в поле для ввода
                                       текста — и туда можно было бы написать что угодно вместо
                                       выбора из списка. *@
                                    <div class="filter-note">
                                        @field.Caption — @field.Unsupported в фильтре пока не поддержан (этап 2).
                                    </div>
                                }
                                else if (field.Type is { IsBoolean: true })
                                {
                                    <div class="filter-check">
                                        <input type="checkbox" class="form-check-input" id="@("f_" + field.Name)"
                                               checked="@GetFilterBool(field.Name)"
                                               @onchange="e => SetFilterBool(field.Name, e.Value)" />
                                        <label class="form-check-label" for="@("f_" + field.Name)">@field.Caption</label>
                                    </div>
                                }
                                else
                                {
                                    @* Галочка «использовать» — левая колонка десктопного
                                       PageField: в режиме фильтра там не подпись, а CheckBox,
                                       и параметр уходит в процедуру только когда он отмечен
                                       (ValueShouldBeSet). *@
                                    <input type="checkbox" class="form-check-input"
                                           checked="@IsFilterUsed(field.Name)"
                                           @onchange="e => UseFilter(field, e.Value)" />
                                    <label class="filter-label">@field.Caption</label>

                                    @if (field.Lookup != null)
                                    {
                                        @* Пустого пункта в списке нет: в фильтре пустоту
                                           выражает снятая галочка, а не пустая строка
                                           (десктопное Lookup.IsNullable = isNullable &&
                                           PageType == Passport, то есть всегда false в фильтре). *@
                                        <select class="form-select form-select-sm"
                                                disabled="@(!IsFilterUsed(field.Name))"
                                                value="@FilterLookupValue(field)"
                                                @onchange="e => SetFilterLookup(field, e.Value)">
                                            @foreach (DataRowView row in FilterLookupRows(field))
                                            {
                                                <option value="@AsFilterText(row[field.Lookup.ColumnWithId])">@FilterLookupDisplay(row)</option>
                                            }
                                        </select>
                                    }
                                    else if (field.Picker != null)
                                    {
                                        @* Кнопки «Создать» в фильтре нет — PageFieldObjectPicker
                                           гасит её при PageTypes.Filter независимо от
                                           isCreateNewAllowed. *@
                                        <div class="input-group input-group-sm">
                                            <input class="form-control" readonly
                                                   disabled="@(!IsFilterUsed(field.Name))"
                                                   value="@FilterPickerName(field)" />
                                            <button type="button" class="btn btn-outline-secondary"
                                                    disabled="@(!IsFilterUsed(field.Name))"
                                                    @onclick="() => SelectFilterPicker(field)">Выбрать</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="@InputType(field)" class="form-control form-control-sm"
                                               disabled="@(!IsFilterUsed(field.Name))"
                                               value="@GetFilterText(field)"
                                               @onchange="e => SetFilterText(field, e.Value)" />
                                    }
                                }
                            }
                        }
                    </div>

                    <div class="filter-foot">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Load">Применить</button>
                    </div>
                </div>
            }
        </section>
    }

    @* ---------- Список ---------- *@
    @* Кнопки гасятся по тем же правам и теми же вызовами, что в десктопном
       JournalForm (tsbNew/tsbEdit). Это только удобство: настоящая проверка
       стоит на исполнении, в DataAccessor.DoAction. *@
    @if (_data != null)
    {
        @if (_data.Rows.Count == 0)
        {
            <div class="state">Записей нет. Измените условия отбора.</div>
        }
        else
        {
            @* Виртуализация: в разметке живут только видимые строки. Замер на
               журнале удалённых выпусков (40 521 строка) до неё: первая
               отрисовка ~30 секунд, 405 409 узлов в DOM и 1,8 секунды на любой
               следующий клик — Blazor Server считает разницу по всему дереву.
               Процедура при этом отдаёт те же строки за десятки миллисекунд,
               то есть узкое место чисто в отрисовке. Раздел 7 п.4 плана.

               Постраничности намеренно нет: в десктопе её тоже нет, прокрутка
               идёт по всему списку. SpacerElement="tr" обязателен — распорки
               по умолчанию div, а внутри tbody это недопустимая разметка. *@
            <div class="data-table journal-table">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            @foreach (var a in _columns)
                            {
                                <th class="sortable" @onclick="() => SortBy(a.Name)">
                                    @a.Alias<span class="sort-mark">@SortMark(a.Name)</span>
                                </th>
                            }
                            <th class="col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize TItem="DataRow" Items="_rows" ItemSize="29" SpacerElement="tr" Context="row">
                            <tr>
                                @foreach (var a in _columns)
                                {
                                    <td title="@Display(row, a.Name)">@Display(row, a.Name)</td>
                                }
                                <td class="col-actions">
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@(!_canOpen)"
                                            @onclick="() => Edit(row)">Открыть</button>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@(!_canDelete)"
                                            @onclick="() => Delete(row)">Удалить</button>
                                </td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
        }
    }

    </div>
}

@code {
    [Parameter] public int EntityId { get; set; }

    private Entity? _entity;
    private DataTable? _data;
    private IReadOnlyList<Entity.Attribute> _columns = Array.Empty<Entity.Attribute>();
    private readonly Dictionary<string, object> _filterValues =
        new(StringComparer.InvariantCultureIgnoreCase);
    private IReadOnlyList<PassportPage> _filterPages = Array.Empty<PassportPage>();

    // Наборы строк для lookup/objectPicker фильтра — результат
    // Globals.PrepareForFilter(_entity), отдельная процедура от паспортной
    // (EntityId_Load_FilterPage, а не PropertyPage). null, если у сущности
    // нет процедуры фильтра — тогда контролы грузят список сами по entity.
    private DataSet? _filterData;

    // Запасной путь lookup-а по entity и разрешение имени objectPicker бьют в
    // базу, поэтому кэшируются на время жизни компонента — иначе каждый
    // перерендер (например, ввод в соседнем поле фильтра) читал бы их заново.
    private readonly Dictionary<string, DataTable> _filterLookupCache =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _filterPickerNames =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _filterPickerNamesFor =
        new(StringComparer.OrdinalIgnoreCase);

    private string? _error;
    private bool _filterOpen = true;
    private JournalAccess _access = JournalAccess.Allowed;
    private bool _canAdd;
    private bool _canOpen;
    private bool _canDelete;

    /// <summary>
    /// Строки списка в порядке показа. Отдельный список, а не DataTable.Rows:
    /// Virtualize требует типизированную коллекцию, а сортировка меняет
    /// порядок, не трогая сам набор.
    /// </summary>
    private List<DataRow> _rows = new();

    private string? _sortColumn;
    private bool _sortDescending;

    protected override void OnParametersSet()
    {
        if (SecurityManager.LoggedUser == null)
            return;

        // Доступ к экрану проверяется на сервере, а не тем, что пункта нет в меню:
        // адрес /journal/{id} можно набрать руками. Разрешение — то же самое,
        // что гасит пункт меню (UserMenuItems.enabled), см. MenuAccess.
        _access = Access.CheckJournal(EntityId);
        if (_access != JournalAccess.Allowed)
        {
            _entity = null;
            return;
        }

        try
        {
            _error = null;
            _entity = EntityManager.GetEntity(EntityId);
            _columns = _entity.SortedAttributes;
            _filterPages = PassportSchema.Parse(_entity.XmlFilter, _entity, pageType: PageTypes.Filter);

            _canAdd = _entity.IsActionEnabled(Constants.EntityActions.AddNew, ViewType.Journal);
            _canOpen = _entity.IsActionEnabled(Constants.EntityActions.ShowPassport, ViewType.Journal);
            _canDelete = _entity.IsActionEnabled(Constants.EntityActions.Delete, ViewType.Journal);

            // Своя процедура фильтра (EntityId_Load_FilterPage), не паспортная —
            // грузится только если в фильтре реально есть lookup/objectPicker,
            // которым есть куда её девать: большинство журналов обходятся без
            // неё, и незачем лишний раз идти в базу.
            _filterLookupCache.Clear();
            _filterPickerNames.Clear();
            _filterPickerNamesFor.Clear();
            _filterData = NeedsFilterData(_filterPages) ? Globals.PrepareForFilter(_entity) : null;

            // Значения фильтра по умолчанию берутся из самих метаданных —
            // тем же кодом, что и в десктопе (Globals.ResolveFilterInitialValues).
            _filterValues.Clear();
            Globals.ResolveFilterInitialValues(_filterValues, _entity.XmlFilter);

            Load();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    private static bool NeedsFilterData(IReadOnlyList<PassportPage> pages)
    {
        foreach (var pg in pages)
            foreach (var f in pg.Fields)
                if (f.Unsupported == null && (f.Lookup != null || f.Picker != null))
                    return true;
        return false;
    }

    private void Load()
    {
        try
        {
            _error = null;
            _entity!.ClearCache();
            _data = _entity.GetContent(_filterValues);
            ApplySort();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// Значения фильтра хранятся так же, как в десктопе — словарём
    /// «имя параметра → значение», который уходит прямо в GetContent.
    /// Своей типизации не вводим: процедура ждёт тот же набор.
    /// </summary>
    private bool GetFilterBool(string name) =>
        _filterValues.TryGetValue(name, out object? v)
        && v != null
        && bool.TryParse(v.ToString(), out bool b)
        && b;

    private void SetFilterBool(string name, object? value)
    {
        // ResolveFilterInitialValues кладёт значения строками ("True"),
        // поэтому и мы пишем строкой — иначе при сравнении фильтров
        // (ObjectsIterator.IsNewFilter) типы разъедутся.
        _filterValues[name] = (value is bool b && b).ToString();
    }

    /// <summary>
    /// Используется ли параметр. Ровно то же, что делает десктоп: галочка в
    /// левой колонке фильтра отмечена, когда значение есть
    /// (PageField.SetValue), а неотмеченное поле из параметров удаляется
    /// (ApplyChanges при !ValueShouldBeSet).
    /// </summary>
    private bool IsFilterUsed(string name) => _filterValues.ContainsKey(name);

    private void UseFilter(PassportField field, object? value)
    {
        if (value is bool on && on)
            _filterValues[field.Name] = InitialFilterValue(field);
        else
            _filterValues.Remove(field.Name);
    }

    /// <summary>
    /// Значение, которое ставится в момент, когда галочку «использовать»
    /// только что отметили.
    ///
    /// У lookup-а в фильтре нет пустого пункта — список всегда показывает
    /// первую строку (десктопное Lookup.IsNullable = false в PageTypes.Filter,
    /// а присвоение DataSource само встаёт на нулевой индекс). Не подставить
    /// её здесь означало бы разойтись с тем, что видно на экране: список
    /// показывал бы первую строку, а в процедуру ушло бы пустое значение.
    ///
    /// objectPicker пустого выбора не боится (десктопный ApplyChanges при
    /// SelectedObject == null просто не пишет параметр, даже если галочка
    /// отмечена) — значение выставляется только после «Выбрать».
    /// </summary>
    private object InitialFilterValue(PassportField field)
    {
        if (field.Lookup != null)
        {
            foreach (DataRowView row in FilterLookupRows(field))
                return row[field.Lookup.ColumnWithId];
            return DBNull.Value;
        }

        if (field.Picker != null)
            return DBNull.Value;

        return "";
    }

    private static string InputType(PassportField field) =>
        field.Type switch
        {
            { IsDate: true } => "date",
            { IsInteger: true } or { IsDecimal: true } or { IsMoney: true } => "number",
            _ => "text"
        };

    /// <summary>
    /// Значение для поля ввода.
    ///
    /// В словаре фильтра значения лежат строками в культуре системы — так их
    /// кладёт ResolveFilterInitialValues, и так их ждёт разбор параметров
    /// процедуры. HTML-инпуты живут по своим правилам: <c>type="date"</c>
    /// отдаёт и принимает только ISO, <c>type="number"</c> — только точку как
    /// разделитель дробной части. Поэтому оба типа переводятся туда и обратно.
    /// Это тот самый стык из раздела 7 п.5 плана, и он не теоретический:
    /// без перевода чисел ввод «0.5» падал с «The input string '0.5' was not
    /// in a correct format».
    /// </summary>
    private string GetFilterText(PassportField field)
    {
        if (!_filterValues.TryGetValue(field.Name, out object? value) || value == null)
            return "";

        string text = value.ToString() ?? "";
        if (text.Length == 0)
            return text;

        if (field.Type is { IsDate: true })
            return DateTime.TryParse(text, out DateTime date) ? date.ToString("yyyy-MM-dd") : "";

        if (IsFractional(field))
            return decimal.TryParse(text, out decimal number)
                ? number.ToString(CultureInfo.InvariantCulture)
                : "";

        return text;
    }

    private void SetFilterText(PassportField field, object? value)
    {
        string text = value?.ToString() ?? "";

        // Обратный перевод: в процедуру должна уйти строка того же вида, что у
        // значений из метаданных, иначе один и тот же фильтр выглядел бы
        // по-разному в зависимости от того, кто его заполнил.
        if (text.Length > 0)
        {
            if (field.Type is { IsDate: true })
                text = DateTime.TryParse(text, out DateTime date) ? date.ToString() : "";
            else if (IsFractional(field))
                text = decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal number)
                    ? number.ToString()
                    : "";
        }

        _filterValues[field.Name] = text;
    }

    // Целые числа разделителя не имеют, переводить нечего.
    private static bool IsFractional(PassportField field) =>
        field.Type is { IsDecimal: true } or { IsMoney: true };

    // ---------- lookup фильтра ----------

    private static string AsFilterText(object? v) =>
        v == null || v == DBNull.Value ? "" : v.ToString() ?? "";

    /// <summary>
    /// Строки списка. Готовый набор по source, если он есть в _filterData,
    /// иначе — запасной путь по entity (PickerData.LookupRows), закэшированный
    /// на время жизни компонента: без кэша каждый перерендер страницы читал бы
    /// сущность заново.
    /// </summary>
    private DataView FilterLookupRows(PassportField field)
    {
        if (!_filterLookupCache.TryGetValue(field.Name, out DataTable? table))
        {
            table = PickerData.LookupRows(field.Lookup!, _filterData) ?? new DataTable();
            _filterLookupCache[field.Name] = table;
        }
        return new DataView(table);
    }

    private static string FilterLookupDisplay(DataRowView row) =>
        row.Row.Table.Columns.Contains(Constants.Parameters.Name)
            ? AsFilterText(row[Constants.Parameters.Name])
            : "(в наборе нет колонки name)";

    /// <summary>
    /// Значение для &lt;select&gt;. Пока галочка не отмечена, ключа в
    /// _filterValues ещё нет — показываем первую строку списка, ровно то же
    /// значение, что InitialFilterValue поставит в момент отметки: иначе
    /// список визуально показывал бы первую строку (так уже ведёт себя HTML
    /// &lt;select&gt; без пустого пункта), пока подставленное значение с ней
    /// не совпадало бы.
    /// </summary>
    private string FilterLookupValue(PassportField field)
    {
        if (_filterValues.TryGetValue(field.Name, out object? v) && v != null && v != DBNull.Value)
            return AsFilterText(v);

        foreach (DataRowView row in FilterLookupRows(field))
            return AsFilterText(row[field.Lookup!.ColumnWithId]);
        return "";
    }

    private void SetFilterLookup(PassportField field, object? value)
    {
        string selected = value?.ToString() ?? "";

        // В процедуру должно уйти значение того же типа, что в наборе строк
        // (int, а не строка из разметки), поэтому берём его из самой строки —
        // тот же приём, что и у lookup-а паспорта (Passport.razor.WriteLookup).
        object result = DBNull.Value;
        foreach (DataRowView row in FilterLookupRows(field))
            if (AsFilterText(row[field.Lookup!.ColumnWithId]) == selected)
            {
                result = row[field.Lookup!.ColumnWithId];
                break;
            }

        _filterValues[field.Name] = result;
    }

    // ---------- objectPicker фильтра ----------

    /// <summary>
    /// Имя выбранного объекта. Разрешение стоит обращения к базе
    /// (PickerData.NameOf), поэтому результат держится, пока не изменится
    /// сохранённый идентификатор — тот же приём, что у objectPicker паспорта
    /// (Passport.razor.PickerName).
    /// </summary>
    private string FilterPickerName(PassportField field)
    {
        _filterValues.TryGetValue(field.Name, out object? raw);
        string id = AsFilterText(raw);

        if (_filterPickerNamesFor.TryGetValue(field.Name, out string? resolvedFor) && resolvedFor == id)
            return _filterPickerNames[field.Name];

        string name = PickerData.NameOf(field.Picker!, _filterData, raw);
        _filterPickerNames[field.Name] = name;
        _filterPickerNamesFor[field.Name] = id;
        return name;
    }

    private async Task SelectFilterPicker(PassportField field)
    {
        ObjectSelector? selector = null;

        RenderFragment body = builder =>
        {
            builder.OpenComponent<ObjectSelector>(0);
            builder.AddComponentParameter(1, nameof(ObjectSelector.Picker), field.Picker);
            builder.AddComponentParameter(2, nameof(ObjectSelector.PassportData), _filterData);
            builder.AddComponentReferenceCapture(3, c => selector = (ObjectSelector)c);
            builder.CloseComponent();
        };

        if (await Dialogs.ShowAsync("Выбрать объект", body, okText: "Выбрать") != DialogOutcome.Ok)
            return;

        // Пустой выбор — не команда очистить: тот же случай, что и у
        // objectPicker паспорта (Passport.razor.Select). Очистка — снятие
        // галочки «использовать».
        if (selector?.SelectedRow == null)
            return;

        Entity entity = EntityManager.GetEntity(field.Picker!.EntityName);
        _filterValues[field.Name] = entity.CreateObject(selector.SelectedRow).IDs[0] ?? (object)DBNull.Value;
        _filterPickerNames.Remove(field.Name);
        _filterPickerNamesFor.Remove(field.Name);
    }

    private string Display(DataRow row, string column)
    {
        if (!row.Table.Columns.Contains(column))
            return "";
        object v = row[column];
        return v == DBNull.Value ? "" : v.ToString() ?? "";
    }

    // Открытие карточки — дословный аналог десктопного
    //     if (form.ShowDialog(owner) == DialogResult.OK) { ... }
    // Поднятие доменного класса по метаданным может упасть на резолвинге типа,
    // поэтому перехват: без него исключение убивает circuit и пользователь
    // видит безымянную "внутреннюю ошибку" вместо причины.
    private async Task Edit(DataRow row)
    {
        try
        {
            await EditObject(_entity!.CreateObject(row), isNew: false);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    private async Task AddNew()
    {
        try
        {
            await EditObject(_entity!.NewObject, isNew: true);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// Показывает карточку и, если объект сохранён, обновляет список.
    /// Сам показ и цикл сохранения — в PassportDialog: та же карточка
    /// открывается ещё и кнопкой «Создать» у objectPicker.
    /// </summary>
    private async Task EditObject(PresentationObject obj, bool isNew)
    {
        if (await Passports.ShowAsync(obj, isNew))
            Load();
    }

    // ---------- Сортировка ----------

    /// <summary>
    /// Сортировка на клиенте, как в десктопе: SmartGrid отдаёт её
    /// DataGridView (SortMode.Automatic) поверх DataView, в процедуру ничего
    /// не передаётся. Повторный щелчок по той же колонке меняет направление.
    /// </summary>
    private void SortBy(string column)
    {
        if (string.Equals(_sortColumn, column, StringComparison.OrdinalIgnoreCase))
            _sortDescending = !_sortDescending;
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        if (_data == null)
        {
            _rows = new List<DataRow>();
            return;
        }

        if (_sortColumn == null || !_data.Columns.Contains(_sortColumn))
        {
            _rows = _data.Rows.Cast<DataRow>().ToList();
            return;
        }

        // Сортируем через DataView: он сравнивает значения по типу колонки,
        // а не по их строковому виду — иначе числа и даты выстроились бы
        // лексикографически.
        var view = new DataView(_data)
        {
            Sort = $"[{_sortColumn.Replace("]", "]]")}] {(_sortDescending ? "DESC" : "ASC")}"
        };
        _rows = view.Cast<DataRowView>().Select(v => v.Row).ToList();
    }

    private string SortMark(string column) =>
        string.Equals(_sortColumn, column, StringComparison.OrdinalIgnoreCase)
            ? (_sortDescending ? " ▾" : " ▴")
            : "";

    // ---------- Удаление ----------

    /// <summary>
    /// Спрашиваем сами и зовём Delete(silenceFlag: true), а не Delete().
    ///
    /// Десктоп спрашивает изнутри Delete() через UserInteraction.Confirm —
    /// синхронно, потому что модальная форма блокирует поток. В вебе так
    /// нельзя: circuit нельзя заблокировать в ожидании ответа. Поэтому
    /// разрез «спросить / сделать», конвенция этапа 0. Текст вопроса тот же
    /// самый — DeleteConfirmationText доменного класса, включая его
    /// переопределения.
    /// </summary>
    private async Task Delete(DataRow row)
    {
        try
        {
            PresentationObject obj = _entity!.CreateObject(row);

            if (!obj.IsActionEnabled(Constants.EntityActions.Delete, ViewType.Journal))
                return;

            if (await Dialogs.ShowAsync(
                    "Удаление",
                    builder => builder.AddContent(0, obj.DeleteConfirmationText),
                    okText: "Удалить") != DialogOutcome.Ok)
                return;

            obj.Delete(silenceFlag: true);
            Load();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

}
