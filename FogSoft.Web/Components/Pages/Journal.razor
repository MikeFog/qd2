@page "/journal/{EntityId:int}"
@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using FogSoft.WinForm.Passport.Classes
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav
@inject PassportDialog Passports
@inject MenuAccess Access
@inject ObjectActions Actions

@*
    Движок журнала: список объектов сущности, фильтр и карточка — всё по
    метаданным, без кода на конкретный экран. Это и есть проверка главной
    ставки плана (раздел 2): один рендерер закрывает большинство из 89 пунктов
    меню.

    Загрузка данных повторяет канонический путь десктопа (JournalForm.LoadData):
        entity.ClearCache();
        entity.GetContent(filterValues);
    Entity наследует GetContent от ObjectsIterator и сам себе ChildEntity, так
    что ни своего SQL, ни своей выборки здесь нет.

    Журнал плоский. У сущности 17 в десктопе иерархия (AdvertType.GetContent с
    parentID), но древовидный журнал — отдельный движок этапа 2; решение и
    причина записаны в docs/tasks/web-migration.md, раздел 10.
*@

<PageTitle>@(Title ?? "Журнал")</PageTitle>

@if (SecurityManager.LoggedUser == null)
{
    <div class="state">
        <div class="state-title">Вы не вошли в систему</div>
        <a href="/">Перейти к входу</a>
    </div>
}
else if (_access == JournalAccess.Denied)
{
    <div class="state">
        <div class="state-title">Доступ закрыт</div>
        Этот журнал вам не разрешён. Права на экраны выдаются вместе с пунктами
        меню — обратитесь к администратору системы.
    </div>
}
else if (_access == JournalAccess.NotPorted)
{
    <div class="state">
        <div class="state-title">Экран не перенесён</div>
        Журнала сущности @EntityId в вебе пока нет — на неё не ведёт ни один
        перенесённый пункт меню. Это не ограничение прав.
    </div>
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_entity == null)
{
    <div class="state">Загрузка…</div>
}
else
{
    <div class="journal">

    @* Тулбар — как JournalForm: Добавить | Обновить | Экспорт. «Изменить» и
       «Удалить» десктопа здесь — действия строки («⋯»), «Фильтр» — постоянная
       панель ниже, поэтому в тулбар они не переносятся. «Обновить» читает
       список тем же путём, что «Применить» в отборе. *@
    <ScreenToolbar Title="@Title" Count="@(_data?.Rows.Count ?? 0)">
        @if (_route?.BulkAction is { } bulk)
        {
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_bulkPending == 0)" @onclick="RunBulkAction"><i class="bi bi-check2-all" aria-hidden="true"></i>@bulk.Caption</button>
        }
        <button class="btn btn-primary btn-sm" disabled="@(!_canAdd)" @onclick="AddNew"><i class="bi bi-plus-lg" aria-hidden="true"></i>Добавить</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Load"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Обновить</button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(_data == null || _data.Rows.Count == 0)" @onclick="ExportExcel"><i class="bi bi-download" aria-hidden="true"></i>Экспорт в Excel</button>
    </ScreenToolbar>

    @* ---------- Фильтр ---------- *@
    <FilterPanel Pages="_filterPages" Values="_filterValues" FilterData="_filterData" Apply="Load"
                 RestrictManager="_route?.ManagerFilter == true" />

    @* ---------- Список ---------- *@
    @* Действия над строками — меню ObjectActions, доступность пунктов по
       тем же IsActionEnabled, что в десктопе. Это только удобство: настоящая
       проверка стоит на исполнении, в DataAccessor.DoAction. *@
    <ObjectList @ref="_list" Entity="_dataEntity ?? _entity" Data="_data"
                EmptyText="Записей нет. Измените условия отбора."
                Changed="Load" Failed="ShowError" />

    </div>
}

@code {
    [Parameter] public int EntityId { get; set; }

    /// <summary>
    /// codeName пункта меню, из которого открыт журнал (<c>?menu=</c>). Правило
    /// ManagerFilter и заголовок привязаны к пункту, а не к сущности
    /// (<see cref="JournalRoute"/>). Без параметра (адрес набран руками) берётся
    /// первый маршрут на эту сущность. Значение читается из адреса
    /// (<see cref="ResolveRoute"/>); параметр нужен, чтобы смена пункта меню при той же
    /// сущности вообще вызывала <c>OnParametersSet</c>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "menu")] public string? Menu { get; set; }

    private JournalRoute? _route;
    private string? _menuCode;
    private int? _loadedEntityId;

    // Начальное значение отбора, с которым журнал загружен (JournalRoute.FilterDefault).
    // Два пункта меню на одну сущность различаются только им, и переход между ними
    // должен перечитать журнал, хотя EntityId не менялся.
    private FilterDefault? _loadedFilterDefault;

    // Заголовок — как в десктопе: свой у маршрута (то, что MDIForm задаёт в коде),
    // иначе текст пункта меню (mi.Text), иначе имя сущности.
    private string? Title => _route?.Caption
        ?? (_menuCode == null ? null : Access.MenuText(_menuCode))
        ?? _entity?.Name;

    private Entity? _entity;

    // Сущность, из которой сейчас показаны данные: у маршрута с EntitySwitch
    // (miStats.Balance) — не та, по которой открыт пункт. Фильтр и «Добавить»
    // остаются за _entity.
    private Entity? _dataEntity;
    private DataTable? _data;
    private readonly Dictionary<string, object> _filterValues =
        new(StringComparer.InvariantCultureIgnoreCase);
    private IReadOnlyList<PassportPage> _filterPages = Array.Empty<PassportPage>();

    // Наборы строк для lookup/objectPicker фильтра — результат
    // Globals.PrepareForFilter(_entity), отдельная процедура от паспортной
    // (EntityId_Load_FilterPage, а не PropertyPage). null, если у сущности
    // нет процедуры фильтра — тогда контролы грузят список сами по entity.
    private DataSet? _filterData;

    private string? _error;
    private JournalAccess _access = JournalAccess.Allowed;
    private bool _canAdd;

    // Сколько строк сейчас затронет кнопка маршрута (JournalRoute.BulkAction);
    // 0 — кнопка неактивна. Считается при каждом чтении списка.
    private int _bulkPending;


    protected override void OnParametersSet()
    {
        if (SecurityManager.LoggedUser == null)
            return;

        // Доступ к экрану проверяется на сервере, а не тем, что пункта нет в меню:
        // адрес /journal/{id} можно набрать руками. Разрешение — то же самое,
        // что гасит пункт меню (UserMenuItems.enabled), см. MenuAccess.
        _access = Access.CheckJournal(EntityId);
        (_menuCode, _route) = ResolveRoute();
        if (_access != JournalAccess.Allowed)
        {
            _entity = null;
            _loadedEntityId = null;
            return;
        }

        // ?menu= приходит отдельным обновлением параметров уже после смены
        // EntityId (query-параметр — каскадное значение), поэтому на одну
        // навигацию между журналами OnParametersSet срабатывает дважды. Данные
        // от пункта меню не зависят — второй проход только уточняет _route, а
        // перечитывать не надо: процедуры статистики тяжёлые (секунды).
        if (_loadedEntityId == EntityId && _loadedFilterDefault == _route?.FilterDefault)
            return;

        try
        {
            _loadedEntityId = null;
            _error = null;
            _entity = EntityManager.GetEntity(EntityId);
            _filterPages = PassportSchema.Parse(_entity.XmlFilter, _entity, pageType: PageTypes.Filter);

            _canAdd = _entity.IsActionEnabled(Constants.EntityActions.AddNew, ViewType.Journal);

            // Своя процедура фильтра (EntityId_Load_FilterPage), не паспортная —
            // грузится только если в фильтре реально есть lookup/objectPicker,
            // которым есть куда её девать: большинство журналов обходятся без
            // неё, и незачем лишний раз идти в базу.
            _filterData = NeedsFilterData(_filterPages) ? Globals.PrepareForFilter(_entity) : null;

            // Значения фильтра по умолчанию берутся из самих метаданных —
            // тем же кодом, что и в десктопе (Globals.ResolveFilterInitialValues).
            _filterValues.Clear();
            Globals.ResolveFilterInitialValues(_filterValues, _entity.XmlFilter);

            // Значение пункта меню сильнее метаданных (в десктопе присваивание идёт
            // следом за ResolveFilterInitialValues). Только здесь, при первой загрузке:
            // «Применить» зовёт Load(), и выбор пользователя не затирается.
            if (_route?.FilterDefault is { } def)
                _filterValues[def.Field] = Globals.ResolveInitialValue(def.Value);

            Load();
            _loadedEntityId = EntityId;
            _loadedFilterDefault = _route?.FilterDefault;
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    private (string? Code, JournalRoute? Route) ResolveRoute()
    {
        // Пункт меню читается из адреса, а не из параметра Menu: при переходе на другую
        // сущность параметр обновляется отдельным проходом позже EntityId, и первый
        // проход увидел бы прежний пункт. Для маршрута с FilterDefault это лишнее
        // чтение тяжёлой процедуры без менеджера.
        string? menu = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("menu", out var m)
            ? m.ToString() : null;

        // Чужой или устаревший ?menu= (не тот пункт для этой сущности) не должен
        // менять правило — в таком случае работает запасной путь по сущности.
        if (menu != null
            && MenuRoutes.SimpleJournal.TryGetValue(menu, out JournalRoute? byMenu)
            && byMenu.EntityId == EntityId)
            return (menu, byMenu);

        // Запасной путь: маршрут по сущности. На одну сущность их может быть несколько
        // (158 — «Объем реализации» и тот же журнал с менеджером по умолчанию), и тогда
        // берётся тот, что НЕ подставляет значений отбора: адрес, набранный руками, не
        // должен молча показывать чужой срез данных. Именно «без FilterDefault», а не
        // «первый попавшийся»: порядок перечисления Dictionary не определён, и полагаться
        // на порядок объявления в MenuRoutes значило бы держать поведение на случайности.
        (string? Code, JournalRoute? Route) fallback = (null, null);
        foreach (var (code, route) in MenuRoutes.SimpleJournal)
        {
            if (route.EntityId != EntityId)
                continue;
            if (route.FilterDefault == null)
                return (code, route);
            if (fallback.Route == null)
                fallback = (code, route);
        }

        return fallback;
    }

    /// <summary>
    /// StatBalanceJournalForm.LoadData: если поле отбора включено, данные берутся
    /// из другой сущности. Разбор значения тот же, что в десктопе.
    /// </summary>
    private Entity DataEntityFor()
    {
        if (_route?.EntitySwitch is { } sw
            && _filterValues.TryGetValue(sw.FilterField, out object? flag)
            && bool.TryParse(flag?.ToString(), out bool on) && on)
            return EntityManager.GetEntity((int)sw.WhenTrue);

        return _entity!;
    }

    private static bool NeedsFilterData(IReadOnlyList<PassportPage> pages)
    {
        foreach (var pg in pages)
            foreach (var f in pg.Fields)
                if (f.Unsupported == null && (f.Lookup != null || f.Picker != null))
                    return true;
        return false;
    }

    private void Load()
    {
        try
        {
            _error = null;
            _dataEntity = DataEntityFor();
            _dataEntity.ClearCache();
            _data = _dataEntity.GetContent(_filterValues);
            _bulkPending = BulkTargets().Count;
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>Строки списка, у которых действие кнопки сейчас доступно.</summary>
    private List<PresentationObject> BulkTargets()
    {
        var result = new List<PresentationObject>();
        if (_route?.BulkAction is not { } bulk || _data == null)
            return result;

        Entity entity = _dataEntity ?? _entity!;
        foreach (DataRow row in _data.Rows)
        {
            PresentationObject obj = entity.CreateObject(row);
            if (Actions.CanExecute(obj, bulk.ActionName, ViewType.Journal))
                result.Add(obj);
        }
        return result;
    }

    /// <summary>
    /// AnnouncementJournalForm.DoMarkReadAll: действие — каждой подходящей
    /// строке, затем список перечитывается. Прогресса и отмены нет: строк единицы.
    /// Если одна из них упала, остальные не пробуются; ошибка показывается, а
    /// список всё равно перечитывается — видно, что уже сделано.
    /// </summary>
    private async Task RunBulkAction()
    {
        string? error = null;
        try
        {
            string actionName = _route!.BulkAction!.ActionName;
            foreach (PresentationObject obj in BulkTargets())
                await Actions.ExecuteAsync(obj, actionName, ViewType.Journal);
        }
        catch (Exception ex)
        {
            error = ErrorPresenter.Describe(ex);
        }

        Load();
        if (error != null)
            _error = error;
    }

    private async Task AddNew()
    {
        try
        {
            await EditObject(_entity!.NewObject, isNew: true);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// Показывает карточку и, если объект сохранён, обновляет список.
    /// Сам показ и цикл сохранения — в PassportDialog: та же карточка
    /// открывается ещё и кнопкой «Создать» у objectPicker.
    /// </summary>
    private async Task EditObject(PresentationObject obj, bool isNew)
    {
        if (await Passports.ShowAsync(obj, isNew))
            Load();
    }

    private ObjectList? _list;

    private Task ExportExcel() => _list?.ExportToExcelAsync(Title) ?? Task.CompletedTask;

    /// <summary>Ошибка операции над строкой: показываем там же, где свои.</summary>
    private void ShowError(string message) => _error = message;

}
