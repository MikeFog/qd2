@page "/document-templates"
@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using Merlin.Classes
@using Merlin.Classes.Documents
@using Merlin.Classes.GridExport
@inject MenuAccess Access
@inject BusyService Busy
@inject DialogService Dialogs
@inject FileSaver Saver

@*
    «Шаблоны документов» (docs/tasks/web-reports.md §6.0, §8 этап 6) — в вебе вместо журнала
    «Текст отчётов»: у каждого агентства свой Word-шаблон на каждый вид документа, с версиями
    «действует с». Скачать, поправить в Word, загрузить новую версию (проверка по каталогу
    полей), примерить на акции. Пока шаблон вида не загружен, печатается начальный — из
    «Текста отчётов», как в qd2 (StartingTemplates.ForPrint).
*@

<PageTitle>@_title</PageTitle>

@if (SecurityManager.LoggedUser == null)
{
    <div class="state">
        <div class="state-title">@Tr.T("Вы не вошли в систему")</div>
        <a href="/">@Tr.T("Перейти к входу")</a>
    </div>
}
else if (_access != JournalAccess.Allowed)
{
    <div class="state">
        <div class="state-title">@Tr.T("Доступ закрыт")</div>
        @Tr.T("Этот экран вам не разрешён. Права на экраны выдаются вместе с пунктами меню — обратитесь к администратору системы.")
    </div>
}
else
{
    <div class="document-templates">
        <ScreenToolbar Title="@_title" />

        <div class="agency">
            <label for="agency">@Tr.T("Агентство")</label>
            <select id="agency" class="form-select form-select-sm" value="@_agencyId" @onchange="ChangeAgency">
                @foreach (KeyValuePair<int, string> agency in _agencies)
                {
                    <option value="@agency.Key">@agency.Value</option>
                }
            </select>
        </div>

        <p class="hint">
            @Tr.T("Документ печатается по шаблону, который действует на дату документа. Пока шаблон вида не загружен, печатается начальный — из «Текста отчётов», тем же текстом, что в qd2.")
        </p>

        @if (_error != null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        @foreach (DocumentKind kind in Kinds)
        {
            List<DocumentTemplateVersion> versions = _versions.Where(v => v.Kind == kind).ToList();
            DocumentTemplateVersion? current = versions.FirstOrDefault(v => v.IsCurrent);
            <section class="kind">
                <div class="kind-head">
                    <h6>@ClientDocuments.KindName(kind)</h6>
                    <span class="state-line">
                        @if (current != null)
                        {
                            @Tr.Format("Действует шаблон с {0:d} — «{1}»", current.StartDate, current.FileName)
                        }
                        else if (versions.Count > 0)
                        {
                            @Tr.T("Загруженные версии начнут действовать позже — сейчас печатается начальный шаблон")
                        }
                        else
                        {
                            @Tr.T("Шаблон не загружен — печатается начальный из «Текста отчётов»")
                        }
                    </span>
                    <span class="actions">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => DownloadCurrent(kind, current)">
                            <i class="bi bi-download"></i> @Tr.T("Скачать")
                        </button>
                        <button class="btn btn-primary btn-sm" @onclick="() => Upload(kind)">
                            <i class="bi bi-upload"></i> @Tr.T("Загрузить новую версию…")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => TryOn(kind, current)">
                            <i class="bi bi-eye"></i> @Tr.T("Примерить на акции…")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ShowFields(kind)">
                            <i class="bi bi-braces"></i> @Tr.T("Поля")
                        </button>
                    </span>
                </div>

                @if (versions.Count > 0)
                {
                    <table class="table table-sm versions">
                        <thead>
                            <tr>
                                <th>@Tr.T("Действует с")</th>
                                <th>@Tr.T("Файл")</th>
                                <th>@Tr.T("Комментарий")</th>
                                <th>@Tr.T("Загрузил")</th>
                                <th>@Tr.T("Когда")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DocumentTemplateVersion version in versions)
                            {
                                <tr class="@(version.IsCurrent ? "current" : null)">
                                    <td>
                                        @version.StartDate.ToString("d")
                                        @if (version.IsCurrent)
                                        {
                                            <span class="badge text-bg-success">@Tr.T("действует")</span>
                                        }
                                    </td>
                                    <td>@version.FileName</td>
                                    <td>@version.Comment</td>
                                    <td>@version.CreatedByName</td>
                                    <td>@version.CreateDate.ToString("g")</td>
                                    <td class="row-actions">
                                        <button class="btn btn-link btn-sm" title="@(Tr.T("Скачать"))" @onclick="() => DownloadVersion(version)">
                                            <i class="bi bi-download"></i>
                                        </button>
                                        <button class="btn btn-link btn-sm text-danger" title="@(Tr.T("Удалить версию"))" @onclick="() => Delete(version)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    </div>
}

@code {
    private static readonly DocumentKind[] Kinds =
    {
        DocumentKind.Contract, DocumentKind.SponsorContract, DocumentKind.BillContract,
        DocumentKind.Bill, DocumentKind.OnAirInquire
    };

    private JournalAccess _access;
    private bool _initialized;
    private string _title = Tr.T("Шаблоны документов");
    private string? _error;
    private List<KeyValuePair<int, string>> _agencies = new();
    private int _agencyId;
    private List<DocumentTemplateVersion> _versions = new();

    protected override async Task OnInitializedAsync()
    {
        if (SecurityManager.LoggedUser == null)
            return;

        _access = Access.CheckScreen(ScreenRoutes.DocumentTemplates);
        if (_access != JournalAccess.Allowed || _initialized)
            return;

        _initialized = true;
        await Busy.RunAsync(() => Try(() =>
        {
            DataTable agencies = Agency.LoadAgencies(true).Tables[Constants.TableNames.Data];
            _agencies = agencies.Rows.Cast<DataRow>()
                .Select(r => new KeyValuePair<int, string>(Convert.ToInt32(r[Agency.ParamNames.AgencyId]), r["name"].ToString()!))
                .OrderBy(a => a.Value)
                .ToList();
            _agencyId = _agencies.FirstOrDefault().Key;
            LoadVersions();
        }));
    }

    private string AgencyName => _agencies.FirstOrDefault(a => a.Key == _agencyId).Value ?? "";

    private void LoadVersions() =>
        _versions = _agencyId == 0 ? new List<DocumentTemplateVersion>() : DocumentTemplateStore.List(_agencyId);

    private async Task ChangeAgency(ChangeEventArgs e)
    {
        _agencyId = int.TryParse(e.Value?.ToString(), out int id) ? id : 0;
        await Busy.RunAsync(() => Try(LoadVersions));
    }

    private void Try(System.Action work)
    {
        try
        {
            _error = null;
            work();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>Файл, по которому сейчас печатается вид: загруженный или начальный.</summary>
    private async Task DownloadCurrent(DocumentKind kind, DocumentTemplateVersion? current)
    {
        if (current != null)
        {
            await DownloadVersion(current);
            return;
        }
        byte[]? content = null;
        await Busy.RunAsync(() => Try(() => content = StartingTemplates.Build(kind, StartingTemplates.LoadReportParts())));
        if (content != null)
            await Save(new ExportFile { Name = StartingTemplates.FileName(kind), Content = content });
    }

    private async Task DownloadVersion(DocumentTemplateVersion version)
    {
        DocumentTemplateFile? file = null;
        await Busy.RunAsync(() => Try(() => file = DocumentTemplateStore.Load(version.Id)));
        if (file != null)
            await Save(new ExportFile { Name = file.FileName, Content = file.Content });
    }

    private async Task Save(ExportFile file)
    {
        if (await Saver.UnsupportedReasonAsync() is { } unsupported)
        {
            _error = unsupported;
            return;
        }
        await Saver.SaveAsAsync(file, async () =>
            await Dialogs.ShowAsync(Tr.T("Файл готов"), b => b.AddContent(0, Tr.T("Выберите, куда сохранить файл.")),
                okText: Tr.T("Сохранить…")) == DialogOutcome.Ok);
    }

    private async Task Upload(DocumentKind kind)
    {
        var model = new DocumentTemplateUploadForm.Model
        {
            Kind = kind,
            Preview = (content, actionId) => Preview(kind, content, actionId),
        };
        string caption = Tr.Format("{0}: новая версия шаблона — {1}", ClientDocuments.KindName(kind), AgencyName);
        while (true)
        {
            DialogOutcome outcome = await Dialogs.ShowAsync(caption, builder =>
            {
                builder.OpenComponent<DocumentTemplateUploadForm>(0);
                builder.AddComponentParameter(1, nameof(DocumentTemplateUploadForm.Value), model);
                builder.CloseComponent();
            }, okText: Tr.T("Загрузить"));
            if (outcome != DialogOutcome.Ok)
                return;

            model.Message = model.Content == null
                ? Tr.T("Выберите файл шаблона.")
                : model.Errors.Count > 0
                    ? Tr.T("Шаблон с ошибками не загружается — исправьте его в Word и выберите файл заново.")
                    : null;
            if (model.Message == null)
                break;
        }

        await Busy.RunAsync(() => Try(() =>
        {
            DocumentTemplateStore.Add(_agencyId, kind, model.StartDate, model.Content!, model.FileName, model.Comment);
            LoadVersions();
        }));
    }

    /// <summary>Примерка того, что сейчас печатается (загруженного или начального шаблона).</summary>
    private async Task TryOn(DocumentKind kind, DocumentTemplateVersion? current)
    {
        var model = new ActionNumberModel();
        DialogOutcome outcome = await Dialogs.ShowAsync(Tr.T("Примерить на акции"), builder =>
        {
            builder.OpenElement(0, "label");
            builder.AddAttribute(1, "class", "form-label");
            builder.AddContent(2, Tr.T("Номер акции"));
            builder.CloseElement();
            builder.OpenElement(3, "input");
            builder.AddAttribute(4, "type", "number");
            builder.AddAttribute(5, "class", "form-control");
            builder.AddAttribute(6, "onchange", EventCallback.Factory.CreateBinder(this, v => model.ActionId = v, model.ActionId));
            builder.CloseElement();
        }, okText: Tr.T("Показать"));
        if (outcome != DialogOutcome.Ok || model.ActionId is not int actionId)
            return;

        byte[]? template = null;
        await Busy.RunAsync(() => Try(() => template = current != null
            ? DocumentTemplateStore.Load(current.Id)?.Content
            : StartingTemplates.Build(kind, StartingTemplates.LoadReportParts())));
        if (template != null)
            await Preview(kind, template, actionId);
    }

    private sealed class ActionNumberModel
    {
        public int? ActionId { get; set; }
    }

    private async Task Preview(DocumentKind kind, byte[] template, int actionId)
    {
        byte[]? result = null;
        string? problem = null;
        await Busy.RunAsync(() =>
        {
            try
            {
                Agency agency = ClientDocuments.AgencyById(_agencyId);
                DocumentData? data = ClientDocuments.Sample(kind, actionId, agency, out problem);
                if (data != null)
                    result = DocxTemplate.Render(template, data);
            }
            catch (DocumentTemplateException ex)
            {
                problem = ex.Message;
            }
            catch (Exception ex)
            {
                problem = ErrorPresenter.Describe(ex);
            }
        });
        string caption = Tr.Format("{0}: примерка на акции №{1}", ClientDocuments.KindName(kind), actionId);
        if (problem != null || result == null)
        {
            await Dialogs.ShowAsync(caption, b => b.AddContent(0, problem ?? Tr.T("Документ не построен.")), okText: Tr.T("Ок"));
            return;
        }
        await Dialogs.ShowAsync(caption, builder =>
        {
            builder.OpenComponent<DocxPreview>(0);
            builder.AddComponentParameter(1, nameof(DocxPreview.Content), result);
            builder.CloseComponent();
        }, cancelText: Tr.T("Закрыть"), showOk: false, wide: true);
    }

    private Task ShowFields(DocumentKind kind) =>
        Dialogs.ShowAsync(Tr.Format("Поля шаблона: {0}", ClientDocuments.KindName(kind)), builder =>
        {
            builder.OpenComponent<DocumentFieldsList>(0);
            builder.AddComponentParameter(1, nameof(DocumentFieldsList.Kind), kind);
            builder.CloseComponent();
        }, cancelText: Tr.T("Закрыть"), showOk: false, wide: true);

    private async Task Delete(DocumentTemplateVersion version)
    {
        DialogOutcome outcome = await Dialogs.ShowAsync(Tr.T("Удалить версию"), b => b.AddContent(0,
            Tr.Format("Удалить версию «{0}», действующую с {1:d}? Файл будет удалён без возможности восстановления.",
                version.FileName, version.StartDate)), okText: Tr.T("Удалить"));
        if (outcome != DialogOutcome.Ok)
            return;
        await Busy.RunAsync(() => Try(() =>
        {
            DocumentTemplateStore.Delete(version.Id);
            LoadVersions();
        }));
    }
}
