@page "/traffic"
@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using Merlin.Classes
@inject MenuAccess Access
@inject BusyService Busy
@inject ObjectActions Actions
@inject ActionMenuService Menu
@inject DialogService Dialogs
@inject TableDialog Tables

@*
    Трафик-менеджмент — веб-экран вместо TrafficManagementForm + TrafficGrid. Не копия формы:
    решения владельца 2026-09-23 — docs/tasks/web-tariffgrid.md, §9 «Трафик-менеджмент».

    Слева станции (фильтр по группе, «обработано по»), в центре неделя окон станции
    (WindowWeekGrid в режиме трафика: остаток времени, переполнение, закрытые дни, склейка),
    справа — выбранное окно и его выпуски (в десктопе — нижняя таблица формы).
*@

<PageTitle>@_title</PageTitle>

@if (SecurityManager.LoggedUser == null)
{
    <div class="state">
        <div class="state-title">Вы не вошли в систему</div>
        <a href="/">Перейти к входу</a>
    </div>
}
else if (_access != JournalAccess.Allowed)
{
    <div class="state">
        <div class="state-title">Доступ закрыт</div>
        Этот экран вам не разрешён. Права на экраны выдаются вместе с пунктами меню —
        обратитесь к администратору системы.
    </div>
}
else
{
    <div class="traffic">
        <ScreenToolbar Title="@_title">
            <button class="btn btn-sm btn-outline-secondary" @onclick="MassClose">
                <i class="bi bi-lock" aria-hidden="true"></i>Отметить дни обработанными…
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAll">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Обновить
            </button>
        </ScreenToolbar>

        @if (_error != null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div class="traffic-body @(_selected != null ? "with-panel" : null)">
            <aside class="stations">
                <select class="form-select form-select-sm" aria-label="Группа станций" @onchange="ChangeGroup">
                    @if (_groups != null)
                    {
                        foreach (DataRowView g in _groups)
                        {
                            int id = Convert.ToInt32(g[0]);
                            <option value="@id" selected="@(id == _groupId)">@g[1]</option>
                        }
                    }
                </select>
                <ul class="station-list">
                    @if (_stations != null)
                    {
                        foreach (DataRow s in _stations.Rows)
                        {
                            int id = Convert.ToInt32(s[Massmedia.ParamNames.MassmediaId]);
                            DateTime? closed = s[Massmedia.ParamNames.DeadLine] is DateTime d ? d : null;
                            <li>
                                <button type="button" class="station @(id == _stationId ? "active" : null)"
                                        @onclick="() => SelectStation(id, s[Massmedia.ParamNames.Name].ToString()!)">
                                    <span class="station-name">@s[Massmedia.ParamNames.Name]</span>
                                    <span class="station-meta">
                                        @s[Massmedia.ParamNames.GroupName]
                                        @if (closed != null)
                                        {
                                            <span class="closed-through" title="День обработан по этой дате">
                                                <i class="bi bi-lock-fill" aria-hidden="true"></i>@closed.Value.ToString("dd.MM.yyyy")
                                            </span>
                                        }
                                    </span>
                                </button>
                            </li>
                        }
                    }
                </ul>
            </aside>

            <section class="traffic-week">
                @if (_stationId == null)
                {
                    <div class="state">
                        <div class="state-title">Выберите станцию</div>
                        Слева — станции выбранной группы; у закрытых — дата, по которую день обработан.
                    </div>
                }
                else
                {
                    @* Esc снимает выделение: клавиши ловит обёртка сетки, фокус на неё ставит клик. *@
                    <div class="grid-box" tabindex="-1" @ref="_gridBox" @onkeydown="GridKey">
                        <WindowWeekGrid Week="_week" Date="_date" SelectedIds="SelectedIds" DayHeader="DayLockButton"
                                        MenuRow="_menuRow"
                                        OnPrevious="PreviousWeek" OnNext="NextWeek" OnJump="JumpTo"
                                        OnCellClick="ClickCell"
                                        OnCellDoubleClick="e => OpenPassport(e.Cell)"
                                        OnCellContextMenu="e => OpenCellMenu(e.Cell, e.Mouse)"
                                        OnRowMenu="e => OpenRowMenu(e.Row, e.Mouse)">
                            <Toolbar>
                                @if (_selection.Count > 0)
                                {
                                    <span class="selection-bar">
                                        <span class="selection-count">Выделено окон: @_selection.Count</span>
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => ChangeWindows(null)">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i>Изменить окна…
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Снять выделение (Esc)"
                                                @onclick="ClearSelection">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </span>
                                }
                            </Toolbar>
                        </WindowWeekGrid>
                    </div>
                }
            </section>

            @if (_selected != null)
            {
                <aside class="window-panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title tabular">Окно @_selected.WindowDate.ToString("dd.MM.yyyy HH:mm")</div>
                            <div class="panel-sub">@_selected.Text@WindowWeekGrid.StatusText(_selected)</div>
                            @if (_selected.IsModified)
                            {
                                <div class="panel-deviations">Не как в тарифе: @string.Join("; ", _selected.Deviations)</div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Карточка окна"
                                @onclick="() => OpenPassport(_selected)">
                            <i class="bi bi-card-text" aria-hidden="true"></i>Карточка
                        </button>
                    </div>
                    <div class="panel-issues">
                        <ObjectList Entity="_issueEntity" Data="_issues" ReadOnly="true"
                                    EmptyText="В окне нет выпусков." />
                    </div>
                </aside>
            }
        </div>
    </div>
}

@code {
    private string _title = "Трафик-менеджмент";
    private string? _stationName;
    private JournalAccess _access = JournalAccess.Allowed;
    private string? _error;

    private DataView? _groups;
    private int _groupId;
    private DataTable? _stations;

    private int? _stationId;
    private DateTime _date = DateTime.Today;
    private TariffWindowWeek? _week;
    private TariffWindowCell? _selected;
    private DataTable? _issues;
    private Entity? _issueEntityCache;

    private Entity _issueEntity => _issueEntityCache ??= TariffWindowWeek.TrafficIssueEntity();

    // Выделение окон (Shift/Ctrl-клик) — для «Изменить окна…»; _selected — окно в правой панели
    // (последнее кликнутое).
    private readonly WindowSelection _selection = new();
    private TariffWindowRow? _menuRow;
    private ElementReference _gridBox;

    private IReadOnlyCollection<int> SelectedIds => _selection.Ids;

    protected override async Task OnInitializedAsync()
    {
        if (SecurityManager.LoggedUser == null)
            return;

        _access = Access.CheckScreen(ScreenRoutes.TrafficManagement);
        if (_access != JournalAccess.Allowed)
            return;

        _title = Access.MenuText(ScreenRoutes.TrafficManagement) ?? _title;
        await Busy.RunAsync(() => Try(() =>
        {
            _groups = TrafficManagement.Groups();
            _stations = TrafficManagement.Stations(_groupId);
        }));
    }

    private void Try(System.Action work)
    {
        try
        {
            _error = null;
            work();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    // ---------- Станции ----------

    private Task ChangeGroup(ChangeEventArgs e)
    {
        _groupId = int.TryParse(e.Value?.ToString(), out int id) ? id : 0;
        return Busy.RunAsync(() => Try(() => _stations = TrafficManagement.Stations(_groupId)));
    }

    private Task SelectStation(int id, string name)
    {
        if (_stationId == id)
            return Task.CompletedTask;
        _stationId = id;
        _stationName = name;
        _week = null;
        _selected = null;
        _issues = null;
        _selection.Clear();
        return LoadWeek();
    }

    private Task RefreshAll() => Busy.RunAsync(() => Try(() =>
    {
        _stations = TrafficManagement.Stations(_groupId);
        if (_stationId != null)
            ReloadWeek();
    }));

    // ---------- Неделя ----------

    private Task LoadWeek() => Busy.RunAsync(() => Try(ReloadWeek));

    private void ReloadWeek()
    {
        _week = TariffWindowWeek.LoadForTraffic(_stationId!.Value, _date);
        _selection.Retain(_week);
        // Ячейки после чтения — новые объекты: выбранное окно ищем по номеру.
        _selected = _selected == null ? null : FindCell(_selected.WindowId);
        _issues = _selected == null ? null : TariffWindowWeek.LoadIssues(_selected);
    }

    private Task PreviousWeek()
    {
        _selection.Clear();
        _date = _week!.StartDate.AddDays(-1);
        return LoadWeek();
    }

    private Task NextWeek()
    {
        _selection.Clear();
        _date = _week!.FinishDate.AddDays(1);
        return LoadWeek();
    }

    private Task JumpTo(DateTime date)
    {
        _selection.Clear();
        _date = date;
        return LoadWeek();
    }

    private TariffWindowCell? FindCell(int windowId)
    {
        foreach (TariffWindowRow row in _week!.Rows)
            foreach (TariffWindowCell? cell in row.Cells)
                if (cell != null && cell.WindowId == windowId)
                    return cell;
        return null;
    }

    // ---------- «День обработан» ----------

    /// <summary>
    /// Кнопка-замок в заголовке дня: у открытого дня — отметить станцию обработанной по этот
    /// день, у закрытого — снять отметку с этого дня (обработано по предыдущий).
    /// </summary>
    private RenderFragment<DateTime> DayLockButton => day =>
    @<button type="button" class="day-lock @(IsClosed(day) ? "is-closed" : null)"
             title="@(IsClosed(day) ? $"Снять отметку «обработан» с {day:dd.MM}" : $"Отметить обработанным по {day:dd.MM}")"
             @onclick="() => ToggleDay(day)" @onclick:stopPropagation="true">
        <i class="bi @(IsClosed(day) ? "bi-unlock" : "bi-lock")" aria-hidden="true"></i>
    </button>;

    private bool IsClosed(DateTime day) => _week?.ClosedThrough is { } through && day.Date <= through.Date;

    private async Task ToggleDay(DateTime day)
    {
        if (_stationId == null)
            return;

        bool reopen = IsClosed(day);
        DateTime newDate = reopen ? day.AddDays(-1) : day;
        string text = reopen
            ? $"Снять отметку «обработан» со станции «{_stationName}» начиная с {day:dd.MM.yyyy}? Станция будет обработана по {newDate:dd.MM.yyyy}."
            : $"Отметить станцию «{_stationName}» обработанной по {day:dd.MM.yyyy} включительно? Выпуски этих дней сможет менять только трафик-менеджер и администратор.";

        if (await Dialogs.ShowAsync(reopen ? "Снять отметку" : "День обработан", b => b.AddContent(0, text),
                okText: reopen ? "Снять отметку" : "Отметить") != DialogOutcome.Ok)
            return;

        int id = _stationId.Value;
        await Busy.RunAsync(() => Try(() =>
        {
            TrafficManagement.SetClosedThrough(id, newDate);
            _stations = TrafficManagement.Stations(_groupId);
            ReloadWeek();
        }));
    }

    /// <summary>
    /// «Отметить дни обработанными…» — несколько станций сразу (десктопный RadiostationsSelector):
    /// станции галочками и дата. По станциям по очереди; отказы — списком, остальные отмечаются.
    /// </summary>
    private async Task MassClose()
    {
        DataTable all = await Busy.RunAsync(() => TrafficManagement.Stations(0));
        var model = new MassCloseForm.Model { Stations = all };
        if (_stationId != null)
            model.Selected.Add(_stationId.Value);

        while (true)
        {
            if (await Dialogs.ShowAsync("Отметить дни обработанными", b =>
                {
                    b.OpenComponent<MassCloseForm>(0);
                    b.AddComponentParameter(1, nameof(MassCloseForm.Value), model);
                    b.CloseComponent();
                }, okText: "Отметить") != DialogOutcome.Ok)
                return;

            model.Message = model.Selected.Count == 0 ? "Отметьте хотя бы одну станцию." : null;
            if (model.Message == null)
                break;
        }

        var errors = new DataTable();
        errors.Columns.Add("name", typeof(string));
        errors.Columns.Add("description", typeof(string));
        await Busy.RunAsync(() =>
        {
            foreach (int id in model.Selected)
            {
                try
                {
                    TrafficManagement.SetClosedThrough(id, model.Date);
                }
                catch (Exception ex)
                {
                    DataRow row = all.Rows.Cast<DataRow>().First(r => Convert.ToInt32(r[Massmedia.ParamNames.MassmediaId]) == id);
                    errors.Rows.Add(row[Massmedia.ParamNames.Name] + " " + row[Massmedia.ParamNames.GroupName], ErrorPresenter.Describe(ex));
                }
            }
            Try(() =>
            {
                _stations = TrafficManagement.Stations(_groupId);
                if (_stationId != null)
                    ReloadWeek();
            });
        });

        if (errors.Rows.Count > 0)
            await Tables.ShowAsync($"Не отмечено станций: {errors.Rows.Count}", errors,
                new Entity.Attribute("name", "Станция", "nvarchar"),
                new Entity.Attribute("description", "Причина", "nvarchar"));
    }

    // ---------- Окно ----------

    /// <summary>Выбор окна — панель справа с его выпусками (WindowIssuesRetrieve).</summary>
    private Task SelectCell(TariffWindowCell cell)
    {
        _selected = cell;
        return Busy.RunAsync(() => Try(() => _issues = TariffWindowWeek.LoadIssues(cell)));
    }

    /// <summary>Клик по окну: выделение (Shift — прямоугольник, Ctrl/⌘ — добавить/убрать) и панель окна.</summary>
    private async Task ClickCell(WindowWeekGrid.CellEvent e)
    {
        _selection.Click(_week!, e.Cell, e.Mouse.ShiftKey, e.Mouse.CtrlKey || e.Mouse.MetaKey);
        await SelectCell(e.Cell);
        await _gridBox.FocusAsync(preventScroll: true);
    }

    private void GridKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _selection.Clear();
    }

    private void ClearSelection() => _selection.Clear();

    // ---------- «Изменить окна…» ----------

    private const string ChangeWindowsAction = "__changeWindows";
    private const string SelectRowAction = "__selectRow";

    /// <summary>
    /// «⋯» у времени строки: выделить строку недели или сразу «Изменить окна этого времени…»
    /// (режим «повторить на период»: неделя, все дни — как десктопные формы у колонки времени).
    /// </summary>
    private async Task OpenRowMenu(TariffWindowRow row, MouseEventArgs e)
    {
        _menuRow = row;
        var items = new[]
        {
            new ActionMenuItem { Name = SelectRowAction, Text = "Выделить строку", Icon = "bi-distribute-horizontal", Enabled = true, Ported = true },
            new ActionMenuItem { Name = ChangeWindowsAction, Text = $"Изменить окна {row.Time}…", Icon = "bi-pencil-square", Enabled = true, Ported = true },
        };
        string? picked = await Menu.ShowAsync(items, e.ClientX, e.ClientY, fromButton: true);
        _menuRow = null;
        StateHasChanged();

        if (picked == SelectRowAction)
            _selection.SelectRow(_week!, row);
        else if (picked == ChangeWindowsAction)
        {
            _selection.SelectRow(_week!, row);
            await ChangeWindows(periodMode: true);
        }
    }

    /// <summary>
    /// «Изменить окна…» по выделению. <paramref name="periodMode"/>: null — «только выделенные»;
    /// true — «повторить на период» (от «⋯» строки). Окна, которые изменятся, пересчитываются
    /// при смене режима, периода и дней; правка — в ядре одной транзакцией.
    /// </summary>
    private async Task ChangeWindows(bool? periodMode)
    {
        if (_week == null || _selection.Count == 0)
            return;

        IReadOnlyList<TariffWindowCell> cells = _selection.Selected(_week);
        TariffWindowWeek week = _week;
        var model = new ChangeWindowsForm.Model
        {
            Times = cells.Select(c => c.OriginalTime).Distinct().OrderBy(t => t).ToList(),
            SelectedCount = cells.Count,
            PeriodMode = periodMode == true,
            Start = cells.Min(c => c.OriginalDay),
            Finish = cells.Max(c => c.OriginalDay),
        };
        foreach (TariffWindowCell c in cells)
            model.Days[((int)c.OriginalDay.DayOfWeek + 6) % 7] = true;
        if (periodMode == true)
        {
            model.Start = week.StartDate;
            model.Finish = week.FinishDate;
            for (int d = 0; d < 7; d++)
                model.Days[d] = true;
        }

        void Recount()
        {
            model.Message = null;
            if (!model.PeriodMode)
            {
                model.Target = TrafficManagement.ForCells(week, cells);
                return;
            }
            model.Message = TrafficManagement.ValidatePeriod(week, model.Start, model.Finish, model.Days);
            model.Target = model.Message == null
                ? TrafficManagement.ForPeriod(week, model.Times, model.Start, model.Finish, model.Days)
                : null;
        }

        await Busy.RunAsync(Recount);
        EventCallback scopeChanged = EventCallback.Factory.Create(this, async () =>
        {
            await Busy.RunAsync(() =>
            {
                try { Recount(); }
                catch (Exception ex) { model.Message = ErrorPresenter.Describe(ex); }
            });
            await Dialogs.RefreshAsync();
        });

        while (true)
        {
            if (await Dialogs.ShowAsync("Изменить окна", b =>
                {
                    b.OpenComponent<ChangeWindowsForm>(0);
                    b.AddComponentParameter(1, nameof(ChangeWindowsForm.Value), model);
                    b.AddComponentParameter(2, nameof(ChangeWindowsForm.ScopeChanged), scopeChanged);
                    b.CloseComponent();
                }, okText: "Изменить") != DialogOutcome.Ok)
                return;

            model.Message = ParseChange(model, out WindowChange change);
            if (model.Message == null && model.Target == null)
                model.Message = "Уточните период и дни недели.";
            if (model.Message == null)
                model.Message = TrafficManagement.Validate(model.Target!, change);
            if (model.Message != null)
                continue;

            try
            {
                await Busy.RunAsync(() => TrafficManagement.Apply(model.Target!, change));
                break;
            }
            catch (Exception ex)
            {
                model.Message = ErrorPresenter.Describe(ex);
            }
        }

        await Busy.RunAsync(() => Try(ReloadWeek));
    }

    /// <summary>Поля диалога → правка; текст ошибки ввода или null.</summary>
    private static string? ParseChange(ChangeWindowsForm.Model model, out WindowChange change)
    {
        change = new WindowChange();

        if (!string.IsNullOrWhiteSpace(model.NewTime))
        {
            if (!TimeSpan.TryParse(model.NewTime, out TimeSpan time))
                return "Время выхода — в виде чч:мм.";
            change.NewTime = new TimeSpan(time.Hours, time.Minutes, 0);
        }

        if (!TryParseDuration(model.NewDuration, out int? duration))
            return "Продолжительность — в виде мм:сс, например 2:56.";
        if (!TryParseDuration(model.NewTotal, out int? total))
            return "Полная продолжительность — в виде мм:сс, например 3:05.";
        change.NewDuration = duration;
        change.NewTotal = total;
        return null;
    }

    /// <summary>«мм:сс» или число секунд; пусто — не менять.</summary>
    private static bool TryParseDuration(string? text, out int? seconds)
    {
        seconds = null;
        if (string.IsNullOrWhiteSpace(text))
            return true;

        string[] parts = text.Trim().Split(':');
        if (parts.Length == 1 && int.TryParse(parts[0], out int only) && only >= 0)
        {
            seconds = only;
            return true;
        }
        if (parts.Length == 2 && int.TryParse(parts[0], out int min) && int.TryParse(parts[1], out int sec)
            && min >= 0 && sec is >= 0 and < 60)
        {
            seconds = min * 60 + sec;
            return true;
        }
        return false;
    }

    private async Task OpenPassport(TariffWindowCell cell)
    {
        await SelectCell(cell);
        await Execute(TariffWindowWeek.CreateWindowObject(cell), Constants.EntityActions.ShowPassport);
    }

    private async Task OpenCellMenu(TariffWindowCell cell, MouseEventArgs e)
    {
        try
        {
            // Правая кнопка по окну вне выделения выделяет его одно — как в таблицах.
            if (!_selection.Ids.Contains(cell.WindowId))
                _selection.Click(_week!, cell, shift: false, ctrl: false);
            await SelectCell(cell);
            PresentationObject window = TariffWindowWeek.CreateWindowObject(cell);
            var items = Actions.BuildMenu(window, ViewType.Tree).ToList();
            items.Add(ActionMenuItem.Separator);
            items.Add(new ActionMenuItem
            {
                Name = ChangeWindowsAction,
                Text = _selection.Count > 1 ? $"Изменить выделенные окна ({_selection.Count})…" : "Изменить окно…",
                Icon = "bi-pencil-square", Enabled = true, Ported = true,
            });
            string? picked = await Menu.ShowAsync(items, e.ClientX, e.ClientY, fromButton: false);
            if (picked == ChangeWindowsAction)
                await ChangeWindows(null);
            else if (picked != null)
                await Execute(window, picked);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    private async Task Execute(PresentationObject window, string actionName)
    {
        try
        {
            ActionEffect? effect = await Actions.ExecuteAsync(window, actionName, ViewType.Journal);
            if (effect is { } done && done != ActionEffect.None)
                await LoadWeek();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }
}
