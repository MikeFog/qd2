@using System.Globalization
@using Merlin.Classes
@using FogSoft.WinForm.Classes

@*
    Сетка размещения «строки × дни» (docs/tasks/web-action-forms.md §3.8, web-tariffgrid.md §3.3):
    рисует модель PlacementWeek — признаки места (PlacementFlags) превращаются в классы ячейки, о
    типах кампаний компонент не знает. Данные, текст ячейки в особых режимах (номера роликов),
    легенда и действия — у владельца.

    Обычная таблица без виртуализации (неделя — до ~80 строк × 7 дней, месяц — до ~37 строк × 31),
    липкие шапка и две левые колонки. Наведение — только CSS. Шапка дня: день недели с датой и число
    выпусков кампании за день. Месяц (PlacementWeek.Period): узкие колонки дня, выходные тоном.
    Заголовочные колонки модели (PlacementWeek.HeaderColumns, у модулей — «Радиостанция», «Модуль»,
    «Тип оплаты») заменяют «Цену» и «Время»; полоса строки (PlacementRow.Band) тонирует их по станциям.

    Всё плотно ради высоты: в дне ~40 окон, сетке нужна вся высота экрана. Инструменты владельца
    стоят в одной строке с неделей (LeadingTools — до неё, TrailingTools — после), подпись режима,
    прайс-лист и легенда — тонкой строкой под ней.
*@

<div class="pgrid @(Brush ? "brush" : null) @(Model is { HasPrices: false } ? "no-price" : null) @(IsMonth ? "month" : null)">
    <div class="pgrid-bar">
        @LeadingTools
        <div class="pgrid-nav">
            <button type="button" class="btn btn-sm btn-outline-secondary" title="@(IsMonth ? Tr.T("Предыдущий месяц") : Tr.T("Предыдущая неделя"))"
                    disabled="@(Model == null)" @onclick="OnPrevious">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
            </button>
            <span class="pgrid-caption tabular">
                @if (Model != null)
                {
                    @WeekCaption(Model)
                }
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" title="@(IsMonth ? Tr.T("Следующий месяц") : Tr.T("Следующая неделя"))"
                    disabled="@(Model == null)" @onclick="OnNext">
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>
            <label class="jump" title="@(Tr.T("Переход к выбранной дате"))">
                <input type="date" class="form-control form-control-sm" value="@Date.ToString("yyyy-MM-dd")"
                       aria-label="@(Tr.T("Переход к выбранной дате"))" @onchange="Jump" />
            </label>
        </div>
        @TrailingTools
    </div>

    <div class="pgrid-info">
        @Caption
        @if (Model is { NoPricelist: false, HasPricelist: true })
        {
            <span class="pricelist tabular">@Tr.Format("Прайс-лист: {0} - {1}", DisplayFormat.Date(Model.PricelistStart), DisplayFormat.Date(Model.PricelistFinish))</span>
        }
        @Legend
    </div>

    @Toolbar

    @if (Model == null)
    {
        <div class="state">@Tr.T("Загрузка…")</div>
    }
    else if (Model.NoPricelist)
    {
        <div class="state">
            <div class="state-title">@(Model.EmptyTitle ?? Tr.T("На эту неделю у станции нет прайс-листа"))</div>
            @(Model.EmptyHint ?? Tr.T("Рекламные окна строятся по прайс-листу — перейдите к другой дате."))
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <div class="state">
            <div class="state-title">@(Model.EmptyTitle ?? Tr.T("На этой неделе рекламных окон нет"))</div>
            @(Model.EmptyHint ?? Tr.T("Окна появляются после генерации по тарифам прайс-листа."))
        </div>
    }
    else
    {
        <div class="data-table pgrid-table">
            <table class="table">
                <thead>
                    <tr>
                        @if (Model.HeaderColumns is { } heads)
                        {
                            for (int h = 0; h < heads.Count; h++)
                            {
                                <th class="@_heads[h].Class" style="@_heads[h].Left"><span class="head-text" style="@_heads[h].Width">@heads[h]</span></th>
                            }
                        }
                        else
                        {
                            @if (Model.HasPrices)
                            {
                                <th class="col-price">@Tr.T("Цена")</th>
                            }
                            <th class="col-time">@Tr.T("Время")</th>
                        }
                        @for (int d = 0; d < Model.DayCount; d++)
                        {
                            int day = d;
                            DateTime date = Model.Day(day);
                            <th class="col-day @(Model.IsInRange(day) ? null : "out") @(Weekend(day) ? "weekend" : null)">
                                <span class="day-head">@DayName(date) <span class="day-date">@DisplayFormat.DayMonth(date)</span></span>
                                @if (Model.DayTotals[day] is { } total)
                                {
                                    <span class="day-count" title="@DayTotalTitle">@total</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (PlacementRow row in Model.Rows)
                    {
                        <tr class="@(row.Band == 1 ? "band" : null)">
                            @if (Model.HeaderColumns != null && row.Headers is { } texts)
                            {
                                for (int h = 0; h < texts.Count; h++)
                                {
                                    <td class="@_heads[h].Class" style="@_heads[h].Left"><span class="head-text" style="@_heads[h].Width" title="@texts[h]">@texts[h]</span></td>
                                }
                            }
                            else
                            {
                                @if (Model.HasPrices)
                                {
                                    <td class="col-price">@row.Price.ToString("C")</td>
                                }
                                <td class="col-time">@row.Time</td>
                            }
                            @for (int d = 0; d < Model.DayCount; d++)
                            {
                                int day = d;
                                PlacementCell? cell = row.Cells[day];
                                if (cell == null)
                                {
                                    <td class="cell empty @(Model.IsInRange(day) ? null : "out") @(Weekend(day) ? "weekend" : null)"></td>
                                }
                                else
                                {
                                    <td class="@CellClass(cell, day)" title="@CellTitle?.Invoke(cell)"
                                        @onclick="ClickHandler(cell)">@(CellText?.Invoke(cell) ?? cell.Text)</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    /// <summary>Неделя; null — загружается.</summary>
    [Parameter] public PlacementWeek? Model { get; set; }

    /// <summary>Дата в поле перехода.</summary>
    [Parameter] public DateTime Date { get; set; }

    /// <summary>Выделенные места (ключи) — рамкой.</summary>
    [Parameter] public IReadOnlyCollection<int>? SelectedKeys { get; set; }

    /// <summary>Какие фоновые признаки показывать (прайм, отмеченные — переключатели вида владельца).</summary>
    [Parameter] public PlacementFlags ShownBackgrounds { get; set; } = PlacementFlags.Disabled;

    /// <summary>Текст ячейки вместо остатка (номера роликов); null из функции — остаток.</summary>
    [Parameter] public Func<PlacementCell, string?>? CellText { get; set; }

    [Parameter] public Func<PlacementCell, string?>? CellTitle { get; set; }

    /// <summary>Дополнительный класс ячейки — режимы владельца (выбор окна-приёмника и т. п.).</summary>
    [Parameter] public Func<PlacementCell, string?>? ExtraCellClass { get; set; }

    /// <summary>Подсказка к числу под датой.</summary>
    [Parameter] public string? DayTotalTitle { get; set; }

    /// <summary>Клик ставит выпуск («Режим добавления») — курсор-кисть над местами.</summary>
    [Parameter] public bool Brush { get; set; }

    /// <summary>Инструменты владельца в строке недели — до навигации.</summary>
    [Parameter] public RenderFragment? LeadingTools { get; set; }

    /// <summary>Инструменты владельца в строке недели — после навигации, у правого края.</summary>
    [Parameter] public RenderFragment? TrailingTools { get; set; }

    /// <summary>Подпись режима — начало тонкой строки под неделей (перед прайс-листом и легендой).</summary>
    [Parameter] public RenderFragment? Caption { get; set; }

    [Parameter] public RenderFragment? Legend { get; set; }

    /// <summary>Полоса между навигацией и сеткой (выделение, режимы).</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }

    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback<DateTime> OnJump { get; set; }
    [Parameter] public EventCallback<CellEvent> OnCellClick { get; set; }

    public sealed record CellEvent(PlacementCell Cell, MouseEventArgs Mouse);

    private bool IsMonth => Model is { Period: PlacementPeriod.Month };

    private static string[] DayNames => DisplayFormat.WeekDaysFromMonday();

    /// <summary>Краткое имя дня по дате колонки: у месяца первая колонка — любой день недели.</summary>
    private static string DayName(DateTime date) => DayNames[((int)date.DayOfWeek + 6) % 7];

    /// <summary>Суббота и воскресенье тоном — только в месяце, как ComboModuleGrid.ShadeWeekends: в неделе все дни на виду.</summary>
    private bool Weekend(int day) =>
        IsMonth && Model!.Day(day).DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    // Обработчик щелчка — один на место, пока модель та же: лямбда в разметке создавалась бы заново
    // на каждую отрисовку, и Blazor переназначал бы обработчик у каждой ячейки (месяц — ~1 150
    // правок на любую перерисовку, например на щелчок выделения). Новая модель — новые места.
    private readonly Dictionary<PlacementCell, Func<MouseEventArgs, Task>> _clickHandlers = new();
    private PlacementWeek? _clickHandlersOf;

    protected override void OnParametersSet()
    {
        // Сброс здесь, а не при отрисовке ячейки: неделя без мест (нет прайс-листа, нет окон) иначе
        // держала бы в памяти места прежней модели.
        if (!ReferenceEquals(_clickHandlersOf, Model))
        {
            _clickHandlers.Clear();
            _clickHandlersOf = Model;
            _heads = MeasureHeads(Model);
        }
    }

    /// <summary>Заголовочная колонка: класс, отступ слева (липкая) и ширина текста.</summary>
    private sealed record HeadColumn(string Class, string Left, string Width);

    private HeadColumn[] _heads = Array.Empty<HeadColumn>();

    /// <summary>
    /// Липкой колонке нужен известный отступ слева, поэтому ширина заголовочной колонки считается заранее —
    /// по самому длинному тексту колонки в модели (шапка — 12 px прописными, строки — 13 px), в пределах
    /// 64–240 px; не поместилось — многоточие и подсказка.
    /// </summary>
    private static HeadColumn[] MeasureHeads(PlacementWeek? model)
    {
        if (model?.HeaderColumns is not { } heads)
            return Array.Empty<HeadColumn>();

        HeadColumn[] result = new HeadColumn[heads.Count];
        int left = 0;
        for (int h = 0; h < heads.Count; h++)
        {
            int longest = 0;
            foreach (PlacementRow row in model.Rows)
                if (row.Headers != null && h < row.Headers.Count)
                    longest = Math.Max(longest, row.Headers[h]?.Length ?? 0);
            int width = (int)Math.Ceiling(Math.Max(heads[h].Length * 8.5, longest * 7.5)) + 2 * 8;
            width = Math.Clamp(width, 64, 240);
            string css = "col-head" + (h == heads.Count - 1 ? " col-head-last" : "");
            result[h] = new HeadColumn(css, FormattableString.Invariant($"left:{left}px"), FormattableString.Invariant($"width:{width}px"));
            left += width;
        }
        return result;
    }

    private Func<MouseEventArgs, Task> ClickHandler(PlacementCell cell)
    {
        if (!_clickHandlers.TryGetValue(cell, out Func<MouseEventArgs, Task>? handler))
            _clickHandlers[cell] = handler = e => OnCellClick.InvokeAsync(new CellEvent(cell, e));
        return handler;
    }

    /// <summary>«05.10 – 11.10.2026»: строка недели узкая; год у начала — только если он другой.</summary>
    private static string WeekCaption(PlacementWeek week) =>
        (week.StartDate.Year == week.FinishDate.Year ? DisplayFormat.DayMonth(week.StartDate) : DisplayFormat.Date(week.StartDate))
        + " – " + DisplayFormat.Date(week.FinishDate);

    private Task Jump(ChangeEventArgs e)
    {
        if (!DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime date))
            return Task.CompletedTask;
        return OnJump.InvokeAsync(date);
    }

    private string CellClass(PlacementCell cell, int day)
    {
        string css = "cell";
        if (Weekend(day)) css += " weekend";
        // Цвет текста: свои выпуски перекрывают выпуски фирмы (как в десктопе).
        if (cell.Has(PlacementFlags.Mine)) css += " mine";
        else if (cell.Has(PlacementFlags.Partial)) css += " partial";
        else if (cell.Has(PlacementFlags.FirmHere)) css += " firm";
        else if (cell.Has(PlacementFlags.FirmSome)) css += " firm-some";
        if (cell.Has(PlacementFlags.Match)) css += " match";
        // Фон — по приоритету десктопа: заблокировано, отмечено, прайм.
        if (Shown(cell, PlacementFlags.Disabled)) css += " bg-disabled";
        else if (Shown(cell, PlacementFlags.Marked)) css += " bg-marked";
        else if (Shown(cell, PlacementFlags.Prime)) css += " bg-prime";
        if (SelectedKeys != null && SelectedKeys.Contains(cell.Key)) css += " selected";
        if (ExtraCellClass?.Invoke(cell) is { } extra) css += " " + extra;
        return css;
    }

    private bool Shown(PlacementCell cell, PlacementFlags flag) => (ShownBackgrounds & flag) == flag && cell.Has(flag);
}
