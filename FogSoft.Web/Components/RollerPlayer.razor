@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@using FogSoft.WinForm.DataAccess
@using Merlin.Classes
@inject IJSRuntime JS
@inject BusyService Busy
@inject RollerPlayback Playback
@implements IAsyncDisposable

@*
    Прослушивание ролика — веб-аналог MediaControl десктопа. Один на приложение: стоит в верхней
    полосе MainLayout и продолжает играть при переходе между экранами; зовут его через
    RollerPlayback (журналы роликов, «Прослушать ролик» в дереве кампании). Название ролика и
    обычный <audio controls>: пауза, перемотка и громкость — у проигрывателя браузера. Файл
    читается сервером по пути из базы и уходит потоком в circuit (wwwroot/js/audio.js),
    отдельного адреса у файла нет. Пока ничего не играли, проигрывателя не видно.
*@

<div class="roller-player @(_name == null ? "d-none" : null)">
    <i class="bi bi-music-note-beamed" aria-hidden="true"></i>
    <span class="roller-player-name" title="@_path">@_name</span>
    <audio @ref="_audio" controls preload="none"></audio>
    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Остановить прослушивание"))"
            aria-label="@(Tr.T("Остановить прослушивание"))" @onclick="StopAsync">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
</div>

@code {
    private ElementReference _audio;
    private IJSObjectReference? _module;
    private string? _name;
    private string? _path;

    protected override void OnInitialized() => Playback.Attach(PlayAsync);

    /// <summary>
    /// Проиграть файл ролика. Нет пути — молча ничего (как MediaControl.Play), нет файла —
    /// то же сообщение RollerFileNotFound, что в десктопе. Возвращает отказ или null.
    /// </summary>
    private async Task<string?> PlayAsync(PresentationObject roller)
    {
        string path = Convert.ToString(roller[Roller.ParamNames.Path]) ?? "";
        if (path.Length == 0)
            return null;

        if (!File.Exists(path))
        {
            MessageAccessor.Parameters = roller.Parameters;
            return MessageAccessor.GetMessage("RollerFileNotFound");
        }

        try
        {
            byte[] content = await Busy.RunAsync(() => File.ReadAllBytes(path));
            _name = roller.Name;
            _path = path;
            await InvokeAsync(StateHasChanged);

            using var stream = new MemoryStream(content);
            using var reference = new DotNetStreamReference(stream);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio.js");
            await _module.InvokeVoidAsync("play", _audio, reference, RollerFiles.ContentType(path));
            return null;
        }
        catch (Exception ex)
        {
            return ErrorPresenter.Describe(ex);
        }
    }

    private async Task StopAsync()
    {
        if (_module != null)
            await _module.InvokeVoidAsync("stop", _audio);
        _name = null;
        _path = null;
    }

    public async ValueTask DisposeAsync()
    {
        Playback.Detach();
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _audio);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
