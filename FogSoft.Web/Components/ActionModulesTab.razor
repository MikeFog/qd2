@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@using Merlin.Classes
@inject BusyService Busy
@inject DialogService Dialogs
@inject TableDialog Tables
@inject ModuleRowsMemory Memory

@*
    Вкладка «Модули» страницы акции (docs/tasks/web-action-forms.md, этап 6): модульные кампании акции
    галочками (при входе отмечены все, «Редактировать» у кампании — только она), под ними «Ролики» (кисть,
    RollerBrush); в центре сетка «модуль × кампания» по дням недели или месяца, как десктопный
    ComboModulePlacementForm с ComboModuleGrid при редактировании готовой акции (режим 2): в ячейке —
    остаток самого заполненного окна модуля за день. Щелчок по ячейке — панель справа: выпуски модуля
    строки за день, окна модуля (у поставленного — окна выхода) и «Все выходы в эфир» окна, как в
    панели окна линейной вкладки. Данные — ModuleDaySource. Раскладка — как у ActionWindowsTab.

    Подэтап 6.2: в «Режиме добавления» щелчок ставит модуль строки на весь день — ролик кисти с позицией
    «Позиционирования», как клик комбо (одна транзакция, один пересчёт акции); после записи период
    перечитывается, страница — шапку (Changed). Запись на «Рекламных окнах» меняет те же окна — скрытая
    вкладка перечитывает период при показе (PlacementVersion). Без права «Редактировать» — просмотр (В-7).

    Подэтап 6.3: «Показать модули» (ModuleRowsForm) добавляет строки — модули комбо-модуля, радиостанции
    или отмеченной кампании; строки помнит сеанс (ModuleRowsMemory, переход со страницы и обратно их не
    теряет). Строке без кампании модульную кампанию создаёт (или находит) первая постановка — кампания
    появляется в списке слева отмеченной, строка остаётся на месте. Вкладка есть и у акции без модульных
    кампаний, если можно добавлять кампании (В-23). Выделение, операции над выпусками и «Отменить» —
    следующие подэтапы.
*@

<div class="modules-tab">
    @if (_error != null)
    {
        <div class="alert alert-danger alert-dismissible tab-error" role="alert">
            @_error
            <button type="button" class="btn-close" aria-label="@(Tr.T("Закрыть"))" @onclick="() => _error = null"></button>
        </div>
    }

    <div class="modules-body @(_details != null ? "with-panel" : null)">
        <aside class="side">
            <section class="side-block">
                <div class="side-title">@Tr.T("Рекламные кампании")</div>
                @if (_rows.Count == 0)
                {
                    <div class="text-muted no-campaigns">@Tr.T("В акции нет модульных рекламных кампаний.")</div>
                }
                <ul class="campaign-list">
                    @foreach (DataRow row in _rows)
                    {
                        int id = WindowsSource.CampaignIdOf(row);
                        bool on = _checked.Contains(id);
                        <li class="@(on ? "on" : null)">
                            <input type="checkbox" class="form-check-input" checked="@on" aria-label="@CaptionOf(row)"
                                   @onchange="e => ToggleCampaign(id, e.Value is true)" />
                            <button type="button" class="campaign" title="@(Tr.T("Показать только эту кампанию"))" @onclick="() => CheckOnly(id)">
                                @CaptionOf(row)
                            </button>
                        </li>
                    }
                </ul>
                @if (_rows.Count > 1)
                {
                    <button type="button" class="btn btn-sm btn-link check-all" disabled="@(_checked.Count == _rows.Count)"
                            title="@(Tr.T("Отметить все модульные кампании акции"))" @onclick="CheckAll">
                        @Tr.T("Отметить все")
                    </button>
                }
                @if (_checked.Count == 1 && RowOf(_checked[0]) is { } oneRow)
                {
                    <dl class="stats">
                        @foreach (KeyValuePair<string, string> stat in WindowsSource.CampaignStats(oneRow))
                        {
                            <div><dt>@stat.Key</dt><dd>@stat.Value</dd></div>
                        }
                    </dl>
                }
            </section>

            @if (_scope != null)
            {
                <RollerBrush Value="_brush" Scope="_scope" NoRightText="@NoRightText" Run="Run" Exclusive="Exclusive"
                             Changed="BrushChanged" RollerEdited="RollerEdited" Failed="ShowError"
                             ReadOnly="ActionWorkspace.IsDeleted(Action)" RollersChanged="() => Changed.InvokeAsync()" />
            }
        </aside>
        <PaneSplitter StorageKey="action-modules" />

        <section class="center">
            @if (!ShowsGrid)
            {
                <div class="state">
                    <div class="state-title">@(_rows.Count > 0 ? Tr.T("Отметьте рекламную кампанию слева") : Tr.T("Модульных рекламных кампаний в акции нет"))</div>
                    @(_rows.Count > 0
                        ? Tr.T("Строки — модули отмеченных кампаний, колонки — дни недели или месяца, в ячейке — остаток самого заполненного окна модуля за день.")
                        : Tr.T("Добавьте строки кнопкой «Показать модули» — модули комбо-модуля или радиостанции: рекламная кампания на радиостанции будет создана при первой постановке модуля."))
                    <div class="state-actions">
                        @ShowModulesButton
                    </div>
                </div>
            }
            else if (_scope == null)
            {
                <div class="state">@Tr.T("Загрузка…")</div>
            }
            else
            {
                @* Тулбар — в строке периода сетки, подпись и легенда — тонкой строкой под ней: сетке нужна вся высота. *@
                <div class="grid-box">
                    <PlacementGrid Model="_week" Date="_date" SelectedKeys="SelectedKeys" CellTitle="CellTitle" Brush="_brushOn"
                                   DayTotalTitle="@(Tr.T("Выпусков модулей за день по отмеченным кампаниям"))"
                                   OnPrevious="Previous" OnNext="Next" OnJump="JumpTo" OnCellClick="ClickCell">
                        <LeadingTools>
                            <button type="button" class="btn btn-sm @(_brushOn ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@_brushOn"
                                    disabled="@(!CanBrush)" title="@BrushHint" @onclick="ToggleBrush">
                                <i class="bi bi-brush" aria-hidden="true"></i>@Tr.T("Режим добавления")
                            </button>
                            @ShowModulesButton
                            <span class="btn-group period-switch" role="group" aria-label="@(Tr.T("Показывать неделю или месяц"))">
                                <button type="button" class="btn btn-sm btn-outline-secondary @(_period == PlacementPeriod.Week ? "active" : null)"
                                        aria-pressed="@(_period == PlacementPeriod.Week)" title="@(Tr.T("Неделя"))" aria-label="@(Tr.T("Неделя"))"
                                        @onclick="() => SetPeriod(PlacementPeriod.Week)">
                                    <i class="bi bi-calendar-week" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary @(_period == PlacementPeriod.Month ? "active" : null)"
                                        aria-pressed="@(_period == PlacementPeriod.Month)" title="@(Tr.T("Месяц"))" aria-label="@(Tr.T("Месяц"))"
                                        @onclick="() => SetPeriod(PlacementPeriod.Month)">
                                    <i class="bi bi-calendar-month" aria-hidden="true"></i>
                                </button>
                            </span>
                            @if (_brush.Row is { } brush)
                            {
                                <span class="brush-roller" title="@(Tr.T("Ролик, который ставится в модули, — выбран в списке «Ролики»"))">
                                    <b class="tabular">@brush[WindowsSource.RollerNumberColumn]</b> @WindowsSource.RollerName(brush) · <span class="tabular">@WindowsSource.RollerDuration(brush)</span>
                                </span>
                            }
                            <PlacementFilterButtons View="_view" @bind-AdvertTypeName="_advertTypeName" Changed="Reload" />
                        </LeadingTools>
                        <TrailingTools>
                            <span class="toggles">
                                <PlacementFilterButtons View="_view" Unconfirmed="true" Changed="Reload" />
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Обновить информацию"))" aria-label="@(Tr.T("Обновить информацию"))"
                                        @onclick="RefreshAll">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                </button>
                            </span>
                        </TrailingTools>
                        <Caption>
                            <span class="mode-caption">@ModeCaption</span>
                            <span class="text-muted">@Tr.T("Щелчок по ячейке — выпуски и окна модуля за день, в «Режиме добавления» — постановка модуля на весь день.")</span>
                        </Caption>
                        <Legend>
                            <span class="legend">
                                <span><i class="sample mine">00:30</i>@Tr.T("выпуски модуля в этот день")</span>
                                @if (_view.Position != 0 || _view.AdvertTypeId != null)
                                {
                                    <span><i class="sample match">00:30</i>@Tr.T("подходит под отбор")</span>
                                }
                                <span><i class="swatch"></i>@Tr.T("модуль в этот день не выходит целиком")</span>
                            </span>
                        </Legend>
                    </PlacementGrid>
                </div>
            }
        </section>

        @if (_details != null)
        {
            <PaneSplitter StorageKey="action-modules-panel" RightPane="true" />
            <aside class="window-panel">
                <div class="panel-head">
                    <div>
                        <div class="panel-title">@_details.Module · <span class="tabular">@DisplayFormat.Date(_details.Date)</span></div>
                        <div class="panel-sub">@_details.Massmedia · @_details.PaymentType</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Закрыть"))" aria-label="@(Tr.T("Закрыть"))" @onclick="ClosePanel">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="panel-section-title">@Tr.T("Выпуски модуля")</div>
                <div class="panel-list">
                    <ObjectList Entity="_issueEntity" Data="_details.Issues" ReadOnly="true"
                                EmptyText="@(Tr.T("В этот день модуль в кампании не стоит."))" />
                </div>

                <div class="panel-section-title">@(_details.ExitWindows ? Tr.T("Окна выхода") : Tr.T("Окна модуля"))</div>
                <div class="panel-list panel-list-wide">
                    <div class="data-table">
                        <table class="table module-windows">
                            <thead>
                                <tr>
                                    <th>@Tr.T("Время выхода")</th>
                                    @if (_details.ExitWindows)
                                    {
                                        <th>@Tr.T("Ролик")</th>
                                        <th>@Tr.T("Порядок")</th>
                                    }
                                    else
                                    {
                                        <th>@Tr.T("Остаток времени")</th>
                                    }
                                    <th class="col-btn"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (ModuleDaySource.ModuleWindow window in _details.Windows)
                                {
                                    bool shown = ReferenceEquals(window, _issuesWindow);
                                    <tr class="@(shown ? "row-active" : null)">
                                        <td class="tabular">
                                            @WindowTime(window)
                                            @if (window.Disabled)
                                            {
                                                <i class="bi bi-lock window-locked" title="@(Tr.T("заблокированное окно"))" aria-label="@(Tr.T("заблокированное окно"))"></i>
                                            }
                                        </td>
                                        @if (_details.ExitWindows)
                                        {
                                            <td>@window.RollerName</td>
                                            <td>@window.Position</td>
                                        }
                                        else
                                        {
                                            <td class="tabular">@window.Text</td>
                                        }
                                        <td class="col-btn">
                                            <button type="button" class="btn btn-sm btn-outline-secondary @(shown ? "active" : null)" aria-pressed="@shown"
                                                    title="@(Tr.T("Все выходы в эфир"))" aria-label="@(Tr.T("Все выходы в эфир"))" @onclick="() => ToggleWindowIssues(window)">
                                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (_issuesWindow != null)
                {
                    <div class="panel-section-title">@Tr.T("Все выходы в эфир") <span class="tabular text-muted">@WindowTime(_issuesWindow)</span></div>
                    <div class="panel-list panel-list-wide">
                        <ObjectList Entity="_allIssueEntity" Data="_windowIssues?.All" ReadOnly="true" EmptyText="@(Tr.T("В окне нет выпусков."))" />
                    </div>
                }
            </aside>
        }
    </div>
</div>

@code {
    /// <summary>Акция страницы.</summary>
    [Parameter, EditorRequired] public ActionOnMassmedia Action { get; set; } = default!;

    /// <summary>Кампании акции (Campaigns) — страница перечитывает их после каждой операции.</summary>
    [Parameter, EditorRequired] public DataTable Campaigns { get; set; } = default!;

    /// <summary>
    /// Можно добавлять модульные кампании в акцию (ModuleDaySource.CanAddModuleCampaigns) — «Показать модули» с источниками
    /// «Комбо-модуль» и «Модули радиостанции»; страница считает его при каждом чтении акции.
    /// </summary>
    [Parameter] public bool CanAddCampaigns { get; set; }

    /// <summary>Отметить только эту кампанию (вход «Редактировать» у кампании); применяется при смене <see cref="RequestVersion"/>.</summary>
    [Parameter] public int? RequestedCampaignId { get; set; }

    [Parameter] public int RequestVersion { get; set; }

    /// <summary>Размещение изменилось — страница перечитывает шапку и кампании.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Вкладка видна (скрытая живёт, но не перечитывает период на каждую запись другой вкладки).</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>
    /// Версия размещения от страницы: растёт с каждой записью на другой вкладке размещения (окна модулей — те же окна, что
    /// у линейных кампаний). Видимая вкладка с отставшей версией перечитывает период; своя запись версию не меняет.
    /// </summary>
    [Parameter] public int PlacementVersion { get; set; }

    private List<DataRow> _rows = new();
    private readonly List<int> _checked = new();
    private int _appliedRequest = -1;
    private bool _initialized;
    private string? _addedKey;
    private Dictionary<int, string>? _captions;
    private int _shownVersion;

    private ModuleDaySource.ModuleScope? _scope;
    private readonly WindowsSource.WeekView _view = new();
    private string? _advertTypeName;

    // Кисть: ролики фирмы и ролик кисти (RollerBrush); позиция — «Позиционирование» отбора (_view.Position), как у окон.
    private readonly RollerBrush.Model _brush = new();
    private bool _brushOn;

    // Неделя или месяц — как переключатель десктопного комбо; помнится, пока жива вкладка (общего хранения
    // настроек в браузере у веба нет).
    private PlacementPeriod _period = PlacementPeriod.Week;
    private DateTime _date = DateTime.Today;
    private bool _dateChosen;
    private PlacementWeek? _week;
    private string? _error;

    // Место в правой панели (выделено рамкой), его выпуски и окна; окно, чьи «Все выходы в эфир» раскрыты.
    private PlacementCell? _cell;
    private ModuleDaySource.ModuleDayDetails? _details;
    private ModuleDaySource.ModuleWindow? _issuesWindow;
    private WindowsSource.WindowIssues? _windowIssues;
    private readonly Entity _issueEntity = ModuleDaySource.IssueEntity();
    private readonly Entity _allIssueEntity = WindowsSource.IssueEntity(full: true);

    private DataRow? RowOf(int campaignId) => _rows.FirstOrDefault(r => WindowsSource.CampaignIdOf(r) == campaignId);

    /// <summary>
    /// Подпись кампании; у двух модульных кампаний одной станции с одним типом оплаты (разные агентства) — с
    /// агентством, как у линейных на «Рекламных окнах».
    /// </summary>
    private string CaptionOf(DataRow row)
    {
        string caption = WindowsSource.CampaignCaption(row);
        bool ambiguous = _rows.Count(r => WindowsSource.CampaignCaption(r) == caption) > 1;
        return ambiguous ? WindowsSource.CampaignCaption(row, withAgency: true) : caption;
    }

    private string ModeCaption =>
        _scope is { CampaignIds.Count: 1 } && RowOf(_scope.CampaignIds[0]) is { } row
            ? Tr.Format("Модули: {0}", CaptionOf(row))
            : _scope is { CampaignIds.Count: 0 } ? Tr.T("Модули: строки без рекламной кампании")
            : Tr.Format("Модули: отмечено кампаний — {0}", _scope?.CampaignIds.Count ?? 0);

    private IReadOnlyCollection<int>? SelectedKeys => _cell == null ? null : new[] { _cell.Key };

    private string NoRightText =>
        _scope is { CampaignIds.Count: 0 } ? Tr.T("Нет права добавлять рекламные кампании в эту акцию.")
        : _scope is { CampaignIds.Count: > 1 } ? Tr.T("Нет права «Редактировать» на одну из отмеченных кампаний.")
        : Tr.T("Нет права «Редактировать» на эту кампанию.");

    // Удалённая акция: права набора считались при открытии, а удалить могли из меню шапки — запись закрыта сразу.
    private bool CanBrush => _scope is { CanEdit: true } && !ActionWorkspace.IsDeleted(Action) && _brush.Row != null;

    private string? BrushHint =>
        ActionWorkspace.IsDeleted(Action) ? Tr.T("Рекламная акция удалена. Обновите страницу.")
        : _scope is not { CanEdit: true } ? NoRightText
        : _brush.Row == null ? Tr.T("Не выбран рекламный ролик.")
        : null;

    // ---------- Кампании ----------

    protected override async Task OnParametersSetAsync()
    {
        _rows = Campaigns.Rows.Cast<DataRow>().Where(ModuleDaySource.IsModular).ToList();

        // Тип оплаты и агентство кампании набор помнит с открытия — сменили на «Кампаниях», открыть заново; фирму акции
        // сменили («Сменить фирму-заказчика» в меню шапки) — ролики кисти другие, тоже заново. Новая кампания (создала
        // постановка в добавленную строку) набор не пересоздаёт: он уже её знает, номера строк остаются.
        Dictionary<int, string> captions = _rows.ToDictionary(WindowsSource.CampaignIdOf, r => WindowsSource.CampaignCaption(r, true));
        bool captionsChanged = (_captions != null && captions.Any(c => _captions.TryGetValue(c.Key, out string? old) && old != c.Value))
            || (_scope != null && _scope.FirmId != Action.FirmID);

        // Удалённые кампании — из отметок долой (страница перечитала список после операции). Кампанию, которой в прежнем
        // списке не было, не трогаем: её только что создала постановка, а страница рисуется ещё со старым списком
        // (перерисовка до перечитывания) — снятая отметка пересоздала бы набор и сбросила номера строк.
        int before = _checked.Count;
        _checked.RemoveAll(id => !captions.ContainsKey(id) && (_captions == null || _captions.ContainsKey(id)));

        // Модульная кампания появилась не постановкой этой вкладки («Добавить рекламные кампании», другой пользователь) и
        // совпадает со строкой «Показать модули» без кампании — отметить, иначе строка молча пропала бы вместе со строками
        // неотмеченной кампании (AddedRows).
        if (_captions != null)
            foreach (DataRow campaign in _rows)
            {
                int id = WindowsSource.CampaignIdOf(campaign);
                if (!_captions.ContainsKey(id) && !_checked.Contains(id)
                    && Memory.Rows(Action.ActionId).Any(r => r.CampaignId == null && IsCampaignOf(campaign, r)))
                    _checked.Add(id);
            }
        _captions = captions;

        // Видимые добавленные строки изменились при закрытом наборе (например, удалили кампанию, снятую с отметки, — её
        // строки снова ожидающие): набор открыть, иначе вкладка осталась бы на «Загрузка…».
        string addedKey = string.Join("|", AddedRows.Select(r => r.Key + ":" + r.CampaignId));
        bool addedChanged = _addedKey != null && addedKey != _addedKey;
        _addedKey = addedKey;

        if (RequestVersion != _appliedRequest)
        {
            _appliedRequest = RequestVersion;
            if (RequestedCampaignId is { } requested && RowOf(requested) != null)
            {
                _checked.Clear();
                _checked.Add(requested);
            }
            else if (!_initialized)
            {
                // Как десктопный комбо при редактировании акции: все модульные кампании сразу.
                _checked.AddRange(_rows.Select(WindowsSource.CampaignIdOf));
            }
            _initialized = true;
            await ApplyChecked();
        }
        else if (_checked.Count != before || captionsChanged || (addedChanged && _scope == null))
        {
            if (captionsChanged)
                _scope = null;
            await ApplyChecked();
        }

        // Размещение или ролики фирмы изменили на другой вкладке — период и ролики заново.
        if (Active && PlacementVersion != _shownVersion)
        {
            _shownVersion = PlacementVersion;
            await RefreshAll();
        }
    }

    private Task ToggleCampaign(int id, bool on)
    {
        if (on && !_checked.Contains(id)) _checked.Add(id);
        if (!on) _checked.Remove(id);
        return ApplyChecked();
    }

    private Task CheckOnly(int id)
    {
        _checked.Clear();
        _checked.Add(id);
        return ApplyChecked();
    }

    private Task CheckAll()
    {
        _checked.Clear();
        _checked.AddRange(_rows.Select(WindowsSource.CampaignIdOf));
        return ApplyChecked();
    }

    private bool IsOpened() =>
        _scope != null && _checked.Count == _scope.CampaignIds.Count && !_checked.Except(_scope.CampaignIds).Any();

    /// <summary>
    /// Строки «Показать модули» этой акции за сеанс, кроме строк неотмеченных кампаний. Строка без номера кампании, чьи
    /// станция, тип оплаты и агентство — как у модульной кампании акции, — строка этой кампании (так её покажет и набор):
    /// снятая отметка прячет её вместе с остальными строками кампании, а после удаления кампании строка снова ожидающая.
    /// </summary>
    private IReadOnlyList<ModuleDaySource.AddedRow> AddedRows =>
        Memory.Rows(Action.ActionId)
            .Where(r => r.CampaignId is int id ? _checked.Contains(id)
                : !_rows.Any(c => !_checked.Contains(WindowsSource.CampaignIdOf(c)) && IsCampaignOf(c, r)))
            .ToList();

    private static bool IsCampaignOf(DataRow campaign, ModuleDaySource.AddedRow row) =>
        ParseHelper.GetInt32FromObject(campaign[ActionWorkspace.CampaignColumns.MassmediaId], 0) == row.MassmediaId
        && ParseHelper.GetInt32FromObject(campaign[PaymentTypeIdColumn], 0) == row.PaymentTypeId
        && ParseHelper.GetInt32FromObject(campaign[AgencyIdColumn], 0) == row.AgencyId;

    private const string PaymentTypeIdColumn = "paymentTypeID";
    private const string AgencyIdColumn = "agencyID";

    /// <summary>Сетка есть, если отмечена кампания или добавлены строки (В-23: у акции без модульных кампаний — только они).</summary>
    private bool ShowsGrid => _checked.Count > 0 || AddedRows.Count > 0;

    /// <summary>
    /// Открыть отмеченные кампании (если ещё не открыты) и прочитать период; ничего не отмечено и строк не добавляли —
    /// сетки нет.
    /// </summary>
    private async Task ApplyChecked()
    {
        if (IsOpened())
            return;

        // Открывается заново — читается свежим, отставшая версия размещения не нужна.
        _shownVersion = PlacementVersion;
        _scope = null;
        _week = null;
        _brush.Clear();
        _brushOn = false;
        ClosePanel();
        if (!ShowsGrid)
            return;

        // Порядок кампаний — порядок списка, а не щелчков.
        List<int> ids = _rows.Select(WindowsSource.CampaignIdOf).Where(_checked.Contains).ToList();
        await Run(() =>
        {
            ModuleDaySource.ModuleScope scope = ModuleDaySource.Open(Action, ids);
            // Отмеченных кампаний не нашлось — их удалили; без отметок набор пустой и показывает только добавленные строки.
            if (ids.Count > 0 && scope.CampaignIds.Count == 0)
                return;
            _scope = scope;
            // Первое открытие — с недели (месяца) первого выпуска, у кампаний без выпусков — с сегодняшней; дальше
            // период сохраняется при смене отметок: кампании одной акции сравнивают за один период.
            if (!_dateChosen)
            {
                _date = scope.FirstIssueDate ?? DateTime.Today;
                _dateChosen = true;
            }
            LoadRollersCore();
            ReloadCore();
        });
        if (_scope == null && _error == null)
            _error = Tr.T("Рекламная кампания не найдена — её удалили. Обновите страницу.");
    }

    // ---------- Период ----------

    private Task Run(System.Action work) => Busy.RunAsync(() =>
    {
        try
        {
            _error = null;
            work();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    });

    /// <summary>Период заново (период, отбор, «Учитывать макеты», «Обновить»); место панели, если оно осталось в периоде, — тоже.</summary>
    private void ReloadCore()
    {
        _week = ModuleDaySource.LoadPeriod(_scope!, _date, _period, _view, AddedRows);
        if (_cell != null && _week.Find(_cell.Key) is { } fresh)
            ShowCore(fresh);
        else
            ClosePanel();
    }

    private Task Reload() => _scope == null ? Task.CompletedTask : Run(ReloadCore);

    /// <summary>«Обновить информацию»: ролики кисти и период.</summary>
    private Task RefreshAll() => _scope == null ? Task.CompletedTask : Run(() =>
    {
        LoadRollersCore();
        ReloadCore();
    });

    private Task Previous()
    {
        if (_week == null) return Task.CompletedTask;
        _date = _week.StartDate.AddDays(-1);
        return Reload();
    }

    private Task Next()
    {
        if (_week == null) return Task.CompletedTask;
        _date = _week.FinishDate.AddDays(1);
        return Reload();
    }

    private Task JumpTo(DateTime date)
    {
        _date = date;
        return Reload();
    }

    private Task SetPeriod(PlacementPeriod period)
    {
        if (period == _period)
            return Task.CompletedTask;
        _period = period;
        return Reload();
    }

    // ---------- Ячейка и панель ----------

    private string CellTitle(PlacementCell cell) =>
        DisplayFormat.Date(cell.Date)
        + (cell.Has(PlacementFlags.Mine) ? " · " + Tr.T("выпуски модуля в этот день") : "")
        + (cell.Has(PlacementFlags.Match) ? " · " + Tr.T("подходит под отбор") : "");

    private async Task ClickCell(PlacementGrid.CellEvent e)
    {
        if (_scope == null)
            return;

        if (_brushOn)
        {
            // Второй щелчок двойного (detail > 1) второй выпуск не ставит: Blazor выполняет события по очереди, и без
            // этой проверки он пришёл бы уже после первой постановки. Осознанный повторный щелчок по той же ячейке —
            // отдельный щелчок, он ставит ещё один выпуск модуля, как в десктопе (В-18).
            if (e.Mouse.Detail <= 1)
                await PlaceOne(e.Cell);
            return;
        }

        if (_details != null && _cell?.Key == e.Cell.Key)
            return;
        _issuesWindow = null;
        _windowIssues = null;
        await Run(() => ShowCore(e.Cell));
    }

    /// <summary>
    /// Панель места: выпуски и окна модуля за день; раскрытые «Все выходы в эфир» того же окна перечитываются.
    /// Сначала читаем, потом присваиваем: сбой чтения не должен оставить шапку одного места над окнами другого.
    /// </summary>
    private void ShowCore(PlacementCell cell)
    {
        ModuleDaySource.ModuleDayDetails details = ModuleDaySource.Details(_scope!, cell, _view.ShowUnconfirmed);
        ModuleDaySource.ModuleWindow? window = _issuesWindow == null ? null
            : details.Windows.FirstOrDefault(w => w.WindowId == _issuesWindow.WindowId && w.ModuleIssueId == _issuesWindow.ModuleIssueId);
        WindowsSource.WindowIssues? issues = window == null ? null : ModuleDaySource.LoadWindowIssues(window, _view.ShowUnconfirmed);
        _cell = cell;
        _details = details;
        _issuesWindow = window;
        _windowIssues = issues;
    }

    private void ClosePanel()
    {
        _cell = null;
        _details = null;
        _issuesWindow = null;
        _windowIssues = null;
    }

    /// <summary>«Все выходы в эфир» окна — по требованию; повторный щелчок сворачивает.</summary>
    private Task ToggleWindowIssues(ModuleDaySource.ModuleWindow window)
    {
        if (ReferenceEquals(window, _issuesWindow))
        {
            _issuesWindow = null;
            _windowIssues = null;
            return Task.CompletedTask;
        }
        return Run(() =>
        {
            WindowsSource.WindowIssues issues = ModuleDaySource.LoadWindowIssues(window, _view.ShowUnconfirmed);
            _issuesWindow = window;
            _windowIssues = issues;
        });
    }

    // ---------- Режим добавления ----------

    private void ToggleBrush() => _brushOn = !_brushOn;

    /// <summary>
    /// Клик «Режима добавления»: модуль строки на весь день — ролик кисти с позицией «Позиционирования», одной транзакцией
    /// с пересчётом акции (ModuleDaySource.PlaceOne). Затем период перечитывается целиком — остатки окон меняются и у
    /// соседних модулей с общими тарифами, отметки и итог дня, — и панель места, если она открыта. Отказ — над сеткой.
    /// </summary>
    private async Task PlaceOne(PlacementCell cell)
    {
        if (!CanBrush || _scope == null)
            return;

        bool placed = false;
        ModuleDaySource.ModuleScope scope = _scope;
        int rollerId = _brush.RollerId!.Value;
        int position = _view.Position;
        await Run(() =>
        {
            // «Поставлено» — сразу после коммита, до перечитывания: сбой чтения не должен скрыть запись от шапки страницы.
            ModuleDaySource.PlacedModuleIssue issue = ModuleDaySource.PlaceOne(scope, cell, rollerId, position);
            placed = true;
            // Добавленная строка без кампании: кампанию создала (или нашла неотмеченную) постановка — набор её уже знает,
            // отметка слева — тоже, иначе следующее открытие набора сбросило бы номера строк. Созданную — запомнить (В-21).
            if (!_checked.Contains(issue.CampaignId))
                _checked.Add(issue.CampaignId);
            if (issue.CampaignCreated)
                Memory.CampaignCreated(Action.ActionId, issue.CampaignId);
            ReloadCore();
        });
        if (placed)
            await Changed.InvokeAsync();
    }

    // ---------- «Показать модули» ----------

    /// <summary>Источники «Комбо-модуль» и «Модули радиостанции»: право добавлять модульные кампании.</summary>
    private bool CanAddRows => CanAddCampaigns && !ActionWorkspace.IsDeleted(Action);

    /// <summary>Источник «Модули рекламной кампании»: отмеченные кампании и право «Редактировать» на них.</summary>
    private bool CanCampaignRows => _scope is { CanEdit: true, CampaignIds.Count: > 0 } && !ActionWorkspace.IsDeleted(Action);

    private string ShowModulesHint =>
        ActionWorkspace.IsDeleted(Action) ? Tr.T("Рекламная акция удалена. Обновите страницу.")
        : CanAddRows || CanCampaignRows ? Tr.T("Добавить в сетку модули комбо-модуля, радиостанции или отмеченной рекламной кампании")
        : Tr.T("Нет права добавлять рекламные кампании в эту акцию.");

    private RenderFragment ShowModulesButton =>
        @<button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!(CanAddRows || CanCampaignRows))" title="@ShowModulesHint"
                 @onclick="() => Exclusive(ShowModules)">
            <i class="bi bi-plus-square" aria-hidden="true"></i>@Tr.T("Показать модули")
        </button>;

    /// <summary>
    /// «Показать модули»: окно выбора строк (ModuleRowsForm), строки — в память сеанса и в сетку сразу (ожидающие — как
    /// обычные, с остатками). Модули радиостанций без агентства не добавляются — итог таблицей, как у «Добавить рекламные
    /// кампании». Модули берутся на начало показанного периода.
    /// </summary>
    private async Task ShowModules()
    {
        if (!(CanAddRows || CanCampaignRows))
            return;

        try
        {
            ModuleDaySource.ModuleScope? scope = _scope;
            DateTime date = _week?.StartDate ?? _date;
            List<KeyValuePair<int, string>> campaigns = CanCampaignRows
                ? scope!.CampaignIds.Select(id => new KeyValuePair<int, string>(id, RowOf(id) is { } row ? CaptionOf(row) : id.ToString())).ToList()
                : new List<KeyValuePair<int, string>>();
            string campaignReason = _rows.Count == 0 ? Tr.T("В акции нет модульных рекламных кампаний.")
                : scope is { CanEdit: false, CampaignIds.Count: > 0 } ? NoRightText
                : Tr.T("Отметьте модульную рекламную кампанию слева.");
            bool canAdd = CanAddRows;
            ModuleRowsForm.Model model = await Busy.RunAsync(() =>
            {
                ModuleRowsForm.Model m = new ModuleRowsForm.Model
                {
                    Scope = scope!,
                    Date = date,
                    CanAdd = canAdd,
                    Campaigns = campaigns,
                    CampaignReason = campaignReason,
                    PaymentTypes = canAdd ? ActionWorkspace.LoadNewCampaignChoices().PaymentTypes : new DataTable(),
                };
                // Одна отмеченная кампания — по В-24 второй модуль ставят в неё: источник выбран сразу.
                if (campaigns.Count == 1)
                {
                    m.Source = ModuleRowsForm.Sources.Campaign;
                    m.CampaignId = campaigns[0].Key;
                    m.CampaignRows = ModuleDaySource.CampaignModules(scope!, campaigns[0].Key, date);
                }
                return m;
            });

            while (true)
            {
                if (await Dialogs.ShowAsync(Tr.T("Показать модули"), builder =>
                    {
                        builder.OpenComponent<ModuleRowsForm>(0);
                        builder.AddComponentParameter(1, nameof(ModuleRowsForm.Value), model);
                        builder.CloseComponent();
                    }, okText: Tr.T("Показать"), wide: true) != DialogOutcome.Ok)
                    return;

                model.Message = model.Validate();
                if (model.Message == null)
                    break;
            }

            List<ModuleDaySource.AddedRow> rows = model.Build(out List<string> skipped);
            Memory.Add(Action.ActionId, rows);
            // Строки кампании, снятой с отметки, иначе остались бы скрыты (AddedRows): «показать» — отметить её.
            foreach (DataRow campaign in _rows)
            {
                int id = WindowsSource.CampaignIdOf(campaign);
                if (!_checked.Contains(id) && rows.Any(r => r.CampaignId == null && IsCampaignOf(campaign, r)))
                    _checked.Add(id);
            }
            if (IsOpened())
                await Reload();
            else
                await ApplyChecked();

            // Итог — только при пропущенных станциях (остальное видно в сетке): таблица, в заголовке строка-счётчик
            // (docs/UI_RULES.md, п. 2.2).
            if (skipped.Count > 0)
            {
                DataTable errors = ErrorManager.CreateErrorsTable();
                foreach (string station in skipped)
                    ErrorManager.AddErrorRow(errors, DateTime.Now, Tr.Format("{0} - нет агентства", station));
                await Tables.ShowAsync(Tr.Format("Показано модулей: {0}, не показано радиостанций: {1}", rows.Count, skipped.Count),
                    errors, new Entity.Attribute("description", "Ошибка", "nvarchar")); // i18n-ok: Alias переводится при показе (ObjectList)
            }
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    // ---------- Ролики ----------

    /// <summary>Ролики кисти для открытого набора кампаний.</summary>
    private void LoadRollersCore()
    {
        _brush.Load(_scope!);
        if (!_brush.HasRollers)
            _brushOn = false;
    }

    /// <summary>Кисть выбрала другой ролик или добавила пустышку — тулбар показывает ролик кисти и «Режим добавления».</summary>
    private void BrushChanged()
    {
        if (!_brush.HasRollers)
            _brushOn = false;
    }

    /// <summary>Ролик изменили из меню «⋯» кисти: предмет рекламы мог смениться — список и отбор по предмету перечитать.</summary>
    private Task RollerEdited() => _scope == null ? Task.CompletedTask : Run(() =>
    {
        LoadRollersCore();
        ReloadCore();
    });

    private void ShowError(string message) => _error = message;

    private bool _operating;

    /// <summary>
    /// Операция с вопросом пользователю (пустышка) — одна за раз: повторный щелчок, пришедший, пока открыт вопрос, иначе
    /// открыл бы второй такой же вопрос.
    /// </summary>
    private async Task Exclusive(Func<Task> operation)
    {
        if (_operating)
            return;
        _operating = true;
        try
        {
            await operation();
        }
        finally
        {
            _operating = false;
        }
    }

    /// <summary>Время выхода окна; окно, перенесённое трафиком на другой день, — с датой.</summary>
    private string WindowTime(ModuleDaySource.ModuleWindow window) =>
        _details != null && window.Date.Date != _details.Date.Date ? DisplayFormat.DayMonthTime(window.Date) : window.Date.ToString("HH:mm");
}
