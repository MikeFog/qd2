@using System.Data
@using FogSoft.WinForm.Classes
@using Merlin.Classes

@*
    «Цена рекламной акции» — веб-аналог десктопной ActionFinalPriceForm: либо один менеджерский
    коэффициент на все кампании (по умолчанию, как в десктопе), либо итоговая стоимость, которая
    делится между кампаниями пропорционально их нынешним итогам. Последняя кампания забирает
    остаток до копейки (ActionOnMassmedia.ApplyFinalPrice — тот же код, что в десктопе).
*@

@if (Value.Message != null)
{
    <div class="alert alert-danger">@Value.Message</div>
}

<dl class="facts">
    <div><dt>@Tr.T("Стоимость без скидок")</dt><dd>@Value.Info.TariffPrice.ToString("C")</dd></div>
    <div><dt>@Tr.T("Стоимость со всеми скидками")</dt><dd>@Value.Info.TotalPrice.ToString("C")</dd></div>
</dl>

<div class="mode">
    <label class="form-check">
        <input type="radio" class="form-check-input" name="action-price-mode" checked="@Value.ByRatio" @onchange="() => Value.ByRatio = true" />
        @Tr.T("Менеджерская скидка:")
    </label>
    <input type="number" class="form-control form-control-sm tabular" min="0" max="1000" step="0.0001"
           disabled="@(!Value.ByRatio)" aria-label="@(Tr.T("Менеджерская скидка"))"
           @bind="Value.Ratio" @bind:after="RatioChanged" />
</div>
<div class="mode">
    <label class="form-check">
        <input type="radio" class="form-check-input" name="action-price-mode" checked="@(!Value.ByRatio)" @onchange="() => Value.ByRatio = false" />
        @Tr.T("Итоговая стоимость:")
    </label>
    <input type="number" class="form-control form-control-sm tabular" min="0" step="0.01"
           disabled="@Value.ByRatio" aria-label="@(Tr.T("Итоговая стоимость"))"
           @bind="Value.FinalPrice" />
</div>

@if (Value.NeedsReason)
{
    <label class="field">
        @Tr.T("Причина выдачи скидки")
        <select class="form-select form-select-sm" @bind="Value.ReasonId">
            <option value="">@Tr.T("— выберите —")</option>
            @foreach (DataRow r in Value.Reasons.Rows)
            {
                <option value="@r["ManagerDiscountReasonId"]">@r["name"]</option>
            }
        </select>
    </label>
}

@if (Value.CanChooseDate)
{
    <div class="past">
        <label class="form-check">
            <input type="checkbox" class="form-check-input" @bind="Value.UseDate" />
            @Tr.T("Изменить цену в прошлом:")
        </label>
        <input type="date" class="form-control form-control-sm" disabled="@(!Value.UseDate)" @bind="Value.Date" />
    </div>
}

@code {
    [Parameter, EditorRequired] public Model Value { get; set; } = default!;

    private void RatioChanged() =>
        Value.FinalPrice = Math.Round(Value.Info.PriceForRatio(Value.Ratio), 2, MidpointRounding.AwayFromZero);

    public sealed class Model
    {
        public ActionWorkspace.ActionPriceInfo Info { get; init; } = default!;
        public bool ByRatio { get; set; } = true;
        public decimal Ratio { get; set; }
        public decimal FinalPrice { get; set; }

        public bool NeedsReason { get; init; }
        public DataTable Reasons { get; init; } = new();
        public int? ReasonId { get; set; }

        public bool CanChooseDate { get; init; }
        public bool UseDate { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;

        public string? Message { get; set; }

        /// <summary>Проверка «ОК»: текст ошибки или null.</summary>
        public string? Validate()
        {
            if (FinalPrice < 0 || Ratio < 0)
                return Tr.T("Цена и коэффициент не могут быть отрицательными.");
            if (NeedsReason && ReasonId == null)
                return Tr.T("Необходимо выбрать причину выдачи скидки.");
            return null;
        }
    }
}
