@using FogSoft.Web.Infrastructure
@implements IDisposable
@inject DialogService Dialogs

@*
    Рисует диалог, открытый через DialogService. Ставится один раз в макет —
    аналог того, что в десктопе роль «поверх всего» играет само окно.
*@

@if (Dialogs.Current is { } dialog)
{
    <div class="modal fade show" style="display:block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@dialog.Title</h5>
                    <button type="button" class="btn-close"
                            @onclick="() => Dialogs.CloseAsync(DialogOutcome.Cancel)"></button>
                </div>
                <div class="modal-body">
                    @dialog.Body
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary"
                            @onclick="() => Dialogs.CloseAsync(DialogOutcome.Ok)">@dialog.OkText</button>
                    <button class="btn btn-secondary"
                            @onclick="() => Dialogs.CloseAsync(DialogOutcome.Cancel)">Отмена</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    protected override void OnInitialized() => Dialogs.Changed += OnChangedAsync;

    // InvokeAsync обязателен: событие может прийти не с диспетчера circuit,
    // а перерисовка компонента допустима только на нём.
    private Task OnChangedAsync() => InvokeAsync(StateHasChanged);

    public void Dispose() => Dialogs.Changed -= OnChangedAsync;
}
