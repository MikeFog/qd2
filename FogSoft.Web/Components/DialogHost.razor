@using FogSoft.Web.Infrastructure
@implements IDisposable
@inject DialogService Dialogs

@*
    Рисует диалоги, открытые через DialogService. Ставится один раз в макет —
    аналог того, что в десктопе роль «поверх всего» играет само окно.

    Диалогов может быть несколько: паспорт → выбор объекта → паспорт нового
    объекта. Нижние остаются видимы, как остаётся видна форма-владелец в
    десктопе, но не принимают нажатий — закрыть можно только верхний.
*@

@{
    var open = Dialogs.Open;
}

@for (int i = 0; i < open.Count; i++)
{
    var dialog = open[i];
    bool isTop = i == open.Count - 1;

    <div class="modal fade show" style="display:block; pointer-events:@(isTop ? "auto" : "none")" tabindex="-1">
        @* modal-dialog-scrollable: длинная карточка прокручивается внутри
           окна, а кнопки остаются на месте. Без этого до «Сохранить» на
           паспорте радиостанции приходилось скроллить всю страницу. *@
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@dialog.Title</h5>
                    <button type="button" class="btn-close" disabled="@(!isTop)"
                            @onclick="() => Dialogs.CloseAsync(DialogOutcome.Cancel)"></button>
                </div>
                <div class="modal-body">
                    @dialog.Body
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" disabled="@(!isTop)"
                            @onclick="() => Dialogs.CloseAsync(DialogOutcome.Ok)">@dialog.OkText</button>
                    <button class="btn btn-secondary" disabled="@(!isTop)"
                            @onclick="() => Dialogs.CloseAsync(DialogOutcome.Cancel)">Отмена</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    protected override void OnInitialized() => Dialogs.Changed += OnChangedAsync;

    // InvokeAsync обязателен: событие может прийти не с диспетчера circuit,
    // а перерисовка компонента допустима только на нём.
    private Task OnChangedAsync() => InvokeAsync(StateHasChanged);

    public void Dispose() => Dialogs.Changed -= OnChangedAsync;
}
