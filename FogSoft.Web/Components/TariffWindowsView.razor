@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using Merlin.Classes
@inject BusyService Busy
@inject ObjectActions Actions
@inject ActionMenuService Menu
@inject NamedPassportDialog NamedPassports

@*
    Вкладка «Окна» у прайс-листа радиостанции: рекламные окна за неделю —
    веб-аналог сетки на десктопной форме «Генерация рекламных окон»
    (TariffWindowGenerationForm + TariffWindowGrid).

    Не один в один (docs/tasks/web-tariffgrid.md):
      - открывается на текущей неделе, если прайс-лист действует (десктоп — всегда
        на первой неделе прайс-листа);
      - недоступные и помеченные окна видны цветом, с легендой (в десктопе на этой
        форме их не видно — раскраска есть только в сетке кампании);
      - окно, изменённое относительно своего тарифа, помечено уголком, в подсказке —
        что именно отличается (тариф — шаблон, окно — экземпляр:
        docs/business-logic.md, «Тариф и рекламное окно»);
      - под датой — число окон за день (в десктопе строка счётчика здесь всегда нули:
        она про выпуски кампании, а на форме генерации кампании нет);
      - нет кнопки «Удалить окно»: в десктопе она есть, но сгенерированное окно
        процедура удалить не даёт (TariffWindowIUD, TariffWindowDeleteAttempt), а
        других окон эта сетка не показывает. Удаляют окна «Удалить сгенерированные
        окна» у строки времени и у прайс-листа.

    Данные — один вызов TariffWindowRetrieve на неделю плюс список тарифов (фасад ядра
    TariffWindowWeek). Действия над окном — общий движок (ObjectActions) по метаданным
    сущности «Рекламное окно»: сейчас это «Свойства» (карточка окна). Операции с окнами
    прайс-листа («Сгенерировать», «Удалить сгенерированные», запрет внесения, пометка,
    заблокированные окна) — тот же движок по метаданным прайс-листа, кнопкой над сеткой;
    в десктопе это меню узла прайс-листа в дереве формы генерации окон.
*@

<div class="windows">
    @if (_error != null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <WindowWeekGrid Week="_week" Date="_date" SelectedIds="SelectedIds" MenuRow="_menuRow"
                    OnPrevious="PreviousWeek" OnNext="NextWeek" OnJump="JumpTo"
                    OnCellClick="e => SelectCell(e.Cell)"
                    OnCellDoubleClick="e => OpenPassport(e.Cell)"
                    OnCellContextMenu="e => OpenCellMenu(e.Cell, e.Mouse, fromButton: false)"
                    OnRowMenu="e => OpenRowMenu(e.Row, e.Mouse)">
        <Toolbar>
            <button type="button" class="btn btn-sm btn-outline-secondary" aria-haspopup="menu"
                    @onclick="OpenPricelistMenu">
                <i class="bi bi-grid-3x3" aria-hidden="true"></i>Операции с окнами
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
        </Toolbar>
    </WindowWeekGrid>

    @if (_week != null && _week.Rows.Count > 0)
    {
        <div class="selection-line">
            @if (_selected != null)
            {
                <span class="selection-text">
                    Окно <b class="tabular">@DisplayFormat.DateAndTime(_selected.WindowDate)</b> · @_selected.Text@WindowWeekGrid.StatusText(_selected)
                    @if (_selected.IsModified)
                    {
                        <span class="deviations"> · не как в тарифе: @string.Join("; ", _selected.Deviations)</span>
                    }
                </span>
                <span class="selection-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenSelectedPassport">
                        <i class="bi bi-card-text" aria-hidden="true"></i>Открыть карточку
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Действия" aria-label="Действия"
                            aria-haspopup="menu" @onclick="e => OpenCellMenu(_selected, e, fromButton: true)">
                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                    </button>
                </span>
            }
            else
            {
                <span class="muted">Выберите окно в сетке. Двойной клик — карточка окна, правая кнопка — действия с окном, «⋯» у времени — действия со строкой.</span>
            }
        </div>
    }
</div>

@code {
    /// <summary>Прайс-лист радиостанции — объект узла дерева (MassmediaPricelist, internal в ядре).</summary>
    [Parameter, EditorRequired] public object Pricelist { get; set; } = default!;

    /// <summary>Меняется, когда экран перечитывает узел («Обновить», действие над прайс-листом):
    /// сетка перечитывает ту же неделю.</summary>
    [Parameter] public int RefreshToken { get; set; }

    /// <summary>
    /// Операция изменила окна прайс-листа (генерация, удаление, запрет, пометка). Экран
    /// перечитывает узел — в имени прайс-листа срок сгенерированных окон — и вместе с ним
    /// сетку (RefreshToken).
    /// </summary>
    [Parameter] public EventCallback Changed { get; set; }

    // Пункты меню строки времени — действия TariffWindowGrid.cmTimeColumn десктопа.
    private const string ChangePriceAction = "ChangePrice";
    private const string DeleteGeneratedAction = "DeleteGeneratedWindows";

    private object? _loadedFor;
    private int _loadedToken;
    private TariffWindowWeek? _week;
    private DateTime _date;
    private TariffWindowCell? _selected;
    private TariffWindowRow? _menuRow;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        // Перечитываем только при смене прайс-листа или по сигналу экрана: родитель
        // перерисовывается и по другим причинам (раскрытие узлов, меню).
        if (ReferenceEquals(_loadedFor, Pricelist))
        {
            if (_loadedToken == RefreshToken)
                return;
            _loadedToken = RefreshToken;
            await Load();
            return;
        }

        _loadedFor = Pricelist;
        _loadedToken = RefreshToken;
        _week = null;
        _selected = null;
        _date = TariffWindowWeek.DefaultDate(Pricelist);
        await Load();
    }

    private Task Load() => Busy.RunAsync(() =>
    {
        try
        {
            _error = null;
            _week = TariffWindowWeek.Load(Pricelist, _date);
            // Дата вне срока прайс-листа прижата к его границе — поле показывает, что открыто.
            if (_date < _week.StartDate || _date > _week.FinishDate)
                _date = _week.StartDate;
            // Ячейки после чтения — новые объекты: выбранное окно ищем по номеру. Окна
            // другой недели на экране нет — выбор сбрасывается.
            _selected = _selected == null ? null : FindCell(_selected.WindowId);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    });

    private Task PreviousWeek()
    {
        _date = _week!.StartDate.AddDays(-1);
        return Load();
    }

    private Task NextWeek()
    {
        _date = _week!.FinishDate.AddDays(1);
        return Load();
    }

    private Task JumpTo(DateTime date)
    {
        _date = date;
        return Load();
    }

    private IReadOnlyCollection<int>? SelectedIds => _selected == null ? null : new[] { _selected.WindowId };

    private void SelectCell(TariffWindowCell cell) => _selected = cell;

    private TariffWindowCell? FindCell(int windowId)
    {
        foreach (TariffWindowRow row in _week!.Rows)
            foreach (TariffWindowCell? cell in row.Cells)
                if (cell != null && cell.WindowId == windowId)
                    return cell;
        return null;
    }

    // ---------- Действия с окном ----------

    /// <summary>
    /// Меню окна — тот же движок и те же метаданные, что у строк списков: правая кнопка
    /// по ячейке или «⋯» в строке выбранного окна. Сначала окно выбирается — видно, к
    /// чему относится меню (как правая кнопка по узлу дерева).
    /// </summary>
    private async Task OpenCellMenu(TariffWindowCell cell, MouseEventArgs e, bool fromButton)
    {
        try
        {
            _selected = cell;
            PresentationObject window = TariffWindowWeek.CreateWindowObject(cell);
            string? picked = await Menu.ShowAsync(WithDoubleClickHint(Actions.BuildMenu(window, ViewType.Journal)),
                e.ClientX, e.ClientY, fromButton);
            if (picked != null)
                await Execute(window, picked);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    private Task OpenSelectedPassport() => _selected == null ? Task.CompletedTask : OpenPassport(_selected);

    /// <summary>Карточка окна — двойной клик: одиночный клик в сетке выбирает окно.</summary>
    private async Task OpenPassport(TariffWindowCell cell)
    {
        try
        {
            _selected = cell;
            await Execute(TariffWindowWeek.CreateWindowObject(cell), Constants.EntityActions.ShowPassport);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// Меню строится для «списка» (ViewType.Journal) — там у «Открыть карточку» подсказка
    /// «клик». В сетке клик выбирает окно, карточку открывает двойной клик.
    /// </summary>
    private static IReadOnlyList<ActionMenuItem> WithDoubleClickHint(IReadOnlyList<ActionMenuItem> items) =>
        items.Select(i => i.Name != Constants.EntityActions.ShowPassport || i.Hint == null ? i : new ActionMenuItem
        {
            Name = i.Name, Text = i.Text, Icon = i.Icon, Hint = "двойной клик", Enabled = i.Enabled,
            Ported = i.Ported, Danger = i.Danger, Children = i.Children,
        }).ToList();

    /// <summary>
    /// Любое изменение окна (время выхода, продолжительность, запрет внесения) может
    /// перенести его в другую строку или снять/поставить метку — перечитываем неделю.
    /// </summary>
    private async Task Execute(PresentationObject window, string actionName)
    {
        ActionEffect? effect = await Actions.ExecuteAsync(window, actionName, ViewType.Journal);
        if (effect is { } done && done != ActionEffect.None)
            await Load();
    }

    // ---------- Действия со строкой времени ----------

    private async Task OpenRowMenu(TariffWindowRow row, MouseEventArgs e)
    {
        try
        {
            _menuRow = row;
            var items = new[]
            {
                new ActionMenuItem { Name = ChangePriceAction, Text = "Изменить цену…", Icon = "bi-currency-exchange", Enabled = true, Ported = true },
                new ActionMenuItem { Name = DeleteGeneratedAction, Text = "Удалить сгенерированные окна…", Icon = "bi-trash3", Enabled = true, Ported = true, Danger = true },
            };
            string? picked = await Menu.ShowAsync(items, e.ClientX, e.ClientY, fromButton: true);
            _menuRow = null;
            StateHasChanged();

            if (picked == ChangePriceAction)
                await ChangePrice(row);
            else if (picked == DeleteGeneratedAction
                     && await Actions.DeleteGeneratedWindows(Pricelist, row.TimeOfDay) != ActionEffect.None)
                await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            _menuRow = null;
            _error = ErrorPresenter.Describe(ex);
        }
    }

    /// <summary>
    /// «Изменить цену…» — веб-аналог TariffWindowGrid.ChangePrice: именованный паспорт
    /// ChangeTariffWindowsPrice, проверки и процедура TariffWindowChangePrice — в ядре.
    /// Меняются окна этого времени с этой ценой в выбранном интервале; после — неделя
    /// перечитывается (окна с новой ценой уходят в другую строку).
    /// </summary>
    private async Task ChangePrice(TariffWindowRow row)
    {
        PresentationObject draft = TariffWindowWeek.CreateChangePriceDraft(Pricelist, row);
        bool changed = await NamedPassports.ShowAsync(draft, TariffWindowWeek.ChangePricePassport,
            $"Изменение цены: {row.Time}", isNew: false,
            values => TariffWindowWeek.ValidateChangePrice(Pricelist, values),
            TariffWindowWeek.ChangePrice,
            data: new System.Data.DataSet());
        if (changed)
            await Load();
    }

    // ---------- Операции с окнами прайс-листа ----------

    /// <summary>
    /// Меню прайс-листа, но только его пункты про окна — по метаданным (порядок, права,
    /// доступность), для копии прайс-листа с дочерней сущностью «Рекламное окно»
    /// (PricelistWindows.ForWindows). Прочие пункты прайс-листа — в меню узла дерева.
    /// </summary>
    private async Task OpenPricelistMenu(MouseEventArgs e)
    {
        try
        {
            object target = PricelistWindows.ForWindows(Pricelist);
            var items = Actions.BuildMenu(target, ViewType.Tree)
                .Where(i => i.IsSeparator || PricelistWindows.ActionNames.All.Contains(i.Name))
                .ToList();
            // Разделители по краям и подряд — после фильтра их могло стать больше.
            while (items.Count > 0 && items[0].IsSeparator) items.RemoveAt(0);
            while (items.Count > 0 && items[^1].IsSeparator) items.RemoveAt(items.Count - 1);
            for (int i = items.Count - 1; i > 0; i--)
                if (items[i].IsSeparator && items[i - 1].IsSeparator) items.RemoveAt(i);

            string? picked = await Menu.ShowAsync(items, e.ClientX, e.ClientY, fromButton: true);
            if (picked == null)
                return;

            ActionEffect? effect = await Actions.ExecuteAsync(target, picked, ViewType.Tree);
            if (effect is { } done && done != ActionEffect.None)
                await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }
}
