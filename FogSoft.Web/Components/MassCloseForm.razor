@using System.Data
@using Merlin.Classes

@*
    Содержимое диалога «Отметить дни обработанными» на экране «Трафик» — веб-аналог
    десктопного RadiostationsSelector (станции галочками + дата). Список станций уже
    загружен экраном; фильтр по группе — здесь же, без запросов. Отметки пишутся прямо
    в модель — её читает экран по «ОК».
*@

@if (Value.Message != null)
{
    <div class="alert alert-danger">@Value.Message</div>
}

<div class="mass-close">
    <label class="field">
        Обработано по (включительно)
        <input type="date" class="form-control form-control-sm" @bind="Value.Date" />
    </label>
    <p class="text-muted hint">
        Выпуски станции по эту дату после отметки сможет менять только трафик-менеджер и
        администратор. Дата раньше текущей снимает отметку с последующих дней.
    </p>

    <div class="filter-row">
        <select class="form-select form-select-sm" aria-label="Группа станций" @bind="Value.Group">
            <option value="">Все группы</option>
            @foreach (string group in Groups)
            {
                <option value="@group">@group</option>
            }
        </select>
        <label class="check-all">
            <input type="checkbox" class="form-check-input" checked="@AllVisibleChecked" @onchange="ToggleAll" />
            Отметить все (@Visible.Count())
        </label>
    </div>

    <ul class="list">
        @foreach (DataRow s in Visible)
        {
            int id = Convert.ToInt32(s[Massmedia.ParamNames.MassmediaId]);
            <li>
                <label>
                    <input type="checkbox" class="form-check-input" checked="@Value.Selected.Contains(id)"
                           @onchange="e => Toggle(id, e.Value is true)" />
                    <span class="name">@s[Massmedia.ParamNames.Name]</span>
                    <span class="meta">@s[Massmedia.ParamNames.GroupName]</span>
                    @if (s[Massmedia.ParamNames.DeadLine] is DateTime closed)
                    {
                        <span class="meta tabular"><i class="bi bi-lock-fill" aria-hidden="true"></i>@DisplayFormat.Date(closed)</span>
                    }
                </label>
            </li>
        }
    </ul>
    <div class="text-muted">Выбрано станций: @Value.Selected.Count</div>
</div>

@code {
    [Parameter, EditorRequired] public Model Value { get; set; } = default!;

    public sealed class Model
    {
        public DateTime Date { get; set; } = DateTime.Today;
        public DataTable Stations { get; set; } = new();
        public string Group { get; set; } = "";
        public HashSet<int> Selected { get; } = new();
        public string? Message { get; set; }
    }

    private IEnumerable<string> Groups => Value.Stations.Rows.Cast<DataRow>()
        .Select(r => r[Massmedia.ParamNames.GroupName]?.ToString() ?? "")
        .Where(g => g.Length > 0).Distinct().OrderBy(g => g);

    private IEnumerable<DataRow> Visible => Value.Stations.Rows.Cast<DataRow>()
        .Where(r => Value.Group.Length == 0 || r[Massmedia.ParamNames.GroupName]?.ToString() == Value.Group);

    private bool AllVisibleChecked => Visible.Any()
        && Visible.All(r => Value.Selected.Contains(Convert.ToInt32(r[Massmedia.ParamNames.MassmediaId])));

    private void Toggle(int id, bool on)
    {
        if (on) Value.Selected.Add(id);
        else Value.Selected.Remove(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        bool on = e.Value is true;
        foreach (DataRow r in Visible.ToList())
            Toggle(Convert.ToInt32(r[Massmedia.ParamNames.MassmediaId]), on);
    }
}
