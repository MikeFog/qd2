@using FogSoft.Web.Infrastructure

@*
    Один узел дерева древовидного экрана, рекурсивно рисующий своих детей.

    Компонент, а не построение разметки руками через RenderTreeBuilder: у
    элементов, созданных билдером, нет атрибута изоляции стилей, который
    компилятор Razor проставляет разметке, — и .razor.css к ним просто не
    применяется. Первый вариант был именно таким, и узлы выглядели как
    обычные кнопки. Тот же приём, что у MenuNodeView.
*@

<div class="tree-node">
    <div class="tree-row @(ReferenceEquals(Node, Selected) ? "tree-row-active" : "") @(ReferenceEquals(Node, MenuNode) ? "tree-row-menu" : "")"
         @oncontextmenu="e => ShowActions ? OnMenu.InvokeAsync(new BrowserNodeMenuRequest(Node, e, false)) : Task.CompletedTask"
         @oncontextmenu:preventDefault="ShowActions">
        <button type="button" class="tree-caret" disabled="@(!Node.Expandable)"
                @onclick="() => OnToggle.InvokeAsync(Node)">
            @(Node.Expandable ? (Node.Expanded ? "▾" : "▸") : "")
        </button>
        <button type="button" class="tree-label" title="@Node.Name"
                @onclick="() => OnSelect.InvokeAsync(Node)">
            <i class="bi @Node.Icon entity-icon" aria-hidden="true"></i>@Node.Name
        </button>
        @if (ShowActions)
        {
            <button type="button" class="tree-more" title="Действия" aria-label="Действия" aria-haspopup="menu"
                    @onclick="e => OnMenu.InvokeAsync(new BrowserNodeMenuRequest(Node, e, true))">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
            </button>
        }
    </div>

    @if (Node.Expanded && Node.Children != null)
    {
        <div class="tree-children">
            @foreach (var child in Node.Children)
            {
                <BrowserNodeView Node="child" Selected="Selected" MenuNode="MenuNode" ShowActions="ShowActions"
                                 OnToggle="OnToggle" OnSelect="OnSelect" OnMenu="OnMenu" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public BrowserNode Node { get; set; } = default!;

    /// <summary>Выбранный узел экрана — чтобы подсветить свой, если это он.</summary>
    [Parameter] public BrowserNode? Selected { get; set; }

    /// <summary>Узел, у которого сейчас открыто меню, — остаётся подсвеченным.</summary>
    [Parameter] public BrowserNode? MenuNode { get; set; }

    [Parameter] public EventCallback<BrowserNode> OnToggle { get; set; }
    [Parameter] public EventCallback<BrowserNode> OnSelect { get; set; }

    /// <summary>
    /// Действия узла («⋯» и правая кнопка). Выключены в диалоге выбора из
    /// дерева (ScenarioTreePicker): там узел только выбирают.
    /// </summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    /// <summary>Меню узла: правая кнопка или «⋯».</summary>
    [Parameter] public EventCallback<BrowserNodeMenuRequest> OnMenu { get; set; }
}
