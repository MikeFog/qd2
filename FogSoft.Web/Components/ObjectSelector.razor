@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@inject BusyService Busy

@*
    Выбор объекта из списка — веб-аналог SelectionForm.

    Как и в десктопе, это не журнал: ни фильтра, ни карточки, ни действий —
    только строки сущности и выбор одной из них. Права на экран здесь не
    проверяются намеренно: в десктопе у выбора объекта нет своего пункта меню,
    доступ к нему даёт уже открытый паспорт. См. комментарий о границах
    применимости в MenuAccess.
*@

@if (_error != null)
{
    <div class="alert alert-danger mb-0">@_error</div>
}
else if (_data == null)
{
    <div class="state">@Tr.T("Загрузка…")</div>
}
else if (_data.Rows.Count == 0)
{
    <div class="state">@Tr.T("Выбирать не из чего: список пуст.")</div>
}
else
{
    // Сначала отбор строк: он же считает совпадения для счётчика в строке поиска.
    var shown = Shown();
    @if (_data.Rows.Count > SearchThreshold)
    {
        <QuickSearchBox Text="@_search" TextChanged="Search" Matched="_matched" Total="_data.Rows.Count"
                        ColumnCaption="@SearchColumnCaption" ScopeReset="() => _searchColumn = null" />
    }
    @if (_matched > shown.Count)
    {
        <div class="text-muted small picker-note">@Tr.Format("Показаны первые {0} из {1} — уточните поиск.", shown.Count, _matched)</div>
    }
    @if (Multiselect && _selectedRows.Count > 0)
    {
        <div class="text-muted small picker-note">@Tr.Format("Отмечено: {0}", _selectedRows.Count)</div>
    }
    <div class="data-table picker-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    @if (Multiselect)
                    {
                        <th class="col-check"></th>
                    }
                    @foreach (var a in _columns)
                    {
                        <th class="sortable" @onclick="() => SortBy(a.Name)">
                            @Tr.T(a.Alias)<span class="sort-mark">@SortMark(a.Name)</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in shown)
                {
                    <tr class="@(IsRowSelected(row) ? "table-primary" : "")"
                        style="cursor:pointer" @onclick="() => RowClicked(row)">
                        @if (Multiselect)
                        {
                            <td class="col-check" @onclick:stopPropagation="true">
                                <input type="checkbox" class="form-check-input"
                                       checked="@_selectedRows.Contains(row)"
                                       @onchange="e => ToggleRow(row, e.Value)" />
                            </td>
                        }
                        @foreach (var a in _columns)
                        {
                            <td>@Display(row, a.Name)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary>Что выбираем и по какому фильтру.</summary>
    [Parameter, EditorRequired] public PassportPicker Picker { get; set; } = default!;

    /// <summary>Наборы строк паспорта — источник кандидатов, если он там есть.</summary>
    [Parameter] public DataSet? PassportData { get; set; }

    /// <summary>
    /// Редактируемый объект: из него берутся значения фильтров типа parameter.
    /// null в фильтре журнала — там нет редактируемого объекта, а вложенные
    /// &lt;filter&gt; в фильтре встречаются только константных типов.
    /// </summary>
    [Parameter] public PresentationObject? Owner { get; set; }

    /// <summary>
    /// Режим множественного выбора — колонка галочек вместо одиночного клика по
    /// строке. Веб-аналог SelectionForm(..., showCheckboxes: true).
    /// </summary>
    [Parameter] public bool Multiselect { get; set; }

    /// <summary>
    /// Что было отмечено до открытия — переживает повторный показ диалога после
    /// неудачной проверки выбора (тот же приём, что у PricelistCloneDialog:
    /// компонент создаётся заново, состояние иначе терялось бы). null — ничего
    /// не отмечено, обычное открытие.
    /// </summary>
    [Parameter] public IReadOnlyList<DataRow>? InitialSelectedRows { get; set; }

    /// <summary>Выбранная строка; null — пользователь ничего не выбрал. Не используется в Multiselect.</summary>
    public DataRow? SelectedRow { get; private set; }

    /// <summary>Отмеченные строки в режиме Multiselect.</summary>
    public IReadOnlyList<DataRow> SelectedRows => _selectedRows.ToList();

    private readonly HashSet<DataRow> _selectedRows = new();
    private DataTable? _data;
    private IReadOnlyList<Entity.Attribute> _columns = Array.Empty<Entity.Attribute>();
    private string? _error;

    // Список грузится под слоем ожидания: диалог открывается сразу с «Загрузка…»,
    // а не после того, как процедура отдаст строки.
    protected override Task OnInitializedAsync() => Busy.RunAsync(Load);

    private void Load()
    {
        try
        {
            Entity entity = EntityManager.GetEntity(Picker.EntityName);
            _columns = entity.SortedAttributes;
            _data = PickerData.Candidates(Picker, PassportData, Owner);

            if (InitialSelectedRows != null)
                foreach (DataRow row in InitialSelectedRows)
                    _selectedRows.Add(row);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    // Список выбора бывает большим (фирм ~7 000): всё сразу браузер рисует десятки секунд.
    // Поэтому у длинного списка — быстрый поиск (QuickSearchBox, правило — QuickSearchFilter),
    // а показывается не больше MaxShown строк. Щелчок по заголовку сортирует и сужает поиск
    // до этой колонки — как SelectionForm десктопа, где поиск идёт по колонке сортировки.
    private const int SearchThreshold = 30;
    private const int MaxShown = 200;
    private string _search = "";
    private string? _searchColumn;
    private string? _sortColumn;
    private bool _sortDescending;
    private int _matched;

    private string? SearchColumnCaption =>
        _searchColumn == null ? null : Tr.T(_columns.FirstOrDefault(a => a.Name == _searchColumn)?.Alias);

    private void Search(string text)
    {
        _search = text;
        // Одиночный выбор, скрытый поиском, не должен уйти по «Выбрать» незаметно.
        // Галочки множественного выбора копятся между поисками — их число видно над таблицей.
        if (SelectedRow != null && !IsMatch(SelectedRow, _search.Trim()))
            SelectedRow = null;
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortDescending = !_sortDescending;
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }
        _searchColumn = IsBoolean(column) ? null : column;
    }

    private string SortMark(string column) =>
        _sortColumn == column ? (_sortDescending ? " ▾" : " ▴") : "";

    private List<DataRow> Shown()
    {
        IEnumerable<DataRow> rows = _data!.Rows.Cast<DataRow>();
        if (_sortColumn != null && _data.Columns.Contains(_sortColumn))
            rows = new DataView(_data) { Sort = $"[{_sortColumn.Replace("]", "]]")}] {(_sortDescending ? "DESC" : "ASC")}" }
                .Cast<DataRowView>().Select(v => v.Row);

        string text = _search.Trim();
        var result = new List<DataRow>();
        _matched = 0;
        foreach (DataRow row in rows)
        {
            if (text.Length > 0 && !IsMatch(row, text))
                continue;
            _matched++;
            if (result.Count < MaxShown)
                result.Add(row);
        }
        return result;
    }

    private bool IsMatch(DataRow row, string text) =>
        text.Length == 0 || QuickSearchFilter.Matches(row, text, _searchColumn, _columns,
            (r, a) => Display(r, a.Name), a => IsBoolean(a.Name));

    private bool IsBoolean(string column) =>
        _data != null && _data.Columns.Contains(column) && _data.Columns[column]!.DataType == typeof(bool);

    private bool IsRowSelected(DataRow row) =>
        Multiselect ? _selectedRows.Contains(row) : ReferenceEquals(row, SelectedRow);

    private void RowClicked(DataRow row)
    {
        if (Multiselect)
            ToggleRow(row, !_selectedRows.Contains(row));
        else
            SelectedRow = row;
    }

    private void ToggleRow(DataRow row, object? isChecked)
    {
        bool on = isChecked is bool b && b;
        if (on)
            _selectedRows.Add(row);
        else
            _selectedRows.Remove(row);
    }

    private static string Display(DataRow row, string column)
    {
        if (!row.Table.Columns.Contains(column))
            return "";
        object v = row[column];
        return v == DBNull.Value ? "" : v.ToString() ?? "";
    }
}
