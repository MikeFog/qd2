@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes

@*
    Выбор объекта из списка — веб-аналог SelectionForm.

    Как и в десктопе, это не журнал: ни фильтра, ни карточки, ни действий —
    только строки сущности и выбор одной из них. Права на экран здесь не
    проверяются намеренно: в десктопе у выбора объекта нет своего пункта меню,
    доступ к нему даёт уже открытый паспорт. См. комментарий о границах
    применимости в MenuAccess.
*@

@if (_error != null)
{
    <div class="alert alert-danger mb-0">@_error</div>
}
else if (_data == null)
{
    <div class="state">Загрузка…</div>
}
else if (_data.Rows.Count == 0)
{
    <div class="state">Выбирать не из чего: список пуст.</div>
}
else
{
    <div class="data-table picker-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    @if (Multiselect)
                    {
                        <th class="col-check"></th>
                    }
                    @foreach (var a in _columns)
                    {
                        <th>@a.Alias</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in _data.Rows)
                {
                    <tr class="@(IsRowSelected(row) ? "table-primary" : "")"
                        style="cursor:pointer" @onclick="() => RowClicked(row)">
                        @if (Multiselect)
                        {
                            <td class="col-check" @onclick:stopPropagation="true">
                                <input type="checkbox" class="form-check-input"
                                       checked="@_selectedRows.Contains(row)"
                                       @onchange="e => ToggleRow(row, e.Value)" />
                            </td>
                        }
                        @foreach (var a in _columns)
                        {
                            <td>@Display(row, a.Name)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary>Что выбираем и по какому фильтру.</summary>
    [Parameter, EditorRequired] public PassportPicker Picker { get; set; } = default!;

    /// <summary>Наборы строк паспорта — источник кандидатов, если он там есть.</summary>
    [Parameter] public DataSet? PassportData { get; set; }

    /// <summary>
    /// Редактируемый объект: из него берутся значения фильтров типа parameter.
    /// null в фильтре журнала — там нет редактируемого объекта, а вложенные
    /// &lt;filter&gt; в фильтре встречаются только константных типов.
    /// </summary>
    [Parameter] public PresentationObject? Owner { get; set; }

    /// <summary>
    /// Режим множественного выбора — колонка галочек вместо одиночного клика по
    /// строке. Веб-аналог SelectionForm(..., showCheckboxes: true).
    /// </summary>
    [Parameter] public bool Multiselect { get; set; }

    /// <summary>
    /// Что было отмечено до открытия — переживает повторный показ диалога после
    /// неудачной проверки выбора (тот же приём, что у PricelistCloneDialog:
    /// компонент создаётся заново, состояние иначе терялось бы). null — ничего
    /// не отмечено, обычное открытие.
    /// </summary>
    [Parameter] public IReadOnlyList<DataRow>? InitialSelectedRows { get; set; }

    /// <summary>Выбранная строка; null — пользователь ничего не выбрал. Не используется в Multiselect.</summary>
    public DataRow? SelectedRow { get; private set; }

    /// <summary>Отмеченные строки в режиме Multiselect.</summary>
    public IReadOnlyList<DataRow> SelectedRows => _selectedRows.ToList();

    private readonly HashSet<DataRow> _selectedRows = new();
    private DataTable? _data;
    private IReadOnlyList<Entity.Attribute> _columns = Array.Empty<Entity.Attribute>();
    private string? _error;

    protected override void OnInitialized()
    {
        try
        {
            Entity entity = EntityManager.GetEntity(Picker.EntityName);
            _columns = entity.SortedAttributes;
            _data = PickerData.Candidates(Picker, PassportData, Owner);

            if (InitialSelectedRows != null)
                foreach (DataRow row in InitialSelectedRows)
                    _selectedRows.Add(row);
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    private bool IsRowSelected(DataRow row) =>
        Multiselect ? _selectedRows.Contains(row) : ReferenceEquals(row, SelectedRow);

    private void RowClicked(DataRow row)
    {
        if (Multiselect)
            ToggleRow(row, !_selectedRows.Contains(row));
        else
            SelectedRow = row;
    }

    private void ToggleRow(DataRow row, object? isChecked)
    {
        bool on = isChecked is bool b && b;
        if (on)
            _selectedRows.Add(row);
        else
            _selectedRows.Remove(row);
    }

    private static string Display(DataRow row, string column)
    {
        if (!row.Table.Columns.Contains(column))
            return "";
        object v = row[column];
        return v == DBNull.Value ? "" : v.ToString() ?? "";
    }
}
