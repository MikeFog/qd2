@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@inject NavigationManager Nav

@*
    Один узел дерева меню, рекурсивно рисующий своих детей. Компонент, а не
    развёрнутый цикл в NavMenu.razor — потому что глубина дерева меню заранее
    не ограничена (в десктопе это ToolStripMenuItem.DropDownItems, тоже
    рекурсия, см. MenuManager.CreateChildrenMenus).
*@

@if (Node.IsSeparator)
{
    <div class="nav-separator"></div>
}
else if (Node.Children.Count > 0)
{
    <div class="nav-item nav-group">
        <button type="button" class="nav-link" @onclick="() => _expanded = !_expanded">
            <span class="nav-caret">@(_expanded ? "▾" : "▸")</span>
            @Node.Name
        </button>
    </div>
    @if (_expanded)
    {
        <div class="nav-children">
            @foreach (var child in Node.Children)
            {
                <MenuNodeView Node="child" />
            }
        </div>
    }
}
else
{
    <div class="nav-item">
        <button type="button" class="nav-link" disabled="@(!Node.Enabled)" @onclick="Navigate">
            @Node.Name
        </button>
    </div>
}

@code {
    [Parameter, EditorRequired] public MenuNode Node { get; set; } = default!;

    private bool _expanded;

    private void Navigate()
    {
        if (string.IsNullOrEmpty(Node.CodeName))
            return;

        // «Выход» — выход из сеанса, как кнопка «Выйти» в верхней полосе (MainLayout).
        if (string.Equals(Node.CodeName, MenuRoutes.Exit, StringComparison.OrdinalIgnoreCase))
        {
            SecurityManager.Clear();
            return;
        }

        // Пункт меню едет в адресе параметром: правило ManagerFilter и заголовок
        // привязаны к пункту, а не к сущности. Точка в codeName (miStats.X) в
        // значении query-параметра безопасна, в отличие от сегмента пути.
        if (MenuRoutes.SimpleJournal.TryGetValue(Node.CodeName, out JournalRoute? journal))
            Nav.NavigateTo($"/journal/{journal.EntityId}?menu={Uri.EscapeDataString(Node.CodeName)}");
        else if (MenuRoutes.Browser.ContainsKey(Node.CodeName))
            Nav.NavigateTo($"/browser/{Uri.EscapeDataString(Node.CodeName)}");
        else if (ScreenRoutes.Screens.TryGetValue(Node.CodeName, out string? screen))
            Nav.NavigateTo(screen);
        else
            Nav.NavigateTo($"/todo/{Uri.EscapeDataString(Node.CodeName)}/{Uri.EscapeDataString(Node.Name)}");
    }
}
