@inherits LayoutComponentBase
@implements IDisposable
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@inject UserSession Session
@inject BusyService Busy
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation

@*
    Оболочка приложения: слева дерево меню, сверху полоса с текущим
    пользователем, в центре экран.

    Пользователь живёт в верхней полосе, а не на стартовой странице: он нужен
    виден всегда, на любом экране — это обычное правило делового приложения и
    заодно ответ на вопрос «под кем я сейчас работаю», важный там, где у
    сотрудников разные права.
*@

<div class="shell">
    <aside class="shell-nav">
        <NavMenu />
    </aside>

    <div class="shell-main">
        <header class="shell-top">
            @if (Session.User is { } user)
            {
                <div class="shell-user">
                    <span class="shell-user-name">@UserName(user)</span>
                    <select class="form-select form-select-sm shell-language" aria-label="@(Tr.T("Язык интерфейса"))"
                            value="@Language" @onchange="ChangeLanguage">
                        @foreach (var language in WebLanguage.Available)
                        {
                            <option value="@language.Code">@language.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>@Tr.T("Выйти")</button>
                </div>
            }
        </header>

        @* Ключ — язык и пользователь: при их смене экран создаётся заново. Иначе
           страница, у которой не поменялись параметры, осталась бы на прежнем
           языке, а открытая до автологина — с «вы не вошли в систему». *@
        <main class="shell-content" @key="ScreenKey">
            @Body
        </main>
    </div>
</div>

@* Один на всё приложение — рисует диалоги, открытые через DialogService. *@
<DialogHost />

@* Один на всё приложение — меню действий над объектами, см. ActionMenuService. *@
<ActionMenuHost />

@* Слой ожидания — см. BusyService. Накрывает всё окно, включая меню и
   диалоги. Мышь блокируется сразу, а курсор и полоса появляются с задержкой
   (CSS): быстрая загрузка не должна мигать. *@
@if (Busy.IsBusy)
{
    <div class="shell-busy">
        <div class="shell-busy-indicator" role="status" aria-label="@(Tr.T("Выполняется загрузка"))">
            <div class="shell-busy-bar"></div>
            <div class="shell-busy-spinner spinner-border" aria-hidden="true"></div>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    @Tr.T("Произошла непредвиденная ошибка.")
    <a href="." class="reload">@Tr.T("Перезагрузить")</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Busy.Changed += OnBusyChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    // После первой интерактивной отрисовки, а не в OnInitialized: тот вызывается
    // ещё и при пререндере, где circuit нет и входить некуда.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            string query = new Uri(Navigation.Uri).Query;
            string? devUser = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(query)
                .TryGetValue("devuser", out var value) ? value.ToString() : null;
            WebLogin.TryDevAutoLogin(Session, Configuration, Environment, devUser);
        }
    }

    // Уже на диспетчере circuit (BusyService зовётся из обработчиков экранов), но
    // InvokeAsync безвреден и защищает от вызова извне.
    private void OnBusyChanged() => InvokeAsync(StateHasChanged);

    private static string UserName(SecurityManager.User user)
    {
        string full = $"{user.LastName} {user.FirstName}".Trim();
        return full.Length > 0 ? full : user.LoginName;
    }

    private void Logout() => SecurityManager.Clear();

    private string Language => Session.Language ?? WebLanguage.Default;

    private string ScreenKey => Language + "|" + Session.User?.Id;

    private void ChangeLanguage(ChangeEventArgs e)
    {
        string? language = WebLanguage.Normalize(e.Value?.ToString());
        if (language == null || language == Language)
            return;
        UserSettings.Save(WebLanguage.SettingName, language);
        Session.Language = language;
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Busy.Changed -= OnBusyChanged;
    }
}
