@inherits LayoutComponentBase
@implements IDisposable
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@inject UserSession Session
@inject BusyService Busy

@*
    Оболочка приложения: слева дерево меню, сверху полоса с текущим
    пользователем, в центре экран.

    Пользователь живёт в верхней полосе, а не на стартовой странице: он нужен
    виден всегда, на любом экране — это обычное правило делового приложения и
    заодно ответ на вопрос «под кем я сейчас работаю», важный там, где у
    сотрудников разные права.
*@

<div class="shell">
    <aside class="shell-nav">
        <NavMenu />
    </aside>

    <div class="shell-main">
        <header class="shell-top">
            @if (Session.User is { } user)
            {
                <div class="shell-user">
                    <span class="shell-user-name">@UserName(user)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>Выйти</button>
                </div>
            }
        </header>

        <main class="shell-content">
            @Body
        </main>

        @* Слой ожидания — см. BusyService. Накрывает экран, но не меню слева.
           Мышь блокируется сразу, а курсор и полоса появляются с задержкой
           (CSS): быстрая загрузка не должна мигать. *@
        @if (Busy.IsBusy)
        {
            <div class="shell-busy">
                <div class="shell-busy-indicator" role="status" aria-label="Выполняется загрузка">
                    <div class="shell-busy-bar"></div>
                    <div class="shell-busy-spinner spinner-border" aria-hidden="true"></div>
                </div>
            </div>
        }
    </div>
</div>

@* Один на всё приложение — рисует диалоги, открытые через DialogService. *@
<DialogHost />

@* Один на всё приложение — меню действий над объектами, см. ActionMenuService. *@
<ActionMenuHost />

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Busy.Changed += OnBusyChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    // Уже на диспетчере circuit (BusyService зовётся из обработчиков экранов), но
    // InvokeAsync безвреден и защищает от вызова извне.
    private void OnBusyChanged() => InvokeAsync(StateHasChanged);

    private static string UserName(SecurityManager.User user)
    {
        string full = $"{user.LastName} {user.FirstName}".Trim();
        return full.Length > 0 ? full : user.LoginName;
    }

    private void Logout() => SecurityManager.Clear();

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Busy.Changed -= OnBusyChanged;
    }
}
