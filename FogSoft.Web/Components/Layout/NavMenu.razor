@using System.Configuration
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm.Classes
@implements IDisposable
@inject UserSession Session
@inject MenuAccess Access

@*
    Дерево меню по метаданным — веб-аналог MenuManager.CreateApplicationMenu.
    Права на видимость пункта уже посчитаны процедурой UserMenuItems
    (столбец enabled), здесь только отрисовка.

    NavMenu — часть макета и рендерится один раз на весь circuit, поэтому сам
    по себе не узнаёт о входе, случившемся на странице /: подписывается на
    UserSession.Changed и перезагружает меню при каждой смене пользователя.

    Сворачивающейся «гамбургером» панели больше нет: на узком экране меню
    становится верхней полосой (см. MainLayout.razor.css). Прежний вариант
    закрывал меню при любом клике внутри него, из-за чего разворачивание
    группы тут же его и сворачивало.
*@

<div class="nav-brand">
    <span class="nav-brand-name">@Title</span>
</div>

<nav class="nav-tree">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">@Tr.T("Начало")</NavLink>
    </div>

    @foreach (var node in _menu)
    {
        <MenuNodeView Node="node" />
    }
</nav>

@code {
    // Меню берётся из MenuAccess, а не грузится здесь своим вызовом: тот же
    // список нужен серверной проверке доступа к экрану (MenuAccess.CheckJournal),
    // и грузить UserMenuItems дважды на один вход незачем.
    private IReadOnlyList<MenuNode> _menu = Array.Empty<MenuNode>();

    /// <summary>
    /// Название системы — из той же настройки, что берёт десктоп
    /// (appSettings/Title, у заказчика «АРТВИС»).
    /// </summary>
    private static string Title =>
        ConfigurationManager.AppSettings["Title"] is { Length: > 0 } title ? title : Tr.T("Система");

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        LoadMenu();
    }

    private void OnSessionChanged()
    {
        LoadMenu();
        InvokeAsync(StateHasChanged);
    }

    private void LoadMenu()
    {
        _menu = Access.Tree;
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
