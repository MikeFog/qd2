@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using FogSoft.WinForm.DataAccess
@inject DialogService Dialogs
@inject PassportDialog Passports

@*
    Движок паспорта: строит карточку объекта по XML из метаданных.

    Веб-аналог PassportForm + PageControl.CreateInstance. Путь сохранения
    повторён дословно: значения полей кладутся в PresentationObject по имени
    параметра, затем вызывается Update() — та же IUD-процедура, что и в
    десктопе, никакого своего SQL.

    Источник строк для lookup — набор из процедуры паспорта
    (PresentationObject.LoadPassportData), псевдоним набора берётся из
    атрибута source. Ровно как в PageFieldLookUp: source → DataSet.Tables[source].
*@

@if (_pages.Count == 0)
{
    <div class="alert alert-warning">У сущности нет паспорта в метаданных.</div>
}
else
{
    @* Переменная цикла НЕ должна называться page: Razor принимает @page.Caption
       за директиву @page и падает на разборе (RZ2005). *@
    @foreach (var pg in _pages)
    {
        <fieldset class="mb-3">
            @if (!string.IsNullOrEmpty(pg.Caption))
            {
                <legend class="fs-6 text-muted">@pg.Caption</legend>
            }

            @foreach (var field in pg.Fields)
            {
                <div class="mb-2">
                    <label class="form-label">
                        @field.Caption
                        @if (field.Required)
                        {
                            <span class="text-danger">*</span>
                        }
                    </label>

                    @if (field.Unsupported != null)
                    {
                        <div class="alert alert-secondary py-1 mb-0">
                            Контрол <code>@field.Unsupported</code> пока не поддержан
                            (этап 2). Значение не редактируется и не сохраняется.
                        </div>
                    }
                    else if (field.Image != null)
                    {
                        <div>
                            @if (ImageBytes(field) is { Length: > 0 } bytes)
                            {
                                <div class="mb-2">
                                    <img src="@DataUrl(bytes)" alt="@field.Caption"
                                         style="max-height:@(field.Image.Height)px; max-width:100%" />
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mb-2">Нет изображения.</div>
                            }

                            <div class="input-group input-group-sm">
                                <InputFile class="form-control" accept="image/*"
                                           OnChange="e => LoadImage(field, e)" />
                                <button type="button" class="btn btn-outline-secondary"
                                        @onclick="() => ClearImage(field)">Очистить</button>
                            </div>

                            @if (_imageError != null)
                            {
                                <div class="text-danger small mt-1">@_imageError</div>
                            }
                        </div>
                    }
                    else if (field.Selector != null)
                    {
                        <div style="max-height:40vh; overflow:auto">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr>
                                        @if (field.Selector.Multiselect)
                                        {
                                            <th style="width:2rem"></th>
                                        }
                                        @foreach (var a in SelectorColumns(field))
                                        {
                                            <th>@a.Alias</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRowView row in SelectorRows(field))
                                    {
                                        <tr>
                                            @if (field.Selector.Multiselect)
                                            {
                                                <td>
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@IsSelected(row)"
                                                           @onchange="e => ToggleSelected(field, row, e.Value)" />
                                                </td>
                                            }
                                            @foreach (var a in SelectorColumns(field))
                                            {
                                                <td>@CellText(row, a.Name)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (field.Picker != null)
                    {
                        <div class="input-group">
                            <input class="form-control" readonly value="@PickerName(field)" />
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="() => Select(field)">Выбрать</button>
                            @if (field.Picker.IsCreateNewAllowed)
                            {
                                <button type="button" class="btn btn-outline-secondary"
                                        @onclick="() => CreateNew(field)">Создать</button>
                            }
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="() => Clear(field)">Очистить</button>
                        </div>
                    }
                    else if (field.Lookup != null)
                    {
                        <select class="form-select"
                                value="@ReadString(field.Name)"
                                @onchange="e => WriteLookup(field, e.Value)">
                            @* Пустой пункт — аналог пустой строки, которую
                               LookUp.DataSource вставляет при IsNullable. *@
                            @if (!field.Required)
                            {
                                <option value=""></option>
                            }
                            @foreach (DataRowView row in RowsFor(field))
                            {
                                <option value="@AsText(row[field.Lookup.ColumnWithId])">@DisplayOf(row)</option>
                            }
                        </select>
                    }
                    else if (IsBoolean(field))
                    {
                        <div>
                            <input type="checkbox" class="form-check-input"
                                   checked="@ReadBool(field.Name)"
                                   @onchange="e => WriteBool(field.Name, e.Value)" />
                        </div>
                    }
                    else
                    {
                        <input class="form-control"
                               value="@ReadString(field.Name)"
                               @onchange="e => WriteString(field.Name, e.Value)" />
                    }
                </div>
            }
        </fieldset>
    }
}

@code {
    /// <summary>Объект, который редактируется. Может быть новым (NewObject).</summary>
    [Parameter, EditorRequired] public PresentationObject Object { get; set; } = default!;

    /// <summary>XML паспорта из метаданных сущности.</summary>
    [Parameter, EditorRequired] public string? Xml { get; set; }

    /// <summary>
    /// Сущность — нужна только для обязательности полей: она берётся из
    /// nullability колонок, как в PageField.
    /// </summary>
    [Parameter] public Entity? Entity { get; set; }

    /// <summary>Новый объект: влияет на атрибут isMandatoryOnCreate.</summary>
    [Parameter] public bool IsNew { get; set; }

    /// <summary>
    /// Наборы строк для lookup-ов — результат PresentationObject.LoadPassportData().
    /// null, если у сущности нет процедуры паспорта.
    /// </summary>
    [Parameter] public DataSet? Data { get; set; }

    private IReadOnlyList<PassportPage> _pages = Array.Empty<PassportPage>();

    protected override void OnParametersSet()
    {
        _pages = PassportSchema.Parse(Xml, Entity, IsNew);
        PreselectRequired();
    }

    /// <summary>
    /// У обязательного lookup-а пустого пункта нет, поэтому незаполненное
    /// значение показать нечем. Десктоп в этом случае стоит на первой строке
    /// списка и сохраняет именно её: присвоение LookUp.DataSource выбирает
    /// нулевой индекс и поднимает SelectedItemChanged. Повторяем это явно —
    /// иначе выпадающий список выглядел бы пустым, а сохранение отклонялось
    /// бы как незаполненное.
    /// </summary>
    private void PreselectRequired()
    {
        foreach (var pg in _pages)
            foreach (var field in pg.Fields)
            {
                if (field.Lookup == null || field.Unsupported != null || !field.Required)
                    continue;
                if (ReadString(field.Name).Length > 0)
                    continue;

                foreach (DataRowView row in RowsFor(field))
                {
                    Object[field.Name] = row[field.Lookup.ColumnWithId];
                    break;
                }
            }
    }

    private bool IsBoolean(PassportField f) =>
        string.Equals(f.XmlType, "boolean", StringComparison.OrdinalIgnoreCase);

    private string ReadString(string name) => AsText(Object[name]);

    private void WriteString(string name, object? value) =>
        Object[name] = value?.ToString() ?? "";

    private bool ReadBool(string name)
    {
        object? v = Object[name];
        return v != null && v != DBNull.Value && Convert.ToBoolean(v);
    }

    private void WriteBool(string name, object? value) =>
        Object[name] = value is bool b ? b : false;

    private static string AsText(object? v) =>
        v == null || v == DBNull.Value ? "" : v.ToString() ?? "";

    private static string CellText(DataRowView row, string column) =>
        row.Row.Table.Columns.Contains(column) ? AsText(row[column]) : "";

    // ---------- lookup ----------

    /// <summary>
    /// Строки списка. Повторяет PageFieldLookUp / PageFieldDependentLookup:
    /// независимый lookup показывает весь набор, зависимый — набор,
    /// отфильтрованный выражением из атрибута filter по значению родителя, а
    /// при незаполненном родителе не показывает ничего (в десктопе там
    /// Lookup.DataSource = null).
    /// </summary>
    private DataView RowsFor(PassportField field)
    {
        PassportLookup lookup = field.Lookup!;

        if (Data == null || !Data.Tables.Contains(lookup.Source))
            return Empty;

        DataTable table = Data.Tables[lookup.Source]!;
        if (lookup.ParentLookupName == null)
            return new DataView(table);

        string parent = AsText(Object[lookup.ParentLookupName]);
        if (parent.Length == 0)
            return Empty;

        return new DataView(table) { RowFilter = string.Format(lookup.ParentFilter ?? "", parent) };
    }

    /// <summary>Пустой список — в десктопе это Lookup.DataSource = null.</summary>
    private static DataView Empty => new DataTable().DefaultView;

    private string DisplayOf(DataRowView row) =>
        row.Row.Table.Columns.Contains(Constants.Parameters.Name)
            ? AsText(row[Constants.Parameters.Name])
            : "(в наборе нет колонки name)";

    private void WriteLookup(PassportField field, object? value)
    {
        PassportLookup lookup = field.Lookup!;
        string selected = value?.ToString() ?? "";

        // В процедуру должно уйти значение того же типа, что в наборе строк
        // (int, а не строка из разметки), поэтому берём его из самой строки.
        object result = DBNull.Value;
        if (selected.Length > 0)
            foreach (DataRowView row in RowsFor(field))
                if (AsText(row[lookup.ColumnWithId]) == selected)
                {
                    result = row[lookup.ColumnWithId];
                    break;
                }

        Object[field.Name] = result;
        ResetDependent(field.Name);
    }

    /// <summary>
    /// Смена родителя меняет состав зависимого списка, поэтому его значение
    /// нужно выбрать заново — иначе в процедуру уйдёт значение, которого в
    /// новом списке нет. Десктоп делает это неявно: присвоение DataSource
    /// переводит комбо на первый пункт. Зависимости бывают цепочками
    /// (радиостанция → модуль → прайс-лист), поэтому обход рекурсивный.
    /// </summary>
    private void ResetDependent(string parentName)
    {
        foreach (var pg in _pages)
            foreach (var field in pg.Fields)
            {
                if (field.Lookup?.ParentLookupName != parentName)
                    continue;

                object result = DBNull.Value;
                if (field.Required)
                    foreach (DataRowView row in RowsFor(field))
                    {
                        result = row[field.Lookup.ColumnWithId];
                        break;
                    }

                Object[field.Name] = result;
                ResetDependent(field.Name);
            }
    }

    // ---------- objectPicker ----------

    // Имя выбранного объекта показывается вместо идентификатора, но само
    // значение в объекте остаётся идентификатором. Разрешение имени стоит
    // обращения к базе (ObjectPicker2.SelectObject делает то же самое),
    // поэтому результат держится до смены значения.
    private readonly Dictionary<string, string> _pickerNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _pickerNamesFor = new(StringComparer.OrdinalIgnoreCase);

    private string PickerName(PassportField field)
    {
        string id = ReadString(field.Name);
        if (_pickerNamesFor.TryGetValue(field.Name, out string? resolvedFor) && resolvedFor == id)
            return _pickerNames[field.Name];

        string name = PickerData.NameOf(field.Picker!, Data, Object[field.Name]);
        _pickerNames[field.Name] = name;
        _pickerNamesFor[field.Name] = id;
        return name;
    }

    private async Task Select(PassportField field)
    {
        ObjectSelector? selector = null;

        RenderFragment body = builder =>
        {
            builder.OpenComponent<ObjectSelector>(0);
            builder.AddComponentParameter(1, nameof(ObjectSelector.Picker), field.Picker);
            builder.AddComponentParameter(2, nameof(ObjectSelector.PassportData), Data);
            builder.AddComponentParameter(3, nameof(ObjectSelector.Owner), Object);
            builder.AddComponentReferenceCapture(4, c => selector = (ObjectSelector)c);
            builder.CloseComponent();
        };

        if (await Dialogs.ShowAsync("Выбрать объект", body, okText: "Выбрать") != DialogOutcome.Ok)
            return;

        // Пустой выбор — не команда очистить: десктоп по OK без выделенной
        // строки оставляет прежнее значение (selector.SelectedObject == null,
        // ApplyChanges его не пишет). Очистка — отдельная кнопка.
        if (selector?.SelectedRow == null)
            return;

        Entity entity = EntityManager.GetEntity(field.Picker!.EntityName);
        Store(field, entity.CreateObject(selector.SelectedRow));
    }

    private async Task CreateNew(PassportField field)
    {
        Entity entity = EntityManager.GetEntity(field.Picker!.EntityName);
        PresentationObject created = entity.NewObject;

        if (await Passports.ShowAsync(created, isNew: true))
            Store(field, created);
    }

    private void Clear(PassportField field)
    {
        // В десктопе это btnClear: очищается показанное имя и снимается выбор,
        // то есть в процедуру значение не уходит вовсе.
        Object[field.Name] = DBNull.Value;
        Forget(field);
    }

    /// <summary>
    /// Кладёт выбранный объект так же, как ObjectPicker2 + ApplyChanges:
    /// в параметры уходит первый столбец первичного ключа, а не весь объект.
    /// </summary>
    private void Store(PassportField field, PresentationObject selected)
    {
        Object[field.Name] = selected.IDs[0] ?? (object)DBNull.Value;
        Forget(field);
    }

    private void Forget(PassportField field)
    {
        _pickerNames.Remove(field.Name);
        _pickerNamesFor.Remove(field.Name);
    }

    // ---------- selector ----------

    // Колонка с состоянием галочки. Имя то же, что в SmartGrid.COL_IsSelected:
    // его заполняет процедура паспорта (в massmediaPassport — CASE ... END as
    // isObjectSelected), и именно по нему открытая карточка показывает, что уже
    // связано с объектом.
    private const string SelectedColumn = "isObjectSelected";

    /// <summary>
    /// Что отметили и что сняли — по одному набору на selector. Ровно та же
    /// пара списков, что копит SmartGrid.CheckedStatusChanged: повторная
    /// отметка снятого не добавляет объект, а убирает его из снятых.
    /// </summary>
    private sealed class SelectorChanges
    {
        public readonly List<PresentationObject> Added = new();
        public readonly List<PresentationObject> Removed = new();
    }

    private readonly Dictionary<string, SelectorChanges> _selectorChanges =
        new(StringComparer.OrdinalIgnoreCase);

    private SelectorChanges ChangesOf(PassportField field)
    {
        // Ключ — подпись: у selector-а может не быть имени (в паспорте
        // радиостанции его нет), а на странице их бывает несколько.
        string key = field.Name.Length > 0 ? field.Name : field.Caption;
        if (!_selectorChanges.TryGetValue(key, out SelectorChanges? changes))
            _selectorChanges[key] = changes = new SelectorChanges();
        return changes;
    }

    private IReadOnlyList<Entity.Attribute> SelectorColumns(PassportField field) =>
        EntityManager.GetEntity(field.Selector!.EntityName).SortedAttributes;

    private DataView SelectorRows(PassportField field)
    {
        string source = field.Selector!.Source;
        if (Data == null || !Data.Tables.Contains(source))
            return Empty;

        DataTable table = Data.Tables[source]!;

        // Набор может прийти без колонки состояния — тогда не отмечено ничего.
        // SmartGrid.DataSource делает то же самое.
        if (!table.Columns.Contains(SelectedColumn))
            table.Columns.Add(new DataColumn(SelectedColumn, typeof(bool)) { DefaultValue = false });

        return new DataView(table);
    }

    private static bool IsSelected(DataRowView row)
    {
        object value = row[SelectedColumn];
        return value != DBNull.Value && Convert.ToBoolean(value);
    }

    private void ToggleSelected(PassportField field, DataRowView row, object? value)
    {
        bool on = value is bool b && b;
        row[SelectedColumn] = on;

        PresentationObject obj = EntityManager.GetEntity(field.Selector!.EntityName).CreateObject(row.Row);
        SelectorChanges changes = ChangesOf(field);

        if (on)
        {
            if (!changes.Removed.Remove(obj))
                changes.Added.Add(obj);
        }
        else
        {
            if (!changes.Added.Remove(obj))
                changes.Removed.Add(obj);
        }
    }

    /// <summary>
    /// Отдаёт накопленное редактируемому объекту — дословно то, что делает
    /// ObjectsSelector.ApplyChanges. Записывает не здесь: в базу это уйдёт
    /// вместе с сохранением самого объекта, см. ObjectContainer.SubmitChildrenChanges.
    /// </summary>
    public void ApplyChanges()
    {
        if (Object is not IParentObject parent)
            return;

        foreach (var pg in _pages)
            foreach (var field in pg.Fields)
            {
                if (field.Selector == null || field.Unsupported != null)
                    continue;

                SelectorChanges changes = ChangesOf(field);
                if (changes.Added.Count == 0 && changes.Removed.Count == 0)
                    continue;

                parent.SetChildrenChanges(
                    EntityManager.GetEntity(field.Selector.EntityName),
                    new List<PresentationObject>(changes.Added),
                    new List<PresentationObject>(changes.Removed));

                changes.Added.Clear();
                changes.Removed.Clear();
            }
    }

    // ---------- image ----------

    // Подпись руководителя и подобные картинки весят килобайты; ограничение
    // нужно только чтобы отказ был внятным, а не обрывом соединения.
    private const long MaxImageBytes = 4 * 1024 * 1024;

    private string? _imageError;

    /// <summary>
    /// Байты картинки лежат в том же параметре, что уходит в процедуру, и
    /// попадают туда из строки журнала. Важно: пока пользователь ничего не
    /// делал, значение не трогается вовсе — иначе сохранение карточки стирало
    /// бы подпись, которую никто не редактировал.
    /// </summary>
    private byte[]? ImageBytes(PassportField field) => Object[field.Name] as byte[];

    /// <summary>
    /// Тип определяется по сигнатуре файла, а не по расширению: в базе лежит
    /// то, что когда-то сохранил десктоп (он писал BMP), а загрузить могут
    /// что угодно. Десктоп читает через Image.FromStream, который формат
    /// тоже определяет сам, так что совместимость не теряется.
    /// </summary>
    private static string DataUrl(byte[] bytes) =>
        $"data:{MediaType(bytes)};base64,{Convert.ToBase64String(bytes)}";

    private static string MediaType(byte[] b)
    {
        if (b.Length > 1 && b[0] == 0x42 && b[1] == 0x4D) return "image/bmp";
        if (b.Length > 3 && b[0] == 0x89 && b[1] == 0x50) return "image/png";
        if (b.Length > 2 && b[0] == 0xFF && b[1] == 0xD8) return "image/jpeg";
        if (b.Length > 2 && b[0] == 0x47 && b[1] == 0x49) return "image/gif";
        return "application/octet-stream";
    }

    private async Task LoadImage(PassportField field, InputFileChangeEventArgs args)
    {
        _imageError = null;
        try
        {
            IBrowserFile file = args.File;
            using Stream source = file.OpenReadStream(MaxImageBytes);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);

            // Кладём файл как есть, без перекодирования: десктоп сохранял BMP
            // (Image.Save(stream, ImageFormat.Bmp)), но читает Image.FromStream,
            // который разбирает и PNG, и JPEG. Перекодирование потребовало бы
            // System.Drawing на сервере и ничего бы не дало.
            Object[field.Name] = memory.ToArray();
        }
        catch (Exception ex)
        {
            _imageError = ErrorPresenter.Describe(ex);
        }
    }

    private void ClearImage(PassportField field)
    {
        // Ровно как BtnDelete_Click + ApplyChanges в десктопе: пустая картинка
        // уходит в процедуру как null, а не как отсутствие параметра.
        Object[field.Name] = null;
        _imageError = null;
    }

    /// <summary>
    /// Первое нарушение обязательности или null. Аналог ValidateUserInput +
    /// PassportException: текст берётся из того же ключа iMessage, что и в
    /// десктопе, с той же подстановкой подписи контрола.
    ///
    /// Проверяются только lookup и objectPicker: обязательность обычных полей
    /// в вебе пока не проверяется вообще, и вводить её здесь — отдельная
    /// работа, которая начнёт отклонять сохранения, проходящие сегодня.
    /// </summary>
    public string? Validate()
    {
        foreach (var pg in _pages)
            foreach (var field in pg.Fields)
            {
                if (field.Unsupported != null || !field.Required)
                    continue;
                if (field.Lookup == null && field.Picker == null)
                    continue;

                if (ReadString(field.Name).Length > 0)
                    continue;

                MessageAccessor.Parameters = new Dictionary<string, object>(
                    1, StringComparer.InvariantCultureIgnoreCase) { { "controlName", field.Caption } };
                return MessageAccessor.GetMessage("MandatoryFieldViolation");
            }

        return null;
    }
}
