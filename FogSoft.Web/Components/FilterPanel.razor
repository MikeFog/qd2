@using System.Data
@using System.Globalization
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using Merlin.Classes
@inject DialogService Dialogs

@*
    Панель отбора: сворачивающийся блок с полями фильтра, галочкой
    «использовать» у каждого и общей кнопкой «Применить».

    Выделена из Journal.razor, когда в отборе понадобились древовидные экраны
    (Browser.razor) — тот же разрез, что раньше сделан со списком
    (Journal.razor → ObjectList.razor, коммит c15fd53). Отрисовка не знает,
    откуда взялись страницы фильтра, словарь значений и набор строк для
    lookup/objectPicker — всё это и обратный вызов «применить» передаёт
    владелец экрана: у журнала список читается из сущности, у дерева —
    перестраивается с корня (ObjectsIterator.CreateChilObject раздаёт копию
    фильтра каждому уже созданному дочернему объекту, поэтому частичное
    обновление оставило бы старые узлы со старым отбором).

    Values меняется на месте — та же ссылка, что владелец отдаёт в
    GetContent (ObjectsIterator._filter / Entity.GetContent), без копирования.
*@

@if (VisiblePages.Count > 0)
{
    <section class="filter">
        <button type="button" class="filter-toggle" @onclick="() => _filterOpen = !_filterOpen">
            <span class="filter-caret">@(_filterOpen ? "▾" : "▸")</span>
            @Tr.T("Отбор")
        </button>

        @if (_filterOpen)
        {
            <div class="filter-body">
                @* Страницы отбора — вкладками, как tabPassport в десктопной FilterForm
                   (та же TabbedForm, что у паспорта). Одна страница — без вкладок. *@
                @if (VisiblePages.Count > 1)
                {
                    <div class="tabs" role="tablist">
                        @for (int i = 0; i < VisiblePages.Count; i++)
                        {
                            int index = i;
                            <button type="button" role="tab"
                                    class="tab @(index == _activePage ? "tab-active" : "")"
                                    @onclick="() => _activePage = index">
                                @(VisiblePages[index].Caption is { Length: > 0 } c ? c : Tr.Format("Страница {0}", index + 1))
                            </button>
                        }
                    </div>
                }

                <div class="filter-grid">
                    @foreach (var field in CurrentPage.Fields)
                    {
                        @if (field.Unsupported != null)
                        {
                            @* Проверка Unsupported тут обязательна и должна идти первой:
                               без неё lookup, у которого источник задан через entity, а
                               не через source, молча превратился бы в поле для ввода
                               текста — и туда можно было бы написать что угодно вместо
                               выбора из списка. *@
                            <div class="filter-note">
                                @Tr.Format("{0} — {1} в фильтре пока не поддержан (этап 2).", field.Caption, field.Unsupported)
                            </div>
                        }
                        else if (field.Type is { IsBoolean: true })
                        {
                            <div class="filter-check">
                                <input type="checkbox" class="form-check-input" id="@("f_" + field.Name)"
                                       checked="@GetFilterBool(field.Name)"
                                       @onchange="e => SetFilterBool(field.Name, e.Value)" />
                                <label class="form-check-label" for="@("f_" + field.Name)">@field.Caption</label>
                            </div>
                        }
                        else
                        {
                            @* Галочка «использовать» — левая колонка десктопного
                               PageField: в режиме фильтра там не подпись, а CheckBox,
                               и параметр уходит в процедуру только когда он отмечен
                               (ValueShouldBeSet). *@
                            <input type="checkbox" class="form-check-input"
                                   disabled="@IsManagerLocked(field)"
                                   checked="@IsFilterUsed(field.Name)"
                                   @onchange="e => UseFilter(field, e.Value)" />
                            <label class="filter-label">@field.Caption</label>

                            @if (field.Lookup != null)
                            {
                                @* Пустого пункта в списке нет: в фильтре пустоту
                                   выражает снятая галочка, а не пустая строка
                                   (десктопное Lookup.IsNullable = isNullable &&
                                   PageType == Passport, то есть всегда false в фильтре). *@
                                <select class="form-select form-select-sm @InvalidClass(field)"
                                        disabled="@(!IsFilterUsed(field.Name))"
                                        value="@FilterLookupValue(field)"
                                        @onchange="e => SetFilterLookup(field, e.Value)">
                                    @foreach (DataRowView row in FilterLookupRows(field))
                                    {
                                        <option value="@AsFilterText(row[field.Lookup.ColumnWithId])">@FilterLookupDisplay(row)</option>
                                    }
                                </select>
                            }
                            else if (field.Picker != null)
                            {
                                @* Кнопки «Создать» в фильтре нет — PageFieldObjectPicker
                                   гасит её при PageTypes.Filter независимо от
                                   isCreateNewAllowed. *@
                                <div class="input-group input-group-sm">
                                    <input class="form-control @InvalidClass(field)" readonly
                                           disabled="@(!IsFilterUsed(field.Name) || IsManagerLocked(field))"
                                           value="@FilterPickerName(field)" />
                                    <button type="button" class="btn btn-outline-secondary"
                                            disabled="@(!IsFilterUsed(field.Name) || IsManagerLocked(field))"
                                            @onclick="() => SelectFilterPicker(field)"><i class="bi bi-search" aria-hidden="true"></i>@Tr.T("Выбрать")</button>
                                </div>
                            }
                            else
                            {
                                <input type="@InputType(field)" class="form-control form-control-sm @InvalidClass(field)"
                                       disabled="@(!IsFilterUsed(field.Name))"
                                       value="@GetFilterText(field)"
                                       @onchange="e => SetFilterText(field, e.Value)" />
                            }
                        }
                    }
                </div>

                <div class="filter-foot">
                    @if (_invalid.Count > 0)
                    {
                        <div class="alert alert-danger filter-error" role="alert">
                            @Tr.Format("Не заполнено: {0}.", string.Join(", ", InvalidCaptions())) @Tr.T("Задайте значение или снимите галочку.")
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ApplyClicked"><i class="bi bi-funnel" aria-hidden="true"></i>@Tr.T("Применить")</button>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PassportPage> Pages { get; set; } = Array.Empty<PassportPage>();

    /// <summary>Значения фильтра. Меняются на месте — владелец отдаёт ту же ссылку в GetContent.</summary>
    [Parameter, EditorRequired] public Dictionary<string, object> Values { get; set; } = default!;

    /// <summary>
    /// Наборы строк для lookup/objectPicker: результат Globals.PrepareForFilter
    /// у владельца. null, если у сущности/сценария нет процедуры фильтра —
    /// тогда lookup/objectPicker грузят список сами по entity.
    /// </summary>
    [Parameter] public DataSet? FilterData { get; set; }

    /// <summary>
    /// «Применить» нажата. Что перечитать — решает владелец: журналу
    /// достаточно перечитать список, дереву нужно перестроиться с корня.
    /// </summary>
    [Parameter] public EventCallback Apply { get; set; }

    /// <summary>
    /// Экран открыт из пункта меню, который десктоп ведёт через
    /// <c>ManagerFilter.FilterClick</c> (<c>JournalRoute.ManagerFilter</c>).
    /// Тогда поле «Менеджер» доступно только пользователю с правом на чужие или
    /// групповые акции — см. <see cref="IsManagerLocked"/>.
    /// </summary>
    [Parameter] public bool RestrictManager { get; set; }

    private bool _filterOpen = true;

    // Открытая вкладка — аналог tabPassport.SelectedIndex. Значения полей
    // остальных вкладок никуда не деваются: они лежат в общем словаре Values и
    // уходят в процедуру вместе с открытой (десктопный ApplyChanges обходит
    // все страницы).
    private int _activePage;

    /// <summary>
    /// Страницы, на которых есть что показать. Страница без единого поля
    /// вкладки не получает (в метаданных сейчас таких нет).
    /// </summary>
    private IReadOnlyList<PassportPage> VisiblePages =>
        _visiblePages ??= Pages.Where(p => p.Fields.Count > 0).ToList();

    private IReadOnlyList<PassportPage>? _visiblePages;

    private PassportPage CurrentPage => VisiblePages[Math.Min(_activePage, VisiblePages.Count - 1)];

    // Запасной путь lookup-а по entity и разрешение имени objectPicker бьют в
    // базу, поэтому кэшируются на время жизни компонента — иначе каждый
    // перерендер (например, ввод в соседнем поле фильтра) читал бы их заново.
    private readonly Dictionary<string, DataTable> _filterLookupCache =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _filterPickerNames =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _filterPickerNamesFor =
        new(StringComparer.OrdinalIgnoreCase);

    // Владелец пересобирает Pages (новая ссылка) только при смене сущности
    // или сценария; на остальных перерендерах экрана параметр приходит той же
    // ссылкой. Кэши привязаны к конкретному набору полей, поэтому сбрасываем
    // их по смене ссылки, а не при каждом OnParametersSet.
    private IReadOnlyList<PassportPage>? _cachedFor;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_cachedFor, Pages))
            return;

        _cachedFor = Pages;
        _visiblePages = null;
        _activePage = 0;
        _filterLookupCache.Clear();
        _filterPickerNames.Clear();
        _filterPickerNamesFor.Clear();
    }

    // ---------- Проверка перед применением ----------

    // Решение владельца продукта (2026-09-23): отмеченная галочка «использовать»
    // без значения — ошибка ввода, а не «отбора нет». Молча подставить NULL или
    // пропустить параметр значило бы показать данные не за тот период / без
    // отбора, и пользователь мог бы этого не заметить. Правило одно для всех
    // полей со значением: дата, время, число, текст, список, выбор объекта.
    // Десктоп дату и время стереть не даёт, а objectPicker без выбора молча
    // пропускает (PageFieldObjectPicker.ApplyChanges) — здесь веб строже.

    private readonly HashSet<string> _invalid = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Проверить отбор перед чтением данных: у каждой отмеченной галочки должно
    /// быть значение. Не прошло — поля подсвечиваются, открывается вкладка с
    /// первым из них, возвращается false, и владелец данные не читает. Зовётся
    /// из «Применить» и владельцами экрана перед «Обновить»: оба читают текущие
    /// значения отбора.
    /// </summary>
    public bool Validate()
    {
        _invalid.Clear();
        int firstPage = -1;
        for (int i = 0; i < VisiblePages.Count; i++)
            foreach (PassportField field in VisiblePages[i].Fields)
            {
                if (!NeedsValue(field) || !Values.TryGetValue(field.Name, out object? value) || !IsEmpty(value))
                    continue;
                _invalid.Add(field.Name);
                if (firstPage < 0)
                    firstPage = i;
            }

        if (_invalid.Count == 0)
            return true;

        _filterOpen = true;
        _activePage = firstPage;
        StateHasChanged();
        return false;
    }

    private async Task ApplyClicked()
    {
        if (Validate())
            await Apply.InvokeAsync();
    }

    // Поля, у которых галочка означает «отобрать по значению». Булевы флажки
    // сами и есть значение; неподдержанные поля не рисуются, заполнить их нечем.
    private static bool NeedsValue(PassportField field) =>
        field.Unsupported == null && !field.IsLabel && field.Type is not { IsBoolean: true };

    private static bool IsEmpty(object? value) =>
        value == null || value == DBNull.Value || value is string s && string.IsNullOrWhiteSpace(s);

    private string InvalidClass(PassportField field) => _invalid.Contains(field.Name) ? "is-invalid" : "";

    private IEnumerable<string> InvalidCaptions() =>
        VisiblePages.SelectMany(p => p.Fields)
            .Where(f => _invalid.Contains(f.Name))
            .Select(f => f.Caption.Trim().TrimEnd(':'));

    /// <summary>
    /// Правило десктопного <c>ManagerFilter.OnLoad</c>: поле <c>managerID</c>
    /// (а если его нет — <c>userID</c>) вместе со своей галочкой доступно, только
    /// если у пользователя есть право смотреть чужие или групповые акции.
    /// Значение при этом не сбрасывается: у «Баланса» и «Оплат» по умолчанию
    /// стоит <c>LoggedUser</c>, и заблокированное поле так и остаётся на нём.
    ///
    /// Поле ищется по имени, как <c>FindControl</c>, и правило действует, только
    /// если это objectPicker (десктоп делает <c>as ObjectPicker2</c>: managerID
    /// другого вида не заменяется userID). Это расхождение интерфейса, а не
    /// защита: процедуры сами проверяют права по <c>@loggedUserID</c>.
    /// </summary>
    private bool IsManagerLocked(PassportField field)
    {
        if (!RestrictManager || SecurityManager.LoggedUser is not { } user)
            return false;

        if (!ReferenceEquals(field, ManagerField))
            return false;

        return !(user.IsRightToViewForeignActions() || user.IsRightToViewGroupActions());
    }

    /// <summary>Поле «Менеджер» текущего набора страниц, если оно вообще есть и это objectPicker.</summary>
    private PassportField? ManagerField
    {
        get
        {
            if (!ReferenceEquals(_managerFieldFor, Pages))
            {
                _managerFieldFor = Pages;
                PassportField? found = FindField("managerID") ?? FindField("userID");
                _managerField = found is { Picker: not null, Unsupported: null } ? found : null;
            }
            return _managerField;
        }
    }

    private IReadOnlyList<PassportPage>? _managerFieldFor;
    private PassportField? _managerField;

    private PassportField? FindField(string name)
    {
        foreach (var pg in Pages)
            foreach (var f in pg.Fields)
                if (string.Equals(f.Name, name, StringComparison.OrdinalIgnoreCase))
                    return f;
        return null;
    }

    /// <summary>
    /// Значения фильтра хранятся так же, как в десктопе — словарём
    /// «имя параметра → значение», который уходит прямо в GetContent.
    /// Своей типизации не вводим: процедура ждёт тот же набор.
    /// </summary>
    private bool GetFilterBool(string name) =>
        Values.TryGetValue(name, out object? v)
        && v != null
        && bool.TryParse(v.ToString(), out bool b)
        && b;

    private void SetFilterBool(string name, object? value)
    {
        // ResolveFilterInitialValues кладёт значения строками ("True"),
        // поэтому и мы пишем строкой — иначе при сравнении фильтров
        // (ObjectsIterator.IsNewFilter) типы разъедутся.
        Values[name] = (value is bool b && b).ToString();
    }

    /// <summary>
    /// Используется ли параметр. Ровно то же, что делает десктоп: галочка в
    /// левой колонке фильтра отмечена, когда значение есть
    /// (PageField.SetValue), а неотмеченное поле из параметров удаляется
    /// (ApplyChanges при !ValueShouldBeSet).
    /// </summary>
    private bool IsFilterUsed(string name) => Values.ContainsKey(name);

    private void UseFilter(PassportField field, object? value)
    {
        _invalid.Remove(field.Name);
        if (value is bool on && on)
            Values[field.Name] = InitialFilterValue(field);
        else
            Values.Remove(field.Name);
    }

    /// <summary>
    /// Значение, которое ставится в момент, когда галочку «использовать»
    /// только что отметили.
    ///
    /// У lookup-а в фильтре нет пустого пункта — список всегда показывает
    /// первую строку (десктопное Lookup.IsNullable = false в PageTypes.Filter,
    /// а присвоение DataSource само встаёт на нулевой индекс). Не подставить
    /// её здесь означало бы разойтись с тем, что видно на экране: список
    /// показывал бы первую строку, а в процедуру ушло бы пустое значение.
    ///
    /// objectPicker пустого выбора не боится (десктопный ApplyChanges при
    /// SelectedObject == null просто не пишет параметр, даже если галочка
    /// отмечена) — значение выставляется только после «Выбрать».
    /// </summary>
    private object InitialFilterValue(PassportField field)
    {
        if (field.Lookup != null)
        {
            foreach (DataRowView row in FilterLookupRows(field))
                return row[field.Lookup.ColumnWithId];
            return DBNull.Value;
        }

        if (field.Picker != null)
            return DBNull.Value;

        return "";
    }

    private static string InputType(PassportField field) =>
        field.Type switch
        {
            { IsDate: true } => "date",
            { IsTime: true } => "time",
            { IsInteger: true } or { IsDecimal: true } or { IsMoney: true } => "number",
            _ => "text"
        };

    /// <summary>
    /// Значение для поля ввода.
    ///
    /// В словаре фильтра значения лежат строками в культуре системы — так их
    /// кладёт ResolveFilterInitialValues, и так их ждёт разбор параметров
    /// процедуры. HTML-инпуты живут по своим правилам: <c>type="date"</c>
    /// отдаёт и принимает только ISO, <c>type="time"</c> — только «ЧЧ:мм»,
    /// <c>type="number"</c> — только точку как разделитель дробной части.
    /// Поэтому все три типа переводятся туда и обратно.
    /// Это тот самый стык из раздела 7 п.5 плана, и он не теоретический:
    /// без перевода чисел ввод «0.5» падал с «The input string '0.5' was not
    /// in a correct format».
    /// </summary>
    private string GetFilterText(PassportField field)
    {
        if (!Values.TryGetValue(field.Name, out object? value) || value == null)
            return "";

        string text = value.ToString() ?? "";
        if (text.Length == 0)
            return text;

        if (field.Type is { IsDate: true })
            return DateTime.TryParse(text, out DateTime date) ? date.ToString("yyyy-MM-dd") : "";

        if (field.Type is { IsTime: true })
            return DateTime.TryParse(text, out DateTime time) ? time.ToString("HH:mm") : "";

        if (IsFractional(field))
            return decimal.TryParse(text, out decimal number)
                ? number.ToString(CultureInfo.InvariantCulture)
                : "";

        return text;
    }

    private void SetFilterText(PassportField field, object? value)
    {
        string text = value?.ToString() ?? "";
        _invalid.Remove(field.Name);

        // Обратный перевод: в процедуру должна уйти строка того же вида, что у
        // значений из метаданных, иначе один и тот же фильтр выглядел бы
        // по-разному в зависимости от того, кто его заполнил.
        if (text.Length > 0)
        {
            if (field.Type is { IsDate: true })
                text = DateTime.TryParse(text, out DateTime date) ? date.ToString() : "";
            // Время — как десктопный PageFieldTime.ApplyChanges: часы и минуты
            // на дате 01.01.1900 (параметры процедуры — datetime).
            else if (field.Type is { IsTime: true })
                text = TimeSpan.TryParse(text, CultureInfo.InvariantCulture, out TimeSpan time)
                    ? new DateTime(1900, 1, 1, time.Hours, time.Minutes, 0).ToString()
                    : "";
            else if (IsFractional(field))
                text = decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal number)
                    ? number.ToString()
                    : "";
        }

        Values[field.Name] = text;
    }

    // Целые числа разделителя не имеют, переводить нечего.
    private static bool IsFractional(PassportField field) =>
        field.Type is { IsDecimal: true } or { IsMoney: true };

    // ---------- lookup фильтра ----------

    private static string AsFilterText(object? v) =>
        v == null || v == DBNull.Value ? "" : v.ToString() ?? "";

    /// <summary>
    /// Строки списка. Готовый набор по source, если он есть в FilterData,
    /// иначе — запасной путь по entity (PickerData.LookupRows), закэшированный
    /// на время жизни компонента: без кэша каждый перерендер страницы читал бы
    /// сущность заново.
    /// </summary>
    private DataView FilterLookupRows(PassportField field)
    {
        if (!_filterLookupCache.TryGetValue(field.Name, out DataTable? table))
        {
            table = PickerData.LookupRows(field.Lookup!, FilterData) ?? new DataTable();
            _filterLookupCache[field.Name] = table;
        }
        return new DataView(table);
    }

    private static string FilterLookupDisplay(DataRowView row) =>
        row.Row.Table.Columns.Contains(Constants.Parameters.Name)
            ? AsFilterText(row[Constants.Parameters.Name])
            : Tr.T("(в наборе нет колонки name)");

    /// <summary>
    /// Значение для &lt;select&gt;. Пока галочка не отмечена, ключа в
    /// Values ещё нет — показываем первую строку списка, ровно то же
    /// значение, что InitialFilterValue поставит в момент отметки: иначе
    /// список визуально показывал бы первую строку (так уже ведёт себя HTML
    /// &lt;select&gt; без пустого пункта), пока подставленное значение с ней
    /// не совпадало бы.
    /// </summary>
    private string FilterLookupValue(PassportField field)
    {
        if (Values.TryGetValue(field.Name, out object? v) && v != null && v != DBNull.Value)
            return AsFilterText(v);

        foreach (DataRowView row in FilterLookupRows(field))
            return AsFilterText(row[field.Lookup!.ColumnWithId]);
        return "";
    }

    private void SetFilterLookup(PassportField field, object? value)
    {
        string selected = value?.ToString() ?? "";

        // В процедуру должно уйти значение того же типа, что в наборе строк
        // (int, а не строка из разметки), поэтому берём его из самой строки —
        // тот же приём, что и у lookup-а паспорта (Passport.razor.WriteLookup).
        object result = DBNull.Value;
        foreach (DataRowView row in FilterLookupRows(field))
            if (AsFilterText(row[field.Lookup!.ColumnWithId]) == selected)
            {
                result = row[field.Lookup!.ColumnWithId];
                break;
            }

        Values[field.Name] = result;
        _invalid.Remove(field.Name);
    }

    // ---------- objectPicker фильтра ----------

    /// <summary>
    /// Имя выбранного объекта. Разрешение стоит обращения к базе
    /// (PickerData.NameOf), поэтому результат держится, пока не изменится
    /// сохранённый идентификатор — тот же приём, что у objectPicker паспорта
    /// (Passport.razor.PickerName).
    /// </summary>
    private string FilterPickerName(PassportField field)
    {
        Values.TryGetValue(field.Name, out object? raw);
        string id = AsFilterText(raw);

        if (_filterPickerNamesFor.TryGetValue(field.Name, out string? resolvedFor) && resolvedFor == id)
            return _filterPickerNames[field.Name];

        string name = PickerData.NameOf(field.Picker!, FilterData, raw);
        _filterPickerNames[field.Name] = name;
        _filterPickerNamesFor[field.Name] = id;
        return name;
    }

    private async Task SelectFilterPicker(PassportField field)
    {
        if (field.Picker!.Scenario != null)
        {
            await SelectFilterPickerFromTree(field);
            return;
        }

        ObjectSelector? selector = null;

        RenderFragment body = builder =>
        {
            builder.OpenComponent<ObjectSelector>(0);
            builder.AddComponentParameter(1, nameof(ObjectSelector.Picker), field.Picker);
            builder.AddComponentParameter(2, nameof(ObjectSelector.PassportData), FilterData);
            builder.AddComponentReferenceCapture(3, c => selector = (ObjectSelector)c);
            builder.CloseComponent();
        };

        if (await Dialogs.ShowAsync(Tr.T("Выбрать объект"), body, okText: Tr.T("Выбрать")) != DialogOutcome.Ok)
            return;

        // Пустой выбор — не команда очистить: тот же случай, что и у
        // objectPicker паспорта (Passport.razor.Select). Очистка — снятие
        // галочки «использовать».
        if (selector?.SelectedRow == null)
            return;

        Entity entity = EntityManager.GetEntity(field.Picker!.EntityName);
        Values[field.Name] = entity.CreateObject(selector.SelectedRow).IDs[0] ?? (object)DBNull.Value;
        _invalid.Remove(field.Name);
        _filterPickerNames.Remove(field.Name);
        _filterPickerNamesFor.Remove(field.Name);
    }

    /// <summary>
    /// objectPicker с relationScenario: выбор из дерева сценария
    /// (ObjectPicker2.btnSelect_Click → TreeViewSelector). В процедуру уходит
    /// идентификатор выбранного узла, как <c>SelectedObject.IDs[0]</c> в
    /// PageFieldObjectPicker.ApplyChanges; имя известно сразу — его и
    /// показываем, без обращения к базе.
    /// </summary>
    private async Task SelectFilterPickerFromTree(PassportField field)
    {
        ScenarioTreePicker? picker = null;

        RenderFragment body = builder =>
        {
            builder.OpenComponent<ScenarioTreePicker>(0);
            builder.AddComponentParameter(1, nameof(ScenarioTreePicker.Scenario), field.Picker!.Scenario);
            builder.AddComponentReferenceCapture(2, c => picker = (ScenarioTreePicker)c);
            builder.CloseComponent();
        };

        if (await Dialogs.ShowAsync(Tr.T("Выбрать объект"), body, okText: Tr.T("Выбрать")) != DialogOutcome.Ok)
            return;

        // Как и у выбора из списка: пустой выбор — не команда очистить.
        PresentationObject? selected = picker?.SelectedObject;
        if (selected == null)
            return;

        object id = selected.IDs[0] ?? (object)DBNull.Value;
        Values[field.Name] = id;
        _invalid.Remove(field.Name);
        _filterPickerNames[field.Name] = selected.Name;
        _filterPickerNamesFor[field.Name] = AsFilterText(id);
    }
}
