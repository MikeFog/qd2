    /// отмеченных кампаний столько же, сколько у кампании, где его больше всего; позиции — у кампании-лидера.
    /// </summary>
    private async Task FillSlotsToIntersection()
    {
        if (!CanFixRollers || _range is not { } range || _week == null || _selection.Count == 0)
            return;

        IReadOnlyList<PlacementCell> cells = _selection.Selected(_week);
        RangeSource.AdditionPlan? plan = null;
        await Run(() => plan = RangeSource.PlanAdditions(range, RangeSource.ReadSlots(range, cells)));
        if (plan == null)
            return;
        if (plan.Count == 0)
        {
            await ShowInfo(Tr.T("Добавить до полного пересечения"), Tr.T("В выделенных окнах количество роликов уже совпадает у всех выбранных кампаний."));
            return;
        }
        if (!await Confirm(Tr.T("Добавить до полного пересечения"),
                Tr.Format("Добавить недостающие ролики в выделенных окнах до полного пересечения? ({0} шт.)", plan.Count), Tr.T("Добавить")))
            return;

        WindowsSource.BatchResult? result = null;
        RangeSource.AdditionPlan toAdd = plan;
        int withoutPosition = 0;
        await Run(() =>
        {
            result = RangeSource.FillToIntersection(range, toAdd, _view, _numbers, out withoutPosition);
            Undo.Remember(Action.ActionId, PlacementUndo.RangeCampaign, result.Created); // см. PlaceSlot
            ReloadWeekCore();
        });
        await AfterBatch(result, done => Tr.Format("Добавлено выпусков: {0}, не добавлено: {1}", done, result!.Failed), "Рекламное окно"); // i18n-ok: заголовок колонки переводит ObjectList при выводе
        if (withoutPosition > 0)
            await ShowInfo(Tr.T("Добавить до полного пересечения"), Tr.Format("Из них без позиционирования (позиция в окне занята): {0}.", withoutPosition));
    }

    /// <summary>
    /// После пачки: шапка страницы перечитывается; отказы — таблицей, в заголовке строка-счётчик
    /// (docs/UI_RULES.md, п. 2.2). Об успехе отдельно не сообщаем — сетка уже показывает итог
    /// (решение 2026-09-22 для массовых операций веба).
    /// </summary>
    private async Task AfterBatch(WindowsSource.BatchResult? result, Func<int, string> caption, string nameColumn)
    {
        if (result == null)
            return;
        if (result.Done > 0)
            await Changed.InvokeAsync();
        if (result.Failed > 0)
            await Tables.ShowAsync(caption(result.Done), result.Errors,
                new Entity.Attribute("name", nameColumn, "nvarchar"),
                new Entity.Attribute("description", "Ошибка", "nvarchar")); // i18n-ok: заголовок колонки переводит ObjectList при выводе
    }

    /// <summary>Чек-лист роликов; null — отмена. Пустой выбор не принимается.</summary>
    private async Task<IReadOnlyCollection<int>?> ChooseRollers(string title, string question, IReadOnlyList<int> rollerIds, string okText)
    {
        var model = new RollerChecklistForm.Model { Question = question, Multiple = true };
        await Run(() => model.Rollers = WindowsSource.RollerRows(Scope!, rollerIds));
        if (_error != null)
            return null;

        while (true)
        {
            if (await Dialogs.ShowAsync(title, builder =>
                {
                    builder.OpenComponent<RollerChecklistForm>(0);
                    builder.AddComponentParameter(1, nameof(RollerChecklistForm.Value), model);
                    builder.CloseComponent();
                }, okText: okText, wide: true) != DialogOutcome.Ok)
                return null;
            if (model.Selected.Count > 0)
                return model.Selected;
            model.Message = Tr.T("Отметьте хотя бы один ролик.");
        }
    }

    // ---------- Перенос выпусков ----------

    private const string TargetClass = "cell-target";

    /// <summary>«Перенести в окно»: отмеченные в панели выпуски ждут щелчка по окну-приёмнику; недели листать можно.</summary>
    private async Task StartTransfer()
    {
        if (_selected == null || _campaignIssueList == null || _checkedIssues == 0)
            return;
        _brushOn = false;
        _selection.Clear();
        _transfer = new TransferSource(_selected, _campaignIssueList.SelectedObjects);
        await FocusGrid();
    }

    private void CancelTransfer()
    {
        _transfer = null;
        _rangeTransfer = null;
    }

    private string? TransferCellClass(PlacementCell cell)
    {
        if (_rangeTransfer != null)
            return cell.Key == _rangeTransfer.Source.Key ? "cell-source" : TargetClass;
        if (_transfer == null)
            return null;
        if (cell.Key == _transfer.Source.Key)
            return "cell-source";
        // Заблокированное окно процедура не примет (DisabledInsertRoller) — не предлагаем.
        return cell.Has(PlacementFlags.Disabled) ? "cell-unavailable" : TargetClass;
    }

    /// <summary>Содержимое окна для панели веера; отмеченные группы сбрасываются.</summary>
    private void ShowSlotCore(PlacementCell cell)
    {
        // Сначала читаем, потом присваиваем: сбой чтения (таймаут, взаимоблокировка) не должен оставить шапку одного окна над
        // группами другого — по ним потом отмечают, что переносить.
        RangeSource.SlotContent content = RangeSource.ContentOf(_range!, cell);
        IReadOnlyList<RangeSource.SlotGroupInfo> items = RangeSource.Describe(_range!, content);
        _rangeSlot = cell;
        _slotChecked.Clear();
        _slotContent = content;
        _slotItems = items;
    }

    private void CloseSlotPanel(bool keepTransfer = false)
    {
        _rangeSlot = null;
        _slotContent = null;
        _slotItems = Array.Empty<RangeSource.SlotGroupInfo>();
        _slotChecked.Clear();
        if (!keepTransfer)
            _rangeTransfer = null;
    }

    private void ToggleSlotGroup(int index, bool on)
    {
        if (on)
            _slotChecked.Add(index);
        else
            _slotChecked.Remove(index);
    }

    /// <summary>«№ ролик» из списка «Ролики»; ролика в списке нет (чужой, неактивный) — по названию.</summary>
    private string SlotGroupLabel(RangeSource.SlotGroupInfo item) =>
        _numbers.TryGetValue(item.RollerId, out int number) ? number + " " + item.RollerName : item.RollerName;

    /// <summary>«Перенести в окно» из панели веера: отмеченные группы ждут щелчка по окну-приёмнику; недели листать можно.</summary>
    private async Task StartRangeTransfer()
    {
        if (_rangeSlot == null || _slotContent == null || _slotChecked.Count == 0 || _range is not { CanEdit: true })
            return;
        _brushOn = false;
        _selection.Clear();
        _rangeTransfer = new RangeTransfer(_rangeSlot, _slotContent, _slotChecked.OrderBy(i => i).ToList());
        await FocusGrid();
    }

    /// <summary>
    /// Перенос групп в окно-приёмник (десктоп — перетаскивание): одно подтверждение (вопрос десктопа; в окне уже выпуск этой фирмы —
    /// предупреждение первым), затем удаление и постановка одной транзакцией — всё или ничего. Отказ (позиция занята, нет места, прошлое…)
    /// — сообщение над сеткой, режим переноса остаётся: можно выбрать другое окно или отменить.
    /// </summary>
    private async Task TransferRangeTo(PlacementCell target)
    {
        RangeTransfer transfer = _rangeTransfer!;
        RangeSource.MovePlan? plan = null;
        await Run(() => plan = RangeSource.PlanMove(_range!, transfer.Content, transfer.Groups, transfer.Source.Date, target.Date));
        if (plan == null || plan.Count == 0)
            return;

        string targetText = DisplayFormat.DateAndTime(target.Date);
        string scope = Tr.T("в тех кампаниях, где он есть");
        string question = plan.Count == 1
            ? Tr.Format("Перенести выпуск в окно '{0}' {1}?", targetText, scope)
            : Tr.Format("Перенести выпуски ({0} шт.) в окно '{1}' {2}?", plan.Count, targetText, scope);
        string? conflict = plan.FirmConflict
            ? Tr.Format("В этом окне уже есть выпуск фирмы «{0}» ({1}).", Action.FirmName, plan.AnyConfirmed ? Tr.T("акция подтверждена") : Tr.T("акция ещё не подтверждена"))
            : null;
        if (await Dialogs.ShowAsync(Tr.T("Перенести в окно"), b =>
            {
                if (conflict != null)
                {
                    b.OpenElement(0, "p");
                    b.AddAttribute(1, "class", "text-warning-emphasis");
                    b.AddContent(2, conflict);
                    b.CloseElement();
                }
                b.OpenElement(3, "p");
                b.AddContent(4, question);
                b.CloseElement();
            }, okText: Tr.T("Перенести")) != DialogOutcome.Ok)
            return;

        bool moved = false;
        await Run(() =>
        {
            RangeSource.MoveGroups(_range!, plan, _view);
            moved = true;
        });
        if (!moved)
            return;

        _rangeTransfer = null;
        await Run(ReloadWeekCore);
        await Changed.InvokeAsync();
    }

    /// <summary>
    /// Перенос как десктопное перетаскивание: одно подтверждение (вопрос десктопа и предупреждения
    /// «в окне уже есть ролик / ролики фирмы»), затем удаление и постановка в окно-приёмник одной
    /// транзакцией — всё или ничего.
    /// </summary>
    private async Task TransferTo(PlacementCell target)
    {
        TransferSource source = _transfer!;
        WindowsSource.MovePlan? plan = null;
        await Run(() => plan = WindowsSource.PlanMove(_open!, source.Issues, target));
        if (plan == null)
            return;

        string targetText = DisplayFormat.DateAndTime(target.Date);
        string question = plan.Count == 1
            ? Tr.Format("Перенести выпуск в окно '{0}'?", targetText)
            : Tr.Format("Перенести выпуски ({0} шт.) в окно '{1}'?", plan.Count, targetText);
        if (await Dialogs.ShowAsync(Tr.T("Перенести в окно"), b =>
            {
                b.OpenElement(0, "p");
                b.AddContent(1, question);
                b.CloseElement();
                if (plan.Warnings.Count > 0)
                {
                    b.OpenElement(2, "ul");
                    b.AddAttribute(3, "class", "text-warning-emphasis");
                    foreach (string w in plan.Warnings)
                    {
                        b.OpenElement(4, "li");
                        b.AddContent(5, w);
                        b.CloseElement();
                    }
                    b.CloseElement();
                }
            }, okText: Tr.T("Перенести")) != DialogOutcome.Ok)
            return;

        bool moved = false;
        await Run(() =>
        {
            // Перенос пересоздаёт выпуск с новым номером — запись «Отменить» переходит на новые выпуски.
            Undo.Moved(Action.ActionId, WindowsSource.Move(_open!, plan));
            moved = true;
        });
        // Отказ (прошлое, закрытый день, позиция…) — сообщение над сеткой, режим переноса остаётся:
        // можно выбрать другое окно или отменить.
        if (!moved)
            return;

        _transfer = null;
        await Run(() =>
        {
            ReloadWeekCore();
            if (_selected != null)
                _panel = WindowsSource.LoadWindowIssues(_open!, _selected, _view.ShowUnconfirmed);
        });
        await Changed.InvokeAsync();
    }

    // ---------- Ролики ----------

    private void LoadRollersCore()
    {
        _rollers = WindowsSource.LoadRollers(Scope!);
        _numbers = _rollers.Rows.Cast<DataRow>().ToDictionary(WindowsSource.RollerIdOf, r => Convert.ToInt32(r[WindowsSource.RollerNumberColumn]));
        // Выбор сохраняется, если ролик остался в списке; иначе — первый, как в десктопе.
        if (_brushRollerId == null || !_numbers.ContainsKey(_brushRollerId.Value))
            _brushRollerId = _rollers.Rows.Count > 0 ? WindowsSource.RollerIdOf(_rollers.Rows[0]) : null;
        if (_rollers.Rows.Count == 0)
            _brushOn = false;
    }

    private async Task PlayRoller()
    {
        if (BrushRow is not { } row)
            return;
        if (await Playback.PlayAsync(WindowsSource.RollerListEntity().CreateObject(row)) is { } refusal)
            await ShowInfo(Tr.T("Прослушать ролик"), refusal);
    }

    /// <summary>«Добавить ролик - пустышку»: длительность → GetMuteRoller → пустышка становится роликом кисти.</summary>
    private async Task AddDummy()
    {
        if (Scope is not { CanEdit: true })
            return;

        var model = new DummyRollerForm.Model();
        while (true)
        {
            if (await Dialogs.ShowAsync(Tr.T("Добавить ролик - пустышку"), builder =>
                {
                    builder.OpenComponent<DummyRollerForm>(0);
                    builder.AddComponentParameter(1, nameof(DummyRollerForm.Value), model);
                    builder.CloseComponent();
                }, okText: Tr.T("Добавить")) != DialogOutcome.Ok)
                return;
            model.Message = model.Validate();
            if (model.Message == null)
                break;
        }

        await Run(() =>
        {
            int rollerId = _range != null
                ? RangeSource.CreateDummyRoller(_range, model.TotalSeconds)
                : WindowsSource.CreateDummyRoller(_open!, model.TotalSeconds);
            _brushRollerId = rollerId;
            LoadRollersCore();
        });
    }

    /// <summary>«⋯» у ролика — меню сущности 1244, как у списка «Ролики» десктопа.</summary>
    private async Task OpenRollerMenu(DataRow row, MouseEventArgs e)
    {
        try
        {
            PresentationObject roller = WindowsSource.RollerListEntity().CreateObject(row);
            IReadOnlyList<ActionMenuItem> items = Actions.BuildMenu(roller, ViewType.Journal);
            string? picked = await Menu.ShowAsync(items, e.ClientX, e.ClientY, fromButton: true);
            if (picked == null)
                return;
            ActionEffect? effect = await Actions.ExecuteAsync(roller, picked, ViewType.Journal);
            // Предмет рекламы ролика мог смениться — список и отбор по предмету перечитать.
            if (effect is not null and not ActionEffect.None)
                await Run(() =>
                {
                    LoadRollersCore();
                    ReloadWeekCore();
                });
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    }

    // ---------- Диалоги ----------

    private bool _operating;

    /// <summary>
    /// Операция с вопросом пользователю (пачки, перенос, пустышка) — одна за раз. Повторный щелчок
    /// по той же кнопке или окну, пришедший, пока открыт вопрос, иначе открыл бы второй такой же
    /// вопрос, и подтверждение обоих записало бы дважды.
    /// </summary>
    private async Task Exclusive(Func<Task> operation)
    {
        if (_operating)
            return;
        _operating = true;
        try
        {
            await operation();
        }
        finally
        {
            _operating = false;
        }
    }

    private async Task<bool> Confirm(string title, string text, string okText) =>
        await Dialogs.ShowAsync(title, b => b.AddContent(0, text), okText: okText) == DialogOutcome.Ok;

    private Task ShowInfo(string caption, string text) =>
        Dialogs.ShowAsync(caption, builder => builder.AddContent(0, text), okText: Tr.T("Ок"), showCancel: false);
}
