    private TemplateForm.Model? _templateModel;

    /// <summary>
    /// «Шаблон для внесения роликов» (десктоп — FrmTemplate, FrmTemplate2 и FrmTemplate3 в одном диалоге): Шаблон №1 — один
    /// выпуск в день на время (TemplateSource.RunSingle), №2 — интервал времени (RunInterval), №3 — то же с несколькими
    /// роликами и квотами (RunMulti); все по дням, каждый день в своей транзакции, один пересчёт в конце. Поставленные
    /// выпуски становятся записью «Отменить». Итог — всегда: запуск идёт и по неделям, которых на экране нет. Диалог помнит
    /// значения до конца жизни вкладки, как десктопная форма хранит шаблон; время Шаблона №1 берётся из выделенного окна,
    /// если оно есть (десктоп берёт его из щелчка по окну). Ролик кисти нужен №1 и №2 (проверка — в диалоге), №3 берёт
    /// ролики из таблицы диалога.
    /// </summary>
    private async Task RunTemplate()
    {
        if (Scope is not { CanEdit: true })
            return;
        RangeSource.OpenRange? range = _range;
        WindowsSource.OpenCampaign? open = _open;

        TemplateForm.Model model = _templateModel ??= TemplateForm.Model.Create();
        model.StationCount = range?.CampaignIds.Count ?? 1;
        model.HasBrushRoller = BrushRow != null;
        model.RollerName = BrushRow is { } brush ? WindowsSource.RollerName(brush) : string.Empty;
        // Ролики фирмы — тот же список, что слева («Ролики»): отметки и количества прошлого открытия сохраняются.
        model.SetRollers((_rollers?.Rows.Cast<DataRow>() ?? Enumerable.Empty<DataRow>()).Select(r => new TemplateForm.RollerRow
        {
            Id = WindowsSource.RollerIdOf(r),
            Name = WindowsSource.RollerName(r),
            DurationText = WindowsSource.RollerDuration(r),
            DurationSeconds = Convert.ToInt32(r[Roller.ParamNames.Duration]),
            AdvertType = Convert.ToString(r[Roller.ParamNames.AdvertTypeName]) ?? string.Empty,
        }));
        model.Message = null;
        // Время Шаблона 1 — от выбранного места (десктоп берёт его из щелчка): у веера — начало слота.
        if ((range != null ? _rangeSlot : _selected) is { } picked)
            model.SingleTime = picked.Date.ToString("HH:mm");
        while (true)
        {
            if (await Dialogs.ShowAsync(Tr.T("Шаблон"), builder =>
                {
                    builder.OpenComponent<TemplateForm>(0);
                    builder.AddComponentParameter(1, nameof(TemplateForm.Value), model);
                    builder.CloseComponent();
                }, okText: Tr.T("Добавить")) != DialogOutcome.Ok)
                return;
            model.Message = model.Validate();
            if (model.Message == null)
                break;
        }

        PlacementTemplate template = model.ToTemplate();
        TemplateForm.Kind kind = model.Mode;
        List<KeyValuePair<int, int>> quotas = model.Quotas();
        int rollerId = _brushRollerId ?? 0;
        int position = _view.Position;
        TemplateSource.TemplateResult? result = null;
        await Run(() =>
        {
            if (range != null)
            {
                result = kind switch
                {
                    TemplateForm.Kind.Single => TemplateRangeSource.RunSingle(range, template, rollerId, position, _view),
                    TemplateForm.Kind.Multi => TemplateRangeSource.RunMulti(range, template, quotas, position, _view),
                    _ => TemplateRangeSource.RunInterval(range, template, rollerId, position, _view),
                };
                Undo.Remember(Action.ActionId, PlacementUndo.RangeCampaign, result.Created);
            }
            else
            {
                result = kind switch
                {
                    TemplateForm.Kind.Single => TemplateSource.RunSingle(open!, template, rollerId, position),
                    TemplateForm.Kind.Multi => TemplateSource.RunMulti(open!, template, quotas, position),
                    _ => TemplateSource.RunInterval(open!, template, rollerId, position),
                };
                Undo.Remember(Action.ActionId, open!.CampaignId, result.Created);
            }
            ReloadWeekCore();
            if (_selected != null && open != null)
                _panel = WindowsSource.LoadWindowIssues(open, _selected, _view.ShowUnconfirmed);
        });
        if (result == null)
            return;
        if (result.Done > 0)
            await Changed.InvokeAsync();
        if (result.Errors.Rows.Count > 0)
            await Tables.ShowAsync(Tr.Format("Добавлено выпусков: {0}, не добавлено: {1}", result.Done, result.NotAdded), result.Errors,
                new Entity.Attribute("name", "Дата", "nvarchar"), // i18n-ok: заголовок колонки переводит ObjectList при выводе
                new Entity.Attribute("description", "Ошибка", "nvarchar")); // i18n-ok: заголовок колонки переводит ObjectList при выводе
        else
            await ShowInfo(Tr.T("Шаблон"), Tr.Format("Добавлено выпусков: {0}.", result.Done));
    }

    /// <summary>
    /// «Отменить» (десктоп — после шаблона): выпуски последнего размещения. Выпуски читаются заново: уже удалённые
    /// и изменённые после размещения пропускаются и попадают в таблицу отказов. Запись снимается после любого итога
    /// (кроме сбоя, который откатил всё, — тогда можно повторить).
    /// </summary>
    private async Task UndoLast()
    {
        PlacementUndo.Entry? entry = UndoEntry;
        if (entry == null || Scope is not { CanEdit: true })
            return;

        string question = Tr.Format("Отменить последнее добавление выпусков? ({0} шт.)", entry.Issues.Count);
        if (Action.IsConfirmed)
            question += " " + Tr.T("Акция подтверждена: цена акции будет пересчитана, привязки оплат могут быть сокращены.");
        if (!await Confirm(Tr.T("Отменить"), question, Tr.T("Отменить")))
            return;

        WindowsSource.BatchResult? result = null;
        await Run(() =>
        {
            result = _range != null ? RangeSource.Undo(_range, entry.Issues) : WindowsSource.Undo(_open!, entry.Issues);
            ReloadWeekCore();
            if (_selected != null && _open != null)
                _panel = WindowsSource.LoadWindowIssues(_open, _selected, _view.ShowUnconfirmed);
        });
        // Прерванная сбоем отмена оставляет в записи то, что не снято, — её можно повторить.
        if (result is { Unprocessed.Count: > 0 })
            Undo.Remember(entry.ActionId, entry.CampaignId, result.Unprocessed);
        else if (result != null)
            Undo.Forget(entry.ActionId);
        await AfterBatch(result, done => Tr.Format("Отменено выпусков: {0}, не отменено: {1}", done, result!.NotDone), "Выпуск"); // i18n-ok: заголовок колонки переводит ObjectList при выводе
        // Запись живёт дольше недели на экране: сняться могли выпуски, которых сетка не показывает, — итог сообщается всегда, как в десктопе.
        if (result is { Failed: 0, Done: > 0 })
            await ShowInfo(Tr.T("Отменить"), Tr.Format("Отменено выпусков: {0}.", result.Done));
    }

