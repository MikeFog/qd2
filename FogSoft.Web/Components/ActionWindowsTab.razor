    {
        _view.ShowUnconfirmed = !_view.ShowUnconfirmed;
        return Run(() =>
        {
            ReloadWeekCore();
            if (_selected != null)
                _panel = WindowsSource.LoadWindowIssues(_open!, _selected, _view.ShowUnconfirmed);
