@using System.Data
@using FogSoft.Web.Infrastructure
@using FogSoft.WinForm
@using FogSoft.WinForm.Classes
@using FogSoft.WinForm.DataAccess
@using Merlin.Classes
@inject BusyService Busy
@inject DialogService Dialogs
@inject TableDialog Tables
@inject ObjectActions Actions
@inject ActionMenuService Menu
@inject RollerPlayback Playback
@inject PlacementUndo Undo

@*
    Вкладка «Рекламные окна» страницы акции (docs/tasks/web-action-forms.md, этап 2): линейные
    кампании акции галочками; отмечена одна — неделя рекламных окон её радиостанции, как десктопный
    CampaignForm с RollerIssuesGrid3 (режим — по числу отмеченных, решение В-3; несколько — веер,
    этап 4а: получасовые слоты по всем отмеченным станциям, как десктопный EditIssuesForm; при входе
    отмечены все линейные кампании, как там). Слева «Ролики» (кисть), в центре сетка, справа —
    выпуски выбранного окна (у веера панели пока нет). В веере окна выделяются так же (щелчок, Shift, Ctrl,
    Esc); по выделенным — «Разместить ролик» и «Удалить выпуски» (десктоп — Insert и Del).

    Клик по окну: в «Режиме добавления» ставит ролик кисти с позицией «Позиционирования», иначе
    выбирает окно (Shift/Ctrl — несколько) и показывает его выпуски. По выделенным окнам —
    «Разместить ролик», «Удалить выпуски», «Заменить ролики» (десктоп — Insert, Del, Ctrl+R);
    перенос выпусков — «Перенести в окно» из панели (десктоп — перетаскивание). Запись и права —
    в ядре (WindowsSource), одно действие — одна транзакция и один пересчёт акции; после записи
    страница перечитывает шапку (Changed).
*@

<div class="windows-tab">
    @if (_error != null)
    {
        <div class="alert alert-danger alert-dismissible tab-error" role="alert">
            @_error
            <button type="button" class="btn-close" aria-label="@(Tr.T("Закрыть"))" @onclick="() => _error = null"></button>
        </div>
    }

    <div class="windows-body @((_selected != null && _open != null) || (_rangeSlot != null && _range != null) ? "with-panel" : null)">
        <aside class="side">
            <section class="side-block">
                <div class="side-title">@Tr.T("Рекламные кампании")</div>
                <ul class="campaign-list">
                    @foreach (DataRow row in LinearRows)
                    {
                        int id = WindowsSource.CampaignIdOf(row);
                        bool on = _checked.Contains(id);
                        <li class="@(on ? "on" : null)">
                            <input type="checkbox" class="form-check-input" checked="@on" aria-label="@CaptionOf(row)"
                                   @onchange="e => ToggleCampaign(id, e.Value is true)" />
                            <button type="button" class="campaign" title="@(Tr.T("Показать только эту кампанию"))" @onclick="() => CheckOnly(id)">
                                @CaptionOf(row)
                            </button>
                        </li>
                    }
                </ul>
                @if (LinearRows.Count() > 1)
                {
                    <button type="button" class="btn btn-sm btn-link check-all" disabled="@(_checked.Count == LinearRows.Count())"
                            title="@(Tr.T("Отметить все линейные кампании акции — веер по всем станциям"))" @onclick="CheckAll">
                        @Tr.T("Отметить все")
                    </button>
                }
                @if (OpenRow is { } openRow)
                {
                    <dl class="stats">
                        @foreach (KeyValuePair<string, string> stat in WindowsSource.CampaignStats(openRow))
                        {
                            <div><dt>@stat.Key</dt><dd>@stat.Value</dd></div>
                        }
                    </dl>
                }
            </section>

            @if (Scope != null)
            {
                <section class="side-block rollers">
                    <div class="side-title">
                        @Tr.T("Ролики")
                        <span class="side-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Прослушать ролик"))" aria-label="@(Tr.T("Прослушать ролик"))"
                                    disabled="@(BrushRow is not { } br || WindowsSource.IsDummy(br))" @onclick="PlayRoller">
                                <i class="bi bi-play-fill" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="@(Tr.T("Добавить ролик - пустышку"))"
                                    title="@(Scope.CanEdit ? Tr.T("Добавить ролик - пустышку") : NoRightText)"
                                    disabled="@(!Scope.CanEdit)" @onclick="() => Exclusive(AddDummy)">
                                <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                            </button>
                        </span>
                    </div>
                    @if (_rollers == null)
                    {
                        <div class="state">@Tr.T("Загрузка…")</div>
                    }
                    else if (_rollers.Rows.Count == 0)
                    {
                        <div class="text-muted small">@Tr.T("У фирмы нет активных роликов. Можно добавить ролик-пустышку.")</div>
                    }
                    else
                    {
                        <div class="data-table roller-table">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th class="col-num">№</th>
                                        <th>@Tr.T("Ролик")</th>
                                        <th>@Tr.T("Предмет рекламы")</th>
                                        <th>@Tr.T("Продолжительность")</th>
                                        <th class="col-menu"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRow row in _rollers.Rows)
                                    {
                                        int rollerId = WindowsSource.RollerIdOf(row);
                                        <tr class="@(rollerId == _brushRollerId ? "row-active" : null)" @onclick="() => _brushRollerId = rollerId">
                                            <td class="col-num tabular">@row[WindowsSource.RollerNumberColumn]</td>
                                            <td>@WindowsSource.RollerName(row)</td>
                                            <td>@row[Roller.ParamNames.AdvertTypeName]</td>
                                            <td class="tabular">@WindowsSource.RollerDuration(row)</td>
                                            <td class="col-menu">
                                                <button type="button" class="row-btn" title="@(Tr.T("Действия с роликом"))" aria-label="@(Tr.T("Действия с роликом"))"
                                                        aria-haspopup="menu" @onclick="e => OpenRollerMenu(row, e)" @onclick:stopPropagation="true">
                                                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        </aside>
        @* Ширину левой колонки можно менять, как дерево древовидных экранов: неделе окон хватает
           ~660 px, а ролики с длинными предметами рекламы в 280 px не помещаются. *@
        <PaneSplitter StorageKey="action-windows" />

        <section class="center">
            @if (_checked.Count == 0)
            {
                <div class="state">
                    <div class="state-title">@Tr.T("Отметьте рекламную кампанию слева")</div>
                    @(LinearRows.Any()
                        ? Tr.T("Одна кампания — неделя рекламных окон её радиостанции: ставить ролики, смотреть выпуски окна, переносить их. Несколько — веер: слоты по всем отмеченным станциям.")
                        : Tr.T("В акции нет линейных рекламных кампаний."))
                </div>
            }
            else if (Scope == null)
            {
                <div class="state">@Tr.T("Загрузка…")</div>
            }
            else
            {
                @* Esc снимает выделение и отменяет перенос: клавиши ловит обёртка сетки, фокус ставит клик.
                   Тулбар вкладки — в строке недели сетки, подпись режима и легенда — тонкой строкой под ней:
                   сетке нужна вся высота. Переключатели вида — значками, подписи десктопа — в подсказках. *@
                <div class="grid-box" tabindex="-1" @ref="_gridBox" @onkeydown="GridKey">
                    <PlacementGrid Model="_week" Date="_date" SelectedKeys="_selection.Keys" Brush="_brushOn && _transfer == null && _rangeTransfer == null"
                                   ShownBackgrounds="ShownBackgrounds" CellText="CellText" CellTitle="CellTitle" ExtraCellClass="TransferCellClass"
                                   DayTotalTitle="@(IsRange ? Tr.T("Выпусков акции за день по отмеченным кампаниям") : Tr.T("Выпусков этой кампании за день"))"
                                   OnPrevious="PreviousWeek" OnNext="NextWeek" OnJump="JumpTo" OnCellClick="ClickCell">
                        <LeadingTools>
                            <button type="button" class="btn btn-sm @(_brushOn ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@_brushOn"
                                    disabled="@(!CanBrush)" title="@BrushHint" @onclick="ToggleBrush">
                                <i class="bi bi-brush" aria-hidden="true"></i>@Tr.T("Режим добавления")
                            </button>
                            @if (UndoEntry is { } undo)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!Scope.CanEdit)"
                                        title="@(Scope.CanEdit ? Tr.Format("{0} ({1} шт.)", Tr.T("Отменить последнее добавление выпусков"), undo.Issues.Count) : NoRightText)"
                                        @onclick="() => Exclusive(UndoLast)">
                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>@Tr.T("Отменить")
                                </button>
                            }
                            @if (Scope is { } templateScope)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!templateScope.CanEdit || _rollers is not { Rows.Count: > 0 })"
                                        title="@(!templateScope.CanEdit ? NoRightText : _rollers is not { Rows.Count: > 0 } ? Tr.T("У фирмы нет активных роликов. Можно добавить ролик-пустышку.") : Tr.T("Шаблон для внесения роликов"))"
                                        @onclick="() => Exclusive(RunTemplate)">
                                    <i class="bi bi-calendar-range" aria-hidden="true"></i>@Tr.T("Шаблон")
                                </button>
                            }
                            @if (BrushRow is { } brush)
                            {
                                <span class="brush-roller" title="@(Tr.T("Ролик, который ставится в окна, — выбран в списке «Ролики»"))">
                                    <b class="tabular">@brush[WindowsSource.RollerNumberColumn]</b> @WindowsSource.RollerName(brush) · <span class="tabular">@WindowsSource.RollerDuration(brush)</span>
                                </span>
                            }
                            <PlacementFilterButtons View="_view" @bind-AdvertTypeName="_advertTypeName" Changed="ReloadWeek" />
                        </LeadingTools>
                        <TrailingTools>
                            <span class="toggles">
                                <PlacementFilterButtons View="_view" Unconfirmed="true" Changed="UnconfirmedChanged" />
                                <button type="button" class="btn btn-sm btn-outline-secondary @(_showNumbers ? "active" : null)" aria-pressed="@_showNumbers"
                                        title="@(Tr.T("Номера роликов") + "\n" + (IsRange ? Tr.T("Показывать в окнах номера роликов отмеченных кампаний вместо остатка времени") : Tr.T("Показывать в окнах номера роликов текущей кампании вместо остатка времени")))" aria-label="@(Tr.T("Номера роликов"))" @onclick="ToggleNumbers">
                                    <i class="bi bi-123" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary @(_showPrime ? "active" : null)" aria-pressed="@_showPrime"
                                        title="@(Tr.T("Видеть прайм") + "\n" + Tr.T("Показать окна прайм-тайм"))" aria-label="@(Tr.T("Видеть прайм"))" @onclick="() => _showPrime = !_showPrime">
                                    <i class="bi bi-star" aria-hidden="true"></i>
                                </button>
                                @if (!IsRange)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary @(_showMarked ? "active" : null)" aria-pressed="@_showMarked"
                                            title="@(Tr.T("Показать отмеченные окна"))" aria-label="@(Tr.T("Показать отмеченные окна"))" @onclick="() => _showMarked = !_showMarked">
                                        <i class="bi bi-check2-square" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary @(_view.ShowDisabled ? "active" : null)" aria-pressed="@_view.ShowDisabled"
                                            title="@(Tr.T("Показать заблокированные окна"))" aria-label="@(Tr.T("Показать заблокированные окна"))" @onclick="ToggleDisabled">
                                        <i class="bi bi-lock" aria-hidden="true"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Обновить информацию"))" aria-label="@(Tr.T("Обновить информацию"))"
                                        @onclick="RefreshAll">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                </button>
                            </span>
                        </TrailingTools>
                        <Caption>
                            @if (IsRange)
                            {
                                <span class="mode-caption">@Tr.Format("Рекламные окна, веер: отмечено кампаний — {0}", _checked.Count)</span>
                                @if (!_brushOn)
                                {
                                    <span class="text-muted">@Tr.T("Окна выделяются щелчком (Shift — прямоугольник, Ctrl — добавить); ролик на все станции одним щелчком ставит «Режим добавления».")</span>
                                }
                            }
                            else
                            {
                                <span class="mode-caption">@Tr.Format("Рекламные окна: {0}", OpenCaption)</span>
                            }
                        </Caption>
                        <Legend>
                            <span class="legend">
                                @if (IsRange)
                                {
                                    <span><i class="sample mine">00:30</i>@Tr.T("выпуски акции у всех отмеченных кампаний")</span>
                                    <span><i class="sample partial">00:30</i>@Tr.T("не у всех")</span>
                                    <span><i class="sample firm">00:30</i>@Tr.T("выпуски фирмы в других акциях на всех станциях")</span>
                                    <span><i class="sample firm-some">00:30</i>@Tr.T("на части станций")</span>
                                    @if (_showNumbers)
                                    {
                                        <span>@Tr.T("«Н» — число ролика не одинаково у кампаний, «Д» — дубли")</span>
                                    }
                                }
                                else
                                {
                                    <span><i class="sample mine">00:30</i>@Tr.T("выпуски этой кампании")</span>
                                    <span><i class="sample firm">00:30</i>@Tr.T("выпуски фирмы в других кампаниях")</span>
                                }
                                @if (_showPrime)
                                {
                                    <span><i class="swatch bg-prime"></i>@Tr.T("прайм-тайм")</span>
                                }
                                @if (!IsRange && _showMarked)
                                {
                                    <span><i class="swatch bg-marked"></i>@Tr.T("отмеченное окно")</span>
                                }
                                @if (!IsRange && _view.ShowDisabled)
                                {
                                    <span><i class="swatch bg-disabled"></i>@Tr.T("заблокированное окно")</span>
                                }
                                @if (_view.Position != 0 || _view.AdvertTypeId != null)
                                {
                                    <span><i class="sample match">00:30</i>@Tr.T("подходит под отбор")</span>
                                }
                            </span>
                        </Legend>
                        <Toolbar>
                            @if (_transfer != null)
                            {
                                <div class="transfer-bar">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                    <span>
                                        @Tr.Format("Перенос выпусков ({0}) из окна", _transfer.Issues.Count)
                                        <b class="tabular">@DisplayFormat.DayMonthTime(_transfer.Source.Date)</b> —
                                        @Tr.T("щёлкните окно, куда перенести")
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Отменить перенос (Esc)"))" @onclick="CancelTransfer">
                                        @Tr.T("Отмена")
                                    </button>
                                </div>
                            }
                            else if (_rangeTransfer != null)
                            {
                                <div class="transfer-bar">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                    <span>
                                        @Tr.Format("Перенос выпусков ({0}) из окна", _rangeTransfer.Groups.Count)
                                        <b class="tabular">@DisplayFormat.DayMonthTime(_rangeTransfer.Source.Date)</b> —
                                        @Tr.T("щёлкните окно, куда перенести")
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Отменить перенос (Esc)"))" @onclick="CancelTransfer">
                                        @Tr.T("Отмена")
                                    </button>
                                </div>
                            }
                            else if (_range != null && !_brushOn && _selection.Count > 0)
                            {
                                <div class="selection-bar">
                                    <span class="selection-count">@Tr.Format("Выделено окон: {0}", _selection.Count)</span>
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanBrush)" title="@BrushHint" @onclick="() => Exclusive(PlaceSelectedSlots)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>@Tr.T("Разместить ролик")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!_range.CanEdit)"
                                            title="@(_range.CanEdit ? null : NoRightText)" @onclick="() => Exclusive(RemoveSelectedSlots)">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>@Tr.T("Удалить выпуски")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!CanReplace)" title="@ReplaceHint" @onclick="() => Exclusive(ReplaceSelectedSlots)">
                                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i>@Tr.T("Заменить ролики")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!CanFixRollers)"
                                            title="@(FixRollersHint ?? Tr.T("Добавить ролики до полного пересечения"))" @onclick="() => Exclusive(FillSlotsToIntersection)">
                                        <i class="bi bi-intersect" aria-hidden="true"></i>@Tr.T("Добавить до полного пересечения")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!CanFixRollers)"
                                            title="@(FixRollersHint ?? Tr.T("Удалить дубли роликов из выделенных окон"))" @onclick="() => Exclusive(DeleteDuplicatesInSlots)">
                                        <i class="bi bi-eraser" aria-hidden="true"></i>@Tr.T("Удалить дубли")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Снять выделение (Esc)"))" aria-label="@(Tr.T("Снять выделение"))"
                                            @onclick="ClearSelection">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                            else if (_open != null && !_brushOn && _selection.Count > 0)
                            {
                                <div class="selection-bar">
                                    <span class="selection-count">@Tr.Format("Выделено окон: {0}", _selection.Count)</span>
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanBrush)" title="@BrushHint" @onclick="() => Exclusive(PlaceSelected)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>@Tr.T("Разместить ролик")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!_open.CanEdit)"
                                            title="@(_open.CanEdit ? null : NoRightText)" @onclick="() => Exclusive(RemoveSelected)">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>@Tr.T("Удалить выпуски")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!CanReplace)" title="@ReplaceHint" @onclick="() => Exclusive(ReplaceSelected)">
                                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i>@Tr.T("Заменить ролики")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Снять выделение (Esc)"))" aria-label="@(Tr.T("Снять выделение"))"
                                            @onclick="ClearSelection">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        </Toolbar>
                    </PlacementGrid>
                </div>
            }
        </section>

        @if (_rangeSlot != null && _range != null)
        {
            <PaneSplitter StorageKey="action-windows-panel" RightPane="true" />
            <aside class="window-panel">
                <div class="panel-head">
                    <div>
                        <div class="panel-title tabular">@Tr.Format("Окно {0}", DisplayFormat.DateAndTime(_rangeSlot.Date))</div>
                        <div class="panel-sub tabular">@_rangeSlot.Text@StatusText(_rangeSlot)</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Закрыть"))" aria-label="@(Tr.T("Закрыть"))" @onclick="() => CloseSlotPanel()">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="panel-section-title">@Tr.T("Выпуски отмеченных кампаний")</div>
                @if (_slotItems.Count > 0 && _range.CanEdit)
                {
                    <div class="panel-bar">
                        @if (_slotChecked.Count > 0)
                        {
                            <span>@Tr.Format("Отмечено: {0}", _slotChecked.Count)</span>
                            <button type="button" class="btn btn-sm btn-primary" disabled="@(_rangeTransfer != null)" @onclick="StartRangeTransfer">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>@Tr.T("Перенести в окно")
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">@Tr.T("Отметьте выпуски, чтобы перенести их в другое окно.")</span>
                        }
                    </div>
                }
                <div class="panel-list">
                    @if (_slotItems.Count == 0)
                    {
                        <div class="state">@Tr.T("В окне нет выпусков отмеченных кампаний.")</div>
                    }
                    else
                    {
                        <table class="table table-sm slot-groups">
                            <thead>
                                <tr>
                                    <th class="col-check"></th>
                                    <th>@Tr.T("Ролик")</th>
                                    <th>@Tr.T("Порядок")</th>
                                    <th>@Tr.T("Кампании")</th>
                                    <th class="col-count">@Tr.T("Выпусков")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (RangeSource.SlotGroupInfo item in _slotItems)
                                {
                                    <tr>
                                        <td class="col-check">
                                            <input type="checkbox" class="form-check-input" disabled="@(!_range.CanEdit || _rangeTransfer != null)" checked="@_slotChecked.Contains(item.Index)"
                                                   aria-label="@SlotGroupLabel(item)" @onchange="e => ToggleSlotGroup(item.Index, e.Value is true)" />
                                        </td>
                                        <td>@SlotGroupLabel(item)</td>
                                        <td>@item.PositionText</td>
                                        <td title="@item.CampaignTitles">@Tr.Format("{0} из {1}", item.Campaigns, _range.CampaignIds.Count)</td>
                                        <td class="col-count tabular">@item.Issues</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </aside>
        }

        @if (_selected != null && _open != null)
        {
            @* Ширину панели окна тоже можно менять — как разделитель сетки и выходов в десктопе. *@
            <PaneSplitter StorageKey="action-windows-panel" RightPane="true" />
            <aside class="window-panel">
                <div class="panel-head">
                    <div>
                        <div class="panel-title tabular">@Tr.Format("Окно {0}", DisplayFormat.DateAndTime(_selected.Date))</div>
                        <div class="panel-sub tabular">@_selected.Text@StatusText(_selected)</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@(Tr.T("Закрыть"))" aria-label="@(Tr.T("Закрыть"))" @onclick="ClosePanel">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="panel-section-title">@Tr.T("Выходы в эфир этой кампании")</div>
                @if (_panel is { Campaign.Rows.Count: > 0 } && _open.CanEdit)
                {
                    <div class="panel-bar">
                        @if (_checkedIssues > 0)
                        {
                            <span>@Tr.Format("Отмечено: {0}", _checkedIssues)</span>
                            <button type="button" class="btn btn-sm btn-primary" disabled="@(_transfer != null)" @onclick="StartTransfer">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>@Tr.T("Перенести в окно")
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">@Tr.T("Отметьте выпуски, чтобы перенести их в другое окно.")</span>
                        }
                    </div>
                }
                <div class="panel-list">
                    <ObjectList @ref="_campaignIssueList" Entity="_campaignIssueEntity" Data="_panel?.Campaign" Selectable="_open.CanEdit"
                                ReadOnly="_transfer != null"
                                SelectionChanged="n => _checkedIssues = n" Changed="AfterIssueAction" Failed="ShowError"
                                EmptyText="@(Tr.T("В окне нет выпусков этой кампании."))" />
                </div>

                <div class="panel-section-title">@Tr.T("Все выходы в эфир")</div>
                <div class="panel-list">
                    <ObjectList Entity="_allIssueEntity" Data="_panel?.All" ReadOnly="true" EmptyText="@(Tr.T("В окне нет выпусков."))" />
                </div>
            </aside>
        }
    </div>
</div>

@code {
    /// <summary>Акция страницы.</summary>
    [Parameter, EditorRequired] public ActionOnMassmedia Action { get; set; } = default!;

    /// <summary>Кампании акции (Campaigns) — страница перечитывает их после каждой операции.</summary>
    [Parameter, EditorRequired] public DataTable Campaigns { get; set; } = default!;

    /// <summary>Отметить только эту кампанию (вход «Редактировать» у кампании); применяется при смене <see cref="RequestVersion"/>.</summary>
    [Parameter] public int? RequestedCampaignId { get; set; }

    [Parameter] public int RequestVersion { get; set; }

    /// <summary>Размещение изменилось — страница перечитывает шапку и кампании.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private readonly List<int> _checked = new();
    private int _appliedRequest = -1;
    private bool _initialized;

    private WindowsSource.OpenCampaign? _open;
    private RangeSource.OpenRange? _range;
    private readonly WindowsSource.WeekView _view = new();
    private DateTime _date = DateTime.Today;
    private bool _dateChosen;
    private PlacementWeek? _week;
    private string? _error;

    private DataTable? _rollers;
    private int? _brushRollerId;
    private Dictionary<int, int> _numbers = new();
    private bool _brushOn;
    private string? _advertTypeName;

    private bool _showNumbers;
    private bool _showPrime;
    private bool _showMarked;

    private readonly PlacementSelection _selection = new();
    private ElementReference _gridBox;

    // Окно в правой панели и его выпуски (WindowIssuesRetrieve).
    private PlacementCell? _selected;
    private WindowsSource.WindowIssues? _panel;
    private ObjectList? _campaignIssueList;
    private int _checkedIssues;
    private readonly Entity _campaignIssueEntity = WindowsSource.IssueEntity(full: false);
    private readonly Entity _allIssueEntity = WindowsSource.IssueEntity(full: true);

    // Перенос: отмеченные в панели выпуски ждут щелчка по окну-приёмнику.
    private TransferSource? _transfer;
    private sealed record TransferSource(PlacementCell Source, IReadOnlyList<PresentationObject> Issues);

    // Панель окна веера: содержимое последнего выбранного окна по группам «ролик + позиция»; отмеченные группы переносятся в
    // другое окно (десктоп — перетаскивание): перенос ждёт щелчка по окну-приёмнику.
    private PlacementCell? _rangeSlot;
    private RangeSource.SlotContent? _slotContent;
    private IReadOnlyList<RangeSource.SlotGroupInfo> _slotItems = Array.Empty<RangeSource.SlotGroupInfo>();
    private readonly HashSet<int> _slotChecked = new();
    private RangeTransfer? _rangeTransfer;
    private sealed record RangeTransfer(PlacementCell Source, RangeSource.SlotContent Content, IReadOnlyList<int> Groups);

    private string NoRightText => IsRange
        ? Tr.T("Нет права «Редактировать» на одну из отмеченных кампаний.")
        : Tr.T("Нет права «Редактировать» на эту кампанию.");

    /// <summary>Отмечено несколько кампаний — веер (получасовые слоты по всем станциям); иначе сетка окон одной кампании.</summary>
    private bool IsRange => _range != null;

    /// <summary>Открытое: одна кампания или веер — для того, что не зависит от режима (ролики кисти, права).</summary>
    private WindowsSource.IBrushScope? Scope => (WindowsSource.IBrushScope?)_open ?? _range;

    private IEnumerable<DataRow> LinearRows => Campaigns.Rows.Cast<DataRow>().Where(WindowsSource.IsLinear);

    private DataRow? RowOf(int campaignId) =>
        LinearRows.FirstOrDefault(r => WindowsSource.CampaignIdOf(r) == campaignId);

    private DataRow? OpenRow => _open == null ? null : RowOf(_open.CampaignId);

    private string OpenCaption => OpenRow is { } row ? CaptionOf(row) : "";

    /// <summary>
    /// Подпись кампании. В акции бывают две линейные кампании одной станции с одним типом оплаты и разными
    /// агентствами (UIX_Campaign) — тогда подписи совпали бы, и агентство добавляется, как в десктопном
    /// «Отсутствуют:» (FormatCampaignTitle).
    /// </summary>
    private string CaptionOf(DataRow row)
    {
        string caption = WindowsSource.CampaignCaption(row);
        bool ambiguous = LinearRows.Count(r => WindowsSource.CampaignCaption(r) == caption) > 1;
        return ambiguous ? WindowsSource.CampaignCaption(row, withAgency: true) : caption;
    }

    private DataRow? BrushRow => _rollers == null || _brushRollerId == null ? null
        : _rollers.Rows.Cast<DataRow>().FirstOrDefault(r => WindowsSource.RollerIdOf(r) == _brushRollerId);

    private bool CanBrush => Scope is { CanEdit: true } && BrushRow != null;

    /// <summary>
    /// Запись «Отменить последнее» этой акции, если она про то, что открыто: у линейки — про открытую кампанию, у веера —
    /// веерная и только про отмеченные кампании (иначе отмена задела бы то, чего на экране нет).
    /// </summary>
    private PlacementUndo.Entry? UndoEntry =>
        Undo.Of(Action.ActionId) is not { } entry ? null
        : _range != null ? (entry.IsRange && entry.Issues.All(i => _range.CampaignIds.Contains(i.CampaignId)) ? entry : null)
        : _open != null && !entry.IsRange && entry.CampaignId == _open.CampaignId ? entry
        : null;

    private string? BrushHint =>
        Scope is not { CanEdit: true } ? NoRightText
        : BrushRow == null ? Tr.T("Не выбран рекламный ролик.")
        : null;

    private bool CanReplace => CanBrush && _showNumbers;

    private string? ReplaceHint =>
        !_showNumbers ? Tr.T("Замена роликов доступна только при включённом показе номеров роликов (кнопка \"Номера роликов\") — так видно, что вы меняете.")
        : BrushHint ?? Tr.T("Заменить ролики в выделенных окнах на ролик, выбранный в списке \"Ролики\"");

    /// <summary>
    /// «Добавить до полного пересечения» и «Удалить дубли» (только веер): как в десктопе, доступны при включённых «Номерах
    /// роликов» — так видно, что меняется.
    /// </summary>
    private bool CanFixRollers => _range is { CanEdit: true } && _showNumbers;

    private string? FixRollersHint =>
        _range is not { CanEdit: true } ? NoRightText
        : !_showNumbers ? Tr.T("Доступно только при включённом показе номеров роликов (кнопка \"Номера роликов\") — так видно, что меняется.")
        : null;

    private PlacementFlags ShownBackgrounds =>
        PlacementFlags.Disabled | (_showMarked ? PlacementFlags.Marked : 0) | (_showPrime ? PlacementFlags.Prime : 0);

    // ---------- Кампании ----------

    protected override async Task OnParametersSetAsync()
    {
        // Удалённые кампании — из отметок долой (страница перечитала список после операции).
        int before = _checked.Count;
        _checked.RemoveAll(id => RowOf(id) == null);

        // Фирму акции сменили («Сменить фирму-заказчика» в меню шапки) — ролики кисти другие,
        // кампания открывается заново.
        if (Scope != null && Scope.FirmId != Action.FirmID)
        {
            _open = null;
            _range = null;
            await ApplyChecked();
        }

        if (RequestVersion != _appliedRequest)
        {
            _appliedRequest = RequestVersion;
            if (RequestedCampaignId is { } requested && RowOf(requested) != null)
            {
                _checked.Clear();
                _checked.Add(requested);
            }
            else if (!_initialized)
            {
                // Как при открытии десктопного веера: отмечены все линейные кампании акции (одна — сетка
                // окон, несколько — веер); выбор между открытиями не запоминается.
                _checked.AddRange(LinearRows.Select(WindowsSource.CampaignIdOf));
            }
            _initialized = true;
            await ApplyChecked();
        }
        else if (_checked.Count != before)
            await ApplyChecked();
    }

    private Task ToggleCampaign(int id, bool on)
    {
        if (on && !_checked.Contains(id)) _checked.Add(id);
        if (!on) _checked.Remove(id);
        return ApplyChecked();
    }

    private Task CheckOnly(int id)
    {
        _checked.Clear();
        _checked.Add(id);
        return ApplyChecked();
    }

    /// <summary>«Отметить все»: веер по всем линейным кампаниям акции, как при входе.</summary>
    private Task CheckAll()
    {
        _checked.Clear();
        _checked.AddRange(LinearRows.Select(WindowsSource.CampaignIdOf));
        return ApplyChecked();
    }

    /// <summary>Открыто ровно то, что отмечено: та же одна кампания или тот же набор кампаний веера.</summary>
    private bool IsOpened() =>
        _open != null ? _checked.Count == 1 && _checked[0] == _open.CampaignId
        : _range != null && _checked.Count == _range.CampaignIds.Count && !_checked.Except(_range.CampaignIds).Any();

    /// <summary>Отмечена одна кампания — открыть её сетку окон, несколько — веер (если ещё не открыты), иначе закрыть сетку.</summary>
    private async Task ApplyChecked()
    {
        if (IsOpened())
            return;

        _open = null;
        _range = null;
        _week = null;
        _rollers = null;
        _brushOn = false;
        _transfer = null;
        _selected = null;
        _panel = null;
        CloseSlotPanel();
        _selection.Clear();
        if (_checked.Count == 0)
            return;

        await Run(() =>
        {
            DateTime? first;
            if (_checked.Count == 1)
            {
                _open = WindowsSource.Open(Action, _checked[0]);
                first = _open?.FirstIssueDate;
            }
            else
            {
                // Порядок кампаний веера — порядок списка, а не кликов: от него зависит лидер у «Добавить до полного пересечения»
                // (в десктопе — порядок строк чек-листа).
                _range = RangeSource.Open(Action,
                    LinearRows.Select(WindowsSource.CampaignIdOf).Where(_checked.Contains)
                        .Select(id => new KeyValuePair<int, string>(id, CaptionOf(RowOf(id)!))).ToList());
                first = _range?.FirstIssueDate;
            }
            if (Scope == null)
                return;
            // Первое открытие — с недели первого выпуска, как десктоп (у пустой — завтра); дальше неделя
            // сохраняется при смене кампании: станции одной акции сравнивают за один период.
            if (!_dateChosen)
            {
                _date = first ?? DateTime.Today.AddDays(1);
                _dateChosen = true;
            }
            LoadRollersCore();
            ReloadWeekCore();
        });
        if (Scope == null && _error == null)
            _error = Tr.T("Рекламная кампания не найдена — её удалили. Обновите страницу.");
    }

    // ---------- Неделя ----------

    private Task Run(System.Action work) => Busy.RunAsync(() =>
    {
        try
        {
            _error = null;
            work();
        }
        catch (Exception ex)
        {
            _error = ErrorPresenter.Describe(ex);
        }
    });

    private void ReloadWeekCore()
    {
        _week = _range != null ? RangeSource.LoadWeek(_range, _date, _view) : WindowsSource.LoadWeek(_open!, _date, _view);
        if (_range != null && _showNumbers)
            RangeSource.LoadAllSlotIssues(_range, _week);
        _selection.Retain(_week);
        _selected = _selected == null ? null : _week.Find(_selected.Key);
        if (_selected == null)
            _panel = null;
        if (_rangeSlot != null)
        {
            PlacementCell? fresh = _week.Find(_rangeSlot.Key);
            if (fresh == null)
                CloseSlotPanel(keepTransfer: true);
            else
                ShowSlotCore(fresh);
        }
    }

    private Task ReloadWeek() => Run(ReloadWeekCore);

    private Task PreviousWeek()
    {
        if (_week == null) return Task.CompletedTask;
        _selection.Clear();
        _date = _week.StartDate.AddDays(-1);
        return ReloadWeek();
    }

    private Task NextWeek()
    {
        if (_week == null) return Task.CompletedTask;
        _selection.Clear();
        _date = _week.FinishDate.AddDays(1);
        return ReloadWeek();
    }

    private Task JumpTo(DateTime date)
    {
        _selection.Clear();
        _date = date;
        return ReloadWeek();
    }

    private Task RefreshAll() => Run(() =>
    {
        LoadRollersCore();
        ReloadWeekCore();
        if (_selected != null)
            _panel = WindowsSource.LoadWindowIssues(_open!, _selected, _view.ShowUnconfirmed);
    });

    /// <summary>
    /// «Номера роликов»: в веере при включении дочитываются выпуски во всех окнах недели (в цветных они уже есть) — как
    /// десктоп, который читает весь слот только в этом режиме.
    /// </summary>
    private async Task ToggleNumbers()
    {
        _showNumbers = !_showNumbers;
        if (_showNumbers && _range != null && _week != null)
            await Run(() => RangeSource.LoadAllSlotIssues(_range!, _week!));
    }

    /// <summary>«Учитывать макеты» переключили (PlacementFilterButtons) — неделя и выпуски окна панели.</summary>
    private Task UnconfirmedChanged() => Run(() =>
    {
        ReloadWeekCore();
        if (_selected != null)
            _panel = WindowsSource.LoadWindowIssues(_open!, _selected, _view.ShowUnconfirmed);
    });

    private Task ToggleDisabled()
    {
        _view.ShowDisabled = !_view.ShowDisabled;
        return ReloadWeek();
    }

    // ---------- Ячейка ----------

    private string? CellText(PlacementCell cell) =>
        !_showNumbers ? null
        : _range != null ? RangeSource.NumbersText(_range, cell, _numbers, _view.ShowUnconfirmed)
        : cell.NumbersText(_numbers);

    /// <summary>Подсказка ячейки; у веера при «Номерах роликов» первой идёт расшифровка значков Н/Д, как в десктопе.</summary>
    private string CellTitle(PlacementCell cell)
    {
        string? details = _range != null && _showNumbers && RangeSource.MismatchTooltip(_range, cell, _numbers) is { } mismatch
            ? mismatch
            : cell.Details;
        return DisplayFormat.DateAndTime(cell.Date) + StatusText(cell) + (details != null ? "\n" + details : "");
    }

    /// <summary>Состояние окна одной строкой — подсказка ячейки и подпись панели.</summary>
    private string StatusText(PlacementCell cell) =>
        (IsRange
            ? cell.Has(PlacementFlags.Mine) ? " · " + Tr.T("выпуски акции у всех отмеченных кампаний")
                : cell.Has(PlacementFlags.Partial) ? " · " + Tr.T("выпуски акции не у всех отмеченных кампаний")
                : cell.Has(PlacementFlags.FirmHere) ? " · " + Tr.T("выпуски фирмы в других акциях на всех станциях")
                : cell.Has(PlacementFlags.FirmSome) ? " · " + Tr.T("выпуски фирмы в других акциях на части станций") : ""
            : cell.Has(PlacementFlags.Mine) ? " · " + Tr.T("выпуски этой кампании")
                : cell.Has(PlacementFlags.FirmHere) ? " · " + Tr.T("выпуски фирмы в других кампаниях") : "")
        + (cell.Has(PlacementFlags.Disabled) ? " · " + Tr.T("заблокированное окно") : "")
        + (cell.Has(PlacementFlags.Marked) ? " · " + Tr.T("отмеченное окно") : "")
        + (cell.Has(PlacementFlags.Prime) ? " · " + Tr.T("прайм-тайм") : "");

    private async Task ClickCell(PlacementGrid.CellEvent e)
    {
        // Веер: «Режим добавления» ставит ролик в окно целиком (на всех отмеченных станциях), иначе окно
        // выделяется — как в сетке одной кампании. Панели выпусков окна у веера пока нет (этап 4б).
        if (_range != null)
        {
            if (_rangeTransfer != null)
            {
                if (e.Mouse.Detail <= 1 && TransferCellClass(e.Cell) == TargetClass)
                    await Exclusive(() => TransferRangeTo(e.Cell));
                return;
            }

            if (_brushOn)
            {
                if (e.Mouse.Detail <= 1)
                    await PlaceSlot(e.Cell);
                return;
            }

            _selection.Click(_week!, e.Cell, e.Mouse.ShiftKey, e.Mouse.CtrlKey || e.Mouse.MetaKey);
            await Run(() => ShowSlotCore(e.Cell));
            await FocusGrid();
            return;
        }

        if (_transfer != null)
        {
            if (e.Mouse.Detail <= 1 && TransferCellClass(e.Cell) == TargetClass)
                await Exclusive(() => TransferTo(e.Cell));
            return;
        }

        if (_brushOn)
        {
            // Второй щелчок двойного (detail > 1) второй выпуск не ставит: Blazor выполняет события
            // по очереди, и без этой проверки он пришёл бы уже после первой постановки. Осознанный
            // повторный щелчок по тому же окну — отдельный щелчок, он ставит ещё один выпуск.
            if (e.Mouse.Detail <= 1)
                await PlaceOne(e.Cell);
            return;
        }

        _selection.Click(_week!, e.Cell, e.Mouse.ShiftKey, e.Mouse.CtrlKey || e.Mouse.MetaKey);
        await SelectCell(e.Cell);
        await FocusGrid();
    }

    private async Task FocusGrid()
    {
        try { await _gridBox.FocusAsync(preventScroll: true); }
        catch (Exception) { /* сетка уже убрана со страницы — фокус не нужен */ }
    }

    private void GridKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;
        if (_transfer != null)
            _transfer = null;
        else if (_rangeTransfer != null)
            _rangeTransfer = null;
        else
            _selection.Clear();
    }

    private void ClearSelection() => _selection.Clear();

    // ---------- Режим добавления ----------

    private void ToggleBrush()
    {
        _brushOn = !_brushOn;
        if (_brushOn)
            _selection.Clear();
    }

    /// <summary>
    /// Клик «Режима добавления»: ролик кисти с позицией «Позиционирования» в окно. Ячейка и
    /// счётчик дня обновляются на месте, панель окна не перечитывается (если это не её окно).
    /// Отказ процедуры — сообщением над сеткой.
    /// </summary>
    private async Task PlaceOne(PlacementCell cell)
    {
        if (!CanBrush || _week == null)
            return;

        bool placed = false;
        int rollerId = _brushRollerId!.Value;
        int position = _view.Position;
        PlacementWeek week = _week;
        await Run(() =>
        {
            // Запись и «поставлено» — сразу после коммита, до перечитывания ячейки: сбой чтения не должен оставить выпуск без записи.
            WindowsSource.PlaceOne(_open!, week, cell, rollerId, position, _view, issue =>
            {
                placed = true;
                Undo.Remember(Action.ActionId, _open!.CampaignId, new[] { issue });
            });
            if (_selected?.Key == cell.Key)
                _panel = WindowsSource.LoadWindowIssues(_open!, cell, _view.ShowUnconfirmed);
        });
        if (placed)
            await Changed.InvokeAsync();
    }

    /// <summary>
    /// Клик «Режима добавления» в веере: ролик кисти с позицией «Позиционирования» на всех отмеченных
    /// станциях слота, одной транзакцией. Отказ любой станции откатывает слот целиком — сообщением над
    /// сеткой. Неделя после записи перечитывается (слот меняет цвет, счётчик дня — число выпусков).
    /// </summary>
    private async Task PlaceSlot(PlacementCell cell)
    {
        if (!CanBrush || _range == null || _week == null)
            return;

        bool placed = false;
        int rollerId = _brushRollerId!.Value;
        int position = _view.Position;
        await Run(() =>
        {
            IReadOnlyList<WindowsSource.PlacedIssue> created = RangeSource.PlaceSlot(_range, cell, rollerId, position, _view);
            placed = true;
            Undo.Remember(Action.ActionId, PlacementUndo.RangeCampaign, created); // до перечитывания недели: сбой чтения не должен оставить выпуски без записи
            ReloadWeekCore();
        });
        if (placed)
            await Changed.InvokeAsync();
    }

    // ---------- Выпуски окна ----------

    private Task SelectCell(PlacementCell cell)
    {
        _selected = cell;
        _checkedIssues = 0;
        return Run(() => _panel = WindowsSource.LoadWindowIssues(_open!, cell, _view.ShowUnconfirmed));
    }

    private void ClosePanel()
    {
        _selected = null;
        _panel = null;
        _transfer = null;
    }

    /// <summary>Действие над выпуском в панели (позиция, замена, удаление) — перечитать окно, неделю и шапку.</summary>
    private async Task AfterIssueAction()
    {
        await Run(() =>
        {
            ReloadWeekCore();
