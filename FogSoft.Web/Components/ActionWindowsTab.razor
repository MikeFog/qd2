    /// <summary>
    /// «Удалить дубли» (десктоп — кнопка тулбара веера) в выделенных окнах: у каждой кампании остаётся по одному выпуску каждого
    /// ролика. Окно, где у дублей одного ролика разные позиции, пропускается целиком (неизвестно, какой оставить) и попадает в
    /// таблицу отказов.
    /// </summary>
    private async Task DeleteDuplicatesInSlots()
    {
        if (!CanFixRollers || _range is not { } range || _week == null || _selection.Count == 0)
            return;

        IReadOnlyList<PlacementCell> cells = _selection.Selected(_week);
        RangeSource.DuplicatePlan? plan = null;
        await Run(() => plan = RangeSource.PlanDuplicates(range, RangeSource.ReadSlots(range, cells), _numbers));
        if (plan == null)
            return;
        if (plan.Count == 0)
        {
            await ShowInfo(Tr.T("Удалить дубли"), plan.SkippedWindows > 0
                ? Tr.T("Удалять нечего: все окна с дублями пропущены.")
                : Tr.T("В выделенных окнах дублей нет."));
            await AfterBatch(plan.Problems, _ => Tr.T("Удалить дубли"), "Рекламное окно"); // i18n-ok: заголовок колонки переводит ObjectList при выводе
            return;
        }

        string question = Tr.Format("Удалить дубли в выделенных окнах, оставив у каждой кампании по одному выпуску каждого ролика? ({0} шт.)", plan.Count);
        string? skipped = plan.SkippedWindows > 0 ? Tr.Format("Окон будет пропущено из-за разного позиционирования дублей: {0}.", plan.SkippedWindows) : null;
        if (await Dialogs.ShowAsync(Tr.T("Удалить дубли"), b =>
            {
                b.OpenElement(0, "p");
                b.AddContent(1, question);
                b.CloseElement();
                if (skipped != null)
                {
                    b.OpenElement(2, "p");
                    b.AddAttribute(3, "class", "text-warning-emphasis");
                    b.AddContent(4, skipped);
                    b.CloseElement();
                }
            }, okText: Tr.T("Удалить")) != DialogOutcome.Ok)
            return;

        WindowsSource.BatchResult? result = null;
        RangeSource.DuplicatePlan toRemove = plan;
        await Run(() =>
        {
            result = RangeSource.RemoveDuplicates(range, toRemove, _numbers);
            ReloadWeekCore();
        });
        await AfterBatch(result, done => Tr.Format("Удалено лишних выпусков: {0}, не удалено: {1}", done, result!.Failed), "Рекламное окно"); // i18n-ok: заголовок колонки переводит ObjectList при выводе
    }

