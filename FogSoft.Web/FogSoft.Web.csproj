<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FogSoft.Core\FogSoft.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- На проде веб работает службой Windows: Deploy/web-deploy.md -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- Продолжительность файла ролика (RollerFiles.DurationSeconds) — та же версия, что у десктопа -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- user-secrets разработчика: автологин (WebLogin.TryDevAutoLogin) -->
    <UserSecretsId>fogsoft-web-qd2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Читается ConfigurationUtil из ядра как FogSoft.Web.dll.config -->
    <None Update="App.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- На .NET Core log4net грузится из отдельного файла, см. Program.cs -->
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
